# ---------------------------------------------------------------------------
# Build output & toolchain caches
# ---------------------------------------------------------------------------
.pio
*.elf
*.map
littlefs.bin

# Compiled firmware images. Ship these through GitHub Releases, never in git:
# every binary committed stays in the history forever, even after deletion.
*.factory.bin
restore_point_*.bin

# ---------------------------------------------------------------------------
# Editor / IDE local state
# ---------------------------------------------------------------------------
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.claude/settings.local.json
.DS_Store

# ---------------------------------------------------------------------------
# Vendor datasheets & schematics (kept locally, not redistributed)
# ---------------------------------------------------------------------------
# These are third-party documents under Espressif / Waveshare / Everest
# copyright. Redistributing them from a public repo is not ours to do, and a
# stale local copy silently diverges from the vendor's current revision.
# docs/HARDWARE.md links to the official, always-current sources instead.
*.pdf

# ---------------------------------------------------------------------------
# Unfinished "partner logo per brand" feature
# ---------------------------------------------------------------------------
# 6 brands got a generated RGB565 header (~1.08 MB each) and a web PNG, but
# nothing ever referenced them: 0 #include, 0 use of the gLogo_* symbols.
# Kept out of git rather than deleted — regenerate from data/www/img/*_logo.png
# if the feature is revived. See the tracking issue.
TigerTagSplashESP32/logo_esun.h
TigerTagSplashESP32/logo_jamghe.h
TigerTagSplashESP32/logo_landu.h
TigerTagSplashESP32/logo_r3d.h
TigerTagSplashESP32/logo_rosa3d.h
TigerTagSplashESP32/logo_sunlu.h

# Unreferenced splash/logo headers superseded by logo_tigertag_splash.h
# (0 uses of the partnersSplash / tigerLogo symbols).
partners_splash.h
TigerTagSplashESP32/partners_splash.h
partners_splash_premium_480x320.png
tiger_tag_logo.h
include/tiger_tag_logo.h

# ---------------------------------------------------------------------------
# Bring-up scratch work & abandoned experiments
# ---------------------------------------------------------------------------
# test_hsu_minimal/: throwaway project used to isolate the HSU wiring bug.
# usbhost_lib/: vendored Adafruit_PN532 fork for the USB-host path, which is a
#   confirmed hardware dead end on this board (see docs/USB_HOST_POSTMORTEM.md).
# debug_lib/: vendored fork whose only useful delta was `#define PN532DEBUG` —
#   now a plain -DPN532DEBUG build flag, no fork to keep in sync with upstream.
test_hsu_minimal/
usbhost_lib/
debug_lib/

# Dead AsyncTCP tuning flags: Arduino IDE reads build_opt.h from the sketch
# folder (which was empty), PlatformIO ignores it entirely — so these were
# never applied. Removed rather than silently activated; see the tracking issue.
build_opt.h
TigerTagSplashESP32/build_opt.h

# Sibling test-project copy used only for a one-off visual diff (2026-07-29)
# — not part of this project's own history.
TigerScale_V3_Test2_2026-07-29/
TigerScale_V3_Test2_2026-07-29.zip

# Superseded by scripts/flash.sh (portable, PlatformIO-based) and
# scripts/watch_logs.py (host passed as an argument).
upload_all.ps1
/watch_logs.py

# Stale duplicate of CLAUDE.md (said "V4", 9200 lines, 6 languages, and
# carried another machine C:\ paths). Superseded by CLAUDE.md + AGENTS.md.
SKILL.md

# Duplicate of the root partitions.csv, which is the one PlatformIO reads.
# It only mattered for Arduino IDE builds, which this project does not support.
TigerTagSplashESP32/partitions.csv
