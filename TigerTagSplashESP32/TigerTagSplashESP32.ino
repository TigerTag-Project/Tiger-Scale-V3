    lv_obj_set_pos(lvFilamentValue, RCOL_X + RVAL_X, 40);

    lv_obj_t *hdiv = lv_obj_create(mainCard);
    lv_obj_remove_style_all(hdiv);
    lv_obj_set_size(hdiv, 184, 1);
    lv_obj_set_style_bg_color(hdiv, LVCOL_BORDER, 0);
    lv_obj_set_style_bg_opa(hdiv, LV_OPA_COVER, 0);
    lv_obj_set_pos(hdiv, RCOL_X, 68);
    lv_obj_clear_flag(hdiv, LV_OBJ_FLAG_SCROLLABLE);

    // Rack name/position: real data from Firebase (gLastRackName/gLastRackPosition),
    // shown as icon + value -- no static "Room"/"Location" caption invented.
    lv_obj_t *homeIcon = lv_label_create(mainCard);
    lv_label_set_text(homeIcon, LV_SYMBOL_HOME);
    lv_obj_set_style_text_color(homeIcon, LVCOL_MUTED, 0);
    lv_obj_set_pos(homeIcon, RCOL_X, 80);
    lvRackNameLabel = lv_label_create(mainCard);
    lv_obj_set_style_text_color(lvRackNameLabel, LVCOL_TEXT, 0);
    lv_label_set_long_mode(lvRackNameLabel, LV_LABEL_LONG_CLIP);
    lv_obj_set_width(lvRackNameLabel, 150);
    lv_obj_set_pos(lvRackNameLabel, RCOL_X + 24, 80);

    lv_obj_t *posIcon = lv_label_create(mainCard);
    lv_label_set_text(posIcon, LV_SYMBOL_GPS);
    lv_obj_set_style_text_color(posIcon, LVCOL_MUTED, 0);
    lv_obj_set_pos(posIcon, RCOL_X, 108);
    lvPositionLabel = lv_label_create(mainCard);
    lv_obj_set_style_text_color(lvPositionLabel, LVCOL_TEXT, 0);
    lv_obj_set_pos(lvPositionLabel, RCOL_X + 24, 108);

    // ---- Bottom: 2 buttons spanning the full card width -- Tare (2/3) + Settings (1/3).
    // Reader cards removed per user request (RFID reader logic/data untouched,
    // just no longer shown on this screen).
    const int BTN_Y = 214, BTN_H = 92, BTN_X0 = 20, BTN_GAP = 12;
    const int TARE_W = 285, SETTINGS_W = 143; // 440-wide row (matches main card), ~2/3 + ~1/3

    lv_obj_t *tareBtn = lv_btn_create(lvScreen);
    lv_obj_set_size(tareBtn, TARE_W, BTN_H);
    lv_obj_set_pos(tareBtn, BTN_X0, BTN_Y);
