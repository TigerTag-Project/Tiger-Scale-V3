    lv_obj_align(hintLbl, LV_ALIGN_TOP_MID, 0, 94);

    lv_obj_t *pbBg = lv_obj_create(scr);
    lv_obj_remove_style_all(pbBg);
    lv_obj_set_size(pbBg, 440, 22);
    lv_obj_align(pbBg, LV_ALIGN_TOP_MID, 0, 120);
    lv_obj_set_style_bg_color(pbBg, LVCOL_CARD, 0);
    lv_obj_set_style_bg_opa(pbBg, LV_OPA_COVER, 0);
    lv_obj_set_style_border_color(pbBg, LVCOL_BORDER, 0);
    lv_obj_set_style_border_width(pbBg, 1, 0);
    lv_obj_set_style_radius(pbBg, 6, 0);
    lv_obj_clear_flag(pbBg, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_add_flag(pbBg, LV_OBJ_FLAG_HIDDEN);
    lv_obj_t *pbFill = lv_obj_create(pbBg);
    lv_obj_remove_style_all(pbFill);
    lv_obj_set_size(pbFill, 0, 20);
    lv_obj_set_pos(pbFill, 1, 1);
    lv_obj_set_style_bg_color(pbFill, LVCOL_GREEN, 0);
    lv_obj_set_style_bg_opa(pbFill, LV_OPA_COVER, 0);
    lv_obj_set_style_radius(pbFill, 5, 0);
    lv_obj_clear_flag(pbFill, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_clear_flag(pbFill, LV_OBJ_FLAG_CLICKABLE);

    lv_obj_t *pbMsgLbl = lv_label_create(scr);
    lv_obj_set_style_text_color(pbMsgLbl, LVCOL_MUTED, 0);
    lv_obj_set_style_text_font(pbMsgLbl, &lv_font_montserrat_14, 0);
    lv_obj_align(pbMsgLbl, LV_ALIGN_TOP_MID, 0, 148);
    lv_obj_add_flag(pbMsgLbl, LV_OBJ_FLAG_HIDDEN);

    lv_obj_t *installBtn = lv_btn_create(scr);
    lv_obj_set_size(installBtn, 300, 46);
    lv_obj_align(installBtn, LV_ALIGN_TOP_MID, 0, 150);
    lv_obj_set_style_bg_color(installBtn, LVCOL_CARD, 0);
    lv_obj_set_style_border_color(installBtn, LVCOL_BORDER, 0);
    lv_obj_set_style_border_width(installBtn, 1, 0);
    lv_obj_set_style_radius(installBtn, 10, 0);
    lv_obj_set_style_shadow_width(installBtn, 0, 0);
    lv_obj_set_user_data(installBtn, (void *)(intptr_t)OA_INSTALL);
    lv_obj_add_event_cb(installBtn, actionCb, LV_EVENT_CLICKED, nullptr);
    lv_obj_t *installLbl = lv_label_create(installBtn);
    lv_label_set_text(installLbl, t(I18N_INSTALL));
    lv_obj_set_style_text_color(installLbl, LVCOL_GREEN, 0);
    lv_obj_center(installLbl);
    lv_obj_add_flag(installBtn, LV_OBJ_FLAG_HIDDEN);

    lv_obj_t *backBtn = lv_btn_create(scr);
    lv_obj_set_size(backBtn, 34, 36);
    lv_obj_set_pos(backBtn, 0, 0);
    lv_obj_set_style_bg_opa(backBtn, LV_OPA_TRANSP, 0);
    lv_obj_set_style_border_width(backBtn, 0, 0);
    lv_obj_set_style_shadow_width(backBtn, 0, 0);
    lv_obj_set_user_data(backBtn, (void *)(intptr_t)OA_BACK);
    lv_obj_add_event_cb(backBtn, actionCb, LV_EVENT_CLICKED, nullptr);
    lv_obj_t *backIcon = lv_label_create(backBtn);
    lv_label_set_text(backIcon, LV_SYMBOL_LEFT);
    lv_obj_set_style_text_color(backIcon, LVCOL_MUTED, 0);
    lv_obj_center(backIcon);

    auto setStatus = [&](const char *msg, lv_color_t col) {
        lv_label_set_text(statusLbl, msg);
        lv_obj_set_style_text_color(statusLbl, col, 0);
    };
    // Re-anchor version+status to the screen's vertical center for the short
    // terminal messages (no wifi / fetch error / already up to date) that
    // have nothing else below them -- the "update available" flow keeps the
    // original top position since hint/progress bar/install button render
    // below it.
    auto centerMsg = [&]() {
        lv_obj_align(verLbl, LV_ALIGN_CENTER, 0, -20);
        lv_obj_align(statusLbl, LV_ALIGN_CENTER, 0, 10);
    };
    auto pump = [&](uint32_t ms) {
        uint32_t t0 = millis(); while (millis() - t0 < ms) { lv_timer_handler(); delay(20); }
    };
    auto waitAction = [&]() -> OtaAction {
        sOtaAction = OA_NONE;
        while (sOtaAction == OA_NONE) { lv_timer_handler(); delay(5); }
        return sOtaAction;
    };
    // Only Back is clickable at every call site below (Install stays hidden
    // until the flow explicitly reveals it), so a single wait suffices.
    auto exitScreen = [&]() {
        waitAction();
        lv_scr_load(lvScreen);
        lv_obj_del(scr);
        { int16_t dx, dy; uint32_t t0 = millis(); while (tsRead(dx, dy) && millis()-t0 < 800) delay(20); }
    };

    lv_scr_load(scr);
    setStatus(t(I18N_OTA_CHECKING), LVCOL_MUTED);
    pump(1);

    if (!WiFi.isConnected()) {
        setStatus(t(I18N_OTA_NO_WIFI), LVCOL_RED);
        centerMsg();
        exitScreen();
        return;
    }

    bool found = otaFetchLatest();

    if (!found) {
        setStatus(t(I18N_OTA_ERROR), LVCOL_RED);
        centerMsg();
        exitScreen();
        return;
    }

    bool isNewer = gOtaLatestVer.length() > 0
                   && gOtaLatestVer != String(TIGERSCALE_FW_VERSION);

    if (!isNewer) {
        setStatus(t(I18N_OTA_UP_TO_DATE), LVCOL_GREEN);
        centerMsg();
        exitScreen();
        return;
    }

    // Update available
    char avBuf[52];
    snprintf(avBuf, sizeof(avBuf), "%s  v%s", t(I18N_OTA_AVAILABLE), gOtaLatestVer.c_str());
    setStatus(avBuf, lv_color_hex(0xFFE08A));

    if (gOtaFirmwareUrl.length() == 0) {
        // version.json has no firmware_url — cannot install from device
        lv_label_set_text(hintLbl, "Use Studio Manager to install");
        exitScreen();
        return;
    }

    // No spare app slot means the firmware can never be written. Say so instead of
    // offering an Install that would flash the new web UI, fail on the firmware and
    // leave the two out of step. See otaFirmwareSlotAvailable().
    if (!otaFirmwareSlotAvailable()) {
        Serial.println("[OTA] no ota_0/ota_1 app slot — firmware update over the air "
                       "is impossible with this partition table");
        lv_label_set_text(hintLbl, "Update over USB");
        exitScreen();
        return;
    }

    lv_obj_clear_flag(installBtn, LV_OBJ_FLAG_HIDDEN);

    // Wait for Install or Back
    if (waitAction() == OA_BACK) {
        lv_scr_load(lvScreen);
        lv_obj_del(scr);
        { int16_t dx, dy; uint32_t t0 = millis(); while (tsRead(dx, dy) && millis()-t0 < 800) delay(20); }
        return;
    }

    // --- Install ---
    lv_obj_add_flag(installBtn, LV_OBJ_FLAG_HIDDEN);
    lv_obj_add_flag(backBtn, LV_OBJ_FLAG_HIDDEN);
    lv_label_set_text(hintLbl, "");
    setStatus(t(I18N_OTA_INSTALLING), LVCOL_MUTED);
    lv_obj_clear_flag(pbBg, LV_OBJ_FLAG_HIDDEN);
    lv_obj_clear_flag(pbMsgLbl, LV_OBJ_FLAG_HIDDEN);
    pump(1);

    // The progress bar spans both images when the manifest offers a filesystem:
    // 0-50% for the web UI, 50-100% for the firmware. With firmware only, it
    // spans the whole bar as before.
    const bool haveFs = gOtaLittlefsUrl.length() > 0;
    auto progressTo = [&](int base, int span) {
        return [&, base, span](int pct, const String& msg) {
            int overall = base + (span * pct / 100);
            int filled = 438 * overall / 100;
            lv_obj_set_width(pbFill, filled > 0 ? filled : 0);
            lv_label_set_text(pbMsgLbl, msg.c_str());
            lv_timer_handler();
        };
    };

    // Filesystem FIRST, firmware second — the same order the /api/ota/update
    // endpoint and the Firestore command handler use. Writing the app last means
    // its reboot happens once everything else is already in place; doing it the
    // other way round would reboot into new firmware still serving the old web UI.
    bool ok = true;
    if (haveFs) {
        ok = otaApply(gOtaLittlefsUrl, gOtaLittlefsSha, U_SPIFFS, progressTo(0, 50));
        if (!ok) Serial.println("[OTA] filesystem image failed — aborting before the firmware");
    }
    if (ok) {
        ok = otaApply(gOtaFirmwareUrl, gOtaLatestSha, U_FLASH,
                      progressTo(haveFs ? 50 : 0, haveFs ? 50 : 100));
    }

    lv_obj_clear_flag(backBtn, LV_OBJ_FLAG_HIDDEN);

    if (!ok) {
        setStatus(t(I18N_OTA_ERROR), LVCOL_RED);
        exitScreen();
        return;
    }

    setStatus(t(I18N_OTA_SUCCESS), LVCOL_GREEN);
    pump(2000);
    ESP.restart();
}

// LVGL settings menu (2026-07-28) -- same actions/functions as the old
// raw-gfx grid, same blocking call convention (callers just call
// runSettingsMenu() and it returns once the user backs out), rebuilt as an
// LVGL screen. Sub-screens (calibration wizard, hardware test, wifi setup,
// etc.) are untouched raw-gfx and still called exactly as before.
static void runSettingsMenu() {
    enum SettingsAction { SA_NONE, SA_WIFI, SA_FIREBASE, SA_VOLUME, SA_CALIBRATE, SA_LANGUAGE, SA_HARDWARE, SA_UPDATE, SA_BACK };
    static SettingsAction sAction;
    lv_obj_t *prevScr = nullptr;

    auto cardClickCb = [](lv_event_t *e) {
        lv_obj_t *card = (lv_obj_t *)lv_event_get_target(e);
        *(SettingsAction *)lv_event_get_user_data(e) = (SettingsAction)(intptr_t)lv_obj_get_user_data(card);
    };

    for (;;) {
        sAction = SA_NONE;

        lv_obj_t *scr = lv_obj_create(nullptr);
        lv_obj_set_style_bg_color(scr, LVCOL_BG, 0);
        lv_obj_set_style_border_width(scr, 0, 0);
        lv_obj_clear_flag(scr, LV_OBJ_FLAG_SCROLLABLE);

        lv_obj_t *title = lv_label_create(scr);
        lv_label_set_text(title, t(I18N_SETTINGS));
        lv_obj_set_style_text_color(title, LVCOL_TEXT, 0);
        lv_obj_set_style_text_font(title, &lv_font_montserrat_20, 0);
        lv_obj_align(title, LV_ALIGN_TOP_MID, 0, 8);

        lv_obj_t *div = lv_obj_create(scr);
        lv_obj_remove_style_all(div);
        lv_obj_set_size(div, 480, 1);
        lv_obj_set_style_bg_color(div, LVCOL_BORDER, 0);
        lv_obj_set_style_bg_opa(div, LV_OPA_COVER, 0);
        lv_obj_set_pos(div, 0, 36);
        lv_obj_clear_flag(div, LV_OBJ_FLAG_SCROLLABLE);

        const int CW = 152, CH = 78, GAP = 6, X0 = 6;
        const int X1 = X0 + CW + GAP, X2 = X1 + CW + GAP;
        const int Y0 = 44, Y1 = Y0 + CH + 8, Y2 = Y1 + CH + 10;

        enum CardIcon { CI_GLYPH, CI_CLOUD, CI_TARGET, CI_GLOBE, CI_CHIP };

        // Small hand-drawn-primitive icon helpers — a plain lv_obj with a
        // border and no fill draws an outline shape; bg-filled ones with
        // border_width 0 draw solid marks. All positioned within a 26x26
        // "iconArea" group so makeCard() can align that one group.
        auto ring = [&](lv_obj_t *parent, int x, int y, int d, lv_color_t col) {
            lv_obj_t *o = lv_obj_create(parent);
            lv_obj_remove_style_all(o);
            lv_obj_set_size(o, d, d);
            lv_obj_set_pos(o, x, y);
            lv_obj_set_style_radius(o, LV_RADIUS_CIRCLE, 0);
            lv_obj_set_style_border_width(o, 2, 0);
            lv_obj_set_style_border_color(o, col, 0);
            lv_obj_set_style_bg_opa(o, LV_OPA_TRANSP, 0);
            lv_obj_clear_flag(o, LV_OBJ_FLAG_SCROLLABLE);
            lv_obj_clear_flag(o, LV_OBJ_FLAG_CLICKABLE);
        };
        auto pillOutline = [&](lv_obj_t *parent, int x, int y, int w, int h, int r, lv_color_t col) {
            lv_obj_t *o = lv_obj_create(parent);
            lv_obj_remove_style_all(o);
            lv_obj_set_size(o, w, h);
            lv_obj_set_pos(o, x, y);
            lv_obj_set_style_radius(o, r, 0);
            lv_obj_set_style_border_width(o, 2, 0);
            lv_obj_set_style_border_color(o, col, 0);
            lv_obj_set_style_bg_opa(o, LV_OPA_TRANSP, 0);
            lv_obj_clear_flag(o, LV_OBJ_FLAG_SCROLLABLE);
            lv_obj_clear_flag(o, LV_OBJ_FLAG_CLICKABLE);
        };
        auto bar = [&](lv_obj_t *parent, int x, int y, int w, int h, int r, lv_color_t col) {
            lv_obj_t *o = lv_obj_create(parent);
            lv_obj_remove_style_all(o);
            lv_obj_set_size(o, w, h);
            lv_obj_set_pos(o, x, y);
            lv_obj_set_style_radius(o, r, 0);
            lv_obj_set_style_bg_color(o, col, 0);
            lv_obj_set_style_bg_opa(o, LV_OPA_COVER, 0);
            lv_obj_clear_flag(o, LV_OBJ_FLAG_SCROLLABLE);
            lv_obj_clear_flag(o, LV_OBJ_FLAG_CLICKABLE);
        };

        auto makeCard = [&](int x, int y, CardIcon iconKind, const char *iconSym, lv_color_t iconCol,
                             const String &valStr, SettingsAction act) {
            lv_obj_t *card = lv_btn_create(scr);
            lv_obj_set_size(card, CW, CH);
            lv_obj_set_pos(card, x, y);
            lv_obj_set_style_bg_color(card, LVCOL_CARD, 0);
            lv_obj_set_style_border_color(card, LVCOL_BORDER, 0);
            lv_obj_set_style_border_width(card, 1, 0);
            lv_obj_set_style_radius(card, 12, 0);
            lv_obj_set_style_shadow_width(card, 0, 0);
            lv_obj_set_user_data(card, (void *)(intptr_t)act);
            lv_obj_add_event_cb(card, cardClickCb, LV_EVENT_CLICKED, &sAction);

            if (iconKind == CI_GLYPH) {
                lv_obj_t *icon = lv_label_create(card);
                lv_label_set_text(icon, iconSym);
                lv_obj_set_style_text_color(icon, iconCol, 0);
                lv_obj_set_style_text_font(icon, &lv_font_montserrat_28, 0);
                lv_obj_align(icon, LV_ALIGN_CENTER, 0, -12);
            } else {
                // Custom hand-drawn icons live in a 26x26 group, centered the
                // same way the glyph label is, so every card lines up.
                lv_obj_t *iconArea = lv_obj_create(card);
                lv_obj_remove_style_all(iconArea);
                lv_obj_set_size(iconArea, 26, 26);
                lv_obj_align(iconArea, LV_ALIGN_CENTER, 0, -12);
                lv_obj_clear_flag(iconArea, LV_OBJ_FLAG_SCROLLABLE);
                lv_obj_clear_flag(iconArea, LV_OBJ_FLAG_CLICKABLE);

                if (iconKind == CI_CLOUD) {
                    // Cloud icon: two overlapping domes + flat base, scaled
                    // down to fit the 26x26 icon area (same shape as the
                    // hand-drawn cloud icon used in the main screen's status
                    // row, just smaller).
                    lv_obj_t *dome1 = lv_obj_create(iconArea);
                    lv_obj_set_size(dome1, 16, 16);
                    lv_obj_set_style_radius(dome1, LV_RADIUS_CIRCLE, 0);
                    lv_obj_set_style_border_width(dome1, 0, 0);
                    lv_obj_set_style_bg_color(dome1, iconCol, 0);
                    lv_obj_set_pos(dome1, 0, 2);
                    lv_obj_clear_flag(dome1, LV_OBJ_FLAG_SCROLLABLE);
                    lv_obj_clear_flag(dome1, LV_OBJ_FLAG_CLICKABLE);

                    lv_obj_t *dome2 = lv_obj_create(iconArea);
                    lv_obj_set_size(dome2, 11, 11);
                    lv_obj_set_style_radius(dome2, LV_RADIUS_CIRCLE, 0);
                    lv_obj_set_style_border_width(dome2, 0, 0);
                    lv_obj_set_style_bg_color(dome2, iconCol, 0);
                    lv_obj_set_pos(dome2, 14, 6);
                    lv_obj_clear_flag(dome2, LV_OBJ_FLAG_SCROLLABLE);
                    lv_obj_clear_flag(dome2, LV_OBJ_FLAG_CLICKABLE);

                    bar(iconArea, 0, 10, 26, 7, 3, iconCol);
                } else if (iconKind == CI_TARGET) {
                    // Calibration: target/adjustment icon (ring + inner ring +
                    // crosshair + 4 tick marks), ported from the existing but
                    // previously-unused drawCalibrateIcon() raw-gfx design.
                    ring(iconArea, 3, 3, 20, iconCol);
                    ring(iconArea, 9, 9, 8, iconCol);
                    bar(iconArea, 12, 9, 2, 8, 1, iconCol);
                    bar(iconArea, 9, 12, 8, 2, 1, iconCol);
                    bar(iconArea, 10, 0, 5, 3, 1, iconCol);
                    bar(iconArea, 10, 23, 5, 3, 1, iconCol);
                    bar(iconArea, 0, 10, 3, 5, 1, iconCol);
                    bar(iconArea, 22, 10, 3, 5, 1, iconCol);
                } else if (iconKind == CI_GLOBE) {
                    // Language: simplified globe, ported from the existing
                    // but previously-unused drawLanguageIcon() raw-gfx design
                    // (dropped the two speech-bubble callouts — too much
                    // detail at this icon size, the globe alone reads fine).
                    ring(iconArea, 2, 2, 22, iconCol);
                    bar(iconArea, 2, 12, 22, 2, 0, iconCol);
                    pillOutline(iconArea, 8, 2, 10, 22, 5, iconCol);
                } else if (iconKind == CI_CHIP) {
                    // Hardware/RFID: IC chip body + center pad + pins, ported
                    // from the existing but previously-unused drawChipIcon()
                    // raw-gfx design (PN532-style module silhouette).
                    pillOutline(iconArea, 7, 6, 12, 14, 2, iconCol);
                    lv_obj_t *dot = lv_obj_create(iconArea);
                    lv_obj_remove_style_all(dot);
                    lv_obj_set_size(dot, 4, 4);
                    lv_obj_set_pos(dot, 11, 11);
                    lv_obj_set_style_radius(dot, LV_RADIUS_CIRCLE, 0);
                    lv_obj_set_style_bg_color(dot, iconCol, 0);
                    lv_obj_set_style_bg_opa(dot, LV_OPA_COVER, 0);
                    lv_obj_clear_flag(dot, LV_OBJ_FLAG_SCROLLABLE);
                    lv_obj_clear_flag(dot, LV_OBJ_FLAG_CLICKABLE);
                    bar(iconArea, 1, 8,  5, 2, 0, iconCol);
                    bar(iconArea, 1, 12, 5, 2, 0, iconCol);
                    bar(iconArea, 1, 16, 5, 2, 0, iconCol);
                    bar(iconArea, 20, 8,  5, 2, 0, iconCol);
                    bar(iconArea, 20, 12, 5, 2, 0, iconCol);
                    bar(iconArea, 20, 16, 5, 2, 0, iconCol);
                }
            }

            lv_obj_t *val = lv_label_create(card);
            lv_label_set_text(val, valStr.c_str());
            lv_obj_set_style_text_color(val, LVCOL_MUTED, 0);
            lv_obj_align(val, LV_ALIGN_BOTTOM_MID, 0, -8);
        };

        // Row 1: WiFi | Firebase | Volume
        String wifiVal = wifiConnected ? WiFi.localIP().toString() : String(t(I18N_NO_WIFI));
        makeCard(X0, Y0, CI_GLYPH, LV_SYMBOL_WIFI, wifiConnected ? LVCOL_GREEN : LVCOL_RED, wifiVal, SA_WIFI);

        String fbVal = firebaseAuth ? "OK" : t(I18N_NO_ACCOUNT);
        makeCard(X1, Y0, CI_CLOUD, nullptr, firebaseAuth ? LVCOL_GREEN : LVCOL_RED, fbVal, SA_FIREBASE);

        String volVal = gMute ? String(t(I18N_MUTE)) : (String((int)gVolume) + "%");
        makeCard(X2, Y0, CI_GLYPH, gMute ? LV_SYMBOL_MUTE : LV_SYMBOL_VOLUME_MAX, gMute ? LVCOL_RED : LVCOL_TEXT, volVal, SA_VOLUME);

        // Row 2: Calibrate | Language | Hardware
        char calBuf[20]; snprintf(calBuf, sizeof(calBuf), "%.2f", calibrationFactor);
        makeCard(X0, Y1, CI_TARGET, nullptr, LVCOL_TEXT, String(calBuf), SA_CALIBRATE);

        const char *langNames[6] = { "English", "Portugues", "Francais", "Espanol", "Deutsch", "Zhongwen" };
        String langVal = langNames[(int)gLanguage < 6 ? (int)gLanguage : 0];
        makeCard(X1, Y1, CI_GLOBE, nullptr, LVCOL_TEXT, langVal, SA_LANGUAGE);

        makeCard(X2, Y1, CI_CHIP, nullptr, LVCOL_TEXT, String("RFID"), SA_HARDWARE);

        // Row 3: Update — same card style as the other 6, under Calibrate
        makeCard(X0, Y2, CI_GLYPH, LV_SYMBOL_REFRESH, LVCOL_TEXT, String(t(I18N_UPDATE)), SA_UPDATE);

        // Back — top-left arrow, matching the keyboard screen's back button
        lv_obj_t *backBtn = lv_btn_create(scr);
        lv_obj_set_size(backBtn, 34, 36);
        lv_obj_set_pos(backBtn, 0, 0);
        lv_obj_set_style_bg_opa(backBtn, LV_OPA_TRANSP, 0);
        lv_obj_set_style_border_width(backBtn, 0, 0);
        lv_obj_set_style_shadow_width(backBtn, 0, 0);
        lv_obj_set_user_data(backBtn, (void *)(intptr_t)SA_BACK);
        lv_obj_add_event_cb(backBtn, cardClickCb, LV_EVENT_CLICKED, &sAction);
        lv_obj_t *backIcon = lv_label_create(backBtn);
        lv_label_set_text(backIcon, LV_SYMBOL_LEFT);
        lv_obj_set_style_text_color(backIcon, LVCOL_MUTED, 0);
        lv_obj_center(backIcon);

        lv_scr_load(scr);
        if (prevScr) { lv_obj_del(prevScr); prevScr = nullptr; }

        while (sAction == SA_NONE) { lv_timer_handler(); delay(5); }

        if (sAction == SA_BACK) { lv_scr_load(lvScreen); lv_obj_del(scr); break; }

        switch (sAction) {
            case SA_WIFI: {
                bool ok = wifiTouchConfigure();
                if (ok) {
                    // Same centered badge/title/subtitle treatment as the
                    // other WiFi/Firebase result screens, instead of the old
                    // raw-gfx green-text-on-black reboot message.
                    lv_obj_t *rebootCol;
                    lv_obj_t *rebootScr = lvglCenteredScreen(&rebootCol);
                    lvglAddStatusBadge(rebootCol, true);
                    lvglAddCenteredLabel(rebootCol, t(I18N_WIFI_CONNECTED), LVCOL_GREEN, &lv_font_montserrat_20);
                    lvglAddCenteredLabel(rebootCol, WiFi.localIP().toString(), LVCOL_MUTED, &lv_font_montserrat_14);
                    lvglAddCenteredLabel(rebootCol, t(I18N_REBOOTING), LVCOL_MUTED, &lv_font_montserrat_14);
                    // Device restarts right after -- no need to clean up the
                    // previous screen object, same as the OTA success screen.
                    lv_scr_load(rebootScr);
                    uint32_t t0 = millis(); while (millis() - t0 < 2000) { lv_timer_handler(); delay(20); }
                    ESP.restart();
                }
                break;
            }
            case SA_FIREBASE:
                if (firebaseAuth) {
                    runFirebaseAccountMenu();
                } else if (!wifiConnected) {
                    // Same centered badge/title/subtitle treatment as the
                    // WiFi/Firebase connecting-result screens.
                    lv_obj_t *noWifiCol;
                    lv_obj_t *noWifiScr = lvglCenteredScreen(&noWifiCol);
                    lvglAddStatusBadge(noWifiCol, false);
                    lvglAddCenteredLabel(noWifiCol, t(I18N_NO_WIFI), LVCOL_RED, &lv_font_montserrat_20);
                    lvglAddCenteredLabel(noWifiCol, t(I18N_CONNECT_WIFI), LVCOL_MUTED, &lv_font_montserrat_14);
                    lv_obj_t *prevSettingsScr = lv_scr_act();
                    lv_scr_load(noWifiScr);
                    uint32_t t0 = millis(); while (millis() - t0 < 1500) { lv_timer_handler(); delay(30); }
                    lv_scr_load(prevSettingsScr);
                    lv_obj_del(noWifiScr);
                } else {
                    bool ok = firebaseTouchLogin(); if (ok) firebaseAuth = true;
                }
                break;
            case SA_VOLUME:     runVolumeSettings();     break;
            case SA_CALIBRATE:  runCalibrationWizard();  break;
            case SA_LANGUAGE:   runLanguageSettings();   break;
            case SA_HARDWARE:   runHardwareTest();       break;
            case SA_UPDATE:     runOtaMenu();            break;
            default: break;
        }

        prevScr = scr;
    }
    { int16_t dx, dy; uint32_t t0=millis(); while(tsRead(dx,dy) && millis()-t0<1000) delay(20); }
}

void setupWiFi() {
    gMdnsName = String("tigerscale-") + macSuffix4();
    Serial.println("[WIFI] setupWiFi start");

    WiFi.setAutoReconnect(false);
    Serial.println("[WIFI] mode STA");
    WiFi.mode(WIFI_STA);
    WiFi.setHostname(gMdnsName.c_str());
    Serial.println("[WIFI] mode STA done");

    // Use OUR credentials from ts-wifi namespace only
    prefs.begin("ts-wifi", true);
    String storedSsid = prefs.getString("ssid", "");
    String storedPass = prefs.getString("pass", "");
    prefs.end();
    Serial.printf("[WIFI] stored ssid='%s'\n", storedSsid.c_str());

    bool connected = false;
    if (storedSsid.length() > 0) {
        if (!gBootComplete) bootProgress(35, "Connecting WiFi...");
        else displayMessage("Connecting WiFi...", storedSsid.c_str());
        WiFi.begin(storedSsid.c_str(), storedPass.c_str());
        uint32_t t0 = millis();
        while (WiFi.status() != WL_CONNECTED && millis() - t0 < 15000) {
            if (!gBootComplete) {
                uint8_t p = 35 + (uint8_t)((millis() - t0) * 15 / 15000);
                bootProgress(p, "Connecting WiFi...");
            }
            delay(300);
        }
        connected = (WiFi.status() == WL_CONNECTED);
        Serial.printf("[WIFI] connect result: %s\n", connected ? "OK" : "FAIL");
    }

    wifiConnected = connected;
    cloudOK = connected;

    if (connected) {
        startMDNS();
        configTime(0, 0, "pool.ntp.org", "time.nist.gov");
        Serial.println("[NTP] configTime set - waiting for sync...");
        if (!gBootComplete) bootProgress(52, "WiFi connected");
        else displayMessage("WiFi Connected!", WiFi.SSID(), WiFi.localIP().toString(), "Cloud: OK");
        delay(800);
    } else {
        Serial.println("[WIFI] offline - use WiFi button on scale screen");
    }
}

