        lv_obj_t *barBg = lv_obj_create(lvBootScreen);
        lv_obj_set_size(barBg, BOOT_BAR_W, 16);
        lv_obj_set_style_bg_color(barBg, LVCOL_CARD, 0);
        lv_obj_set_style_border_width(barBg, 0, 0);
        lv_obj_set_style_radius(barBg, 8, 0);
        lv_obj_set_style_pad_all(barBg, 0, 0);
        lv_obj_align(barBg, LV_ALIGN_TOP_MID, 0, 210);
        lv_obj_clear_flag(barBg, LV_OBJ_FLAG_SCROLLABLE);

        lvBootBarFill = lv_obj_create(barBg);
        lv_obj_remove_style_all(lvBootBarFill);
        lv_obj_set_size(lvBootBarFill, 0, 16);
        lv_obj_set_style_bg_color(lvBootBarFill, LVCOL_ACCENT, 0);
        lv_obj_set_style_bg_opa(lvBootBarFill, LV_OPA_COVER, 0);
        lv_obj_set_style_radius(lvBootBarFill, 8, 0);
        lv_obj_set_pos(lvBootBarFill, 0, 0);
        lv_obj_clear_flag(lvBootBarFill, LV_OBJ_FLAG_SCROLLABLE);

        lvBootStatusLabel = lv_label_create(lvBootScreen);
        lv_obj_set_style_text_color(lvBootStatusLabel, LVCOL_MUTED, 0);
        lv_obj_align(lvBootStatusLabel, LV_ALIGN_TOP_MID, 0, 236);

        lv_scr_load(lvBootScreen);
    }

    if (pct > 100) pct = 100;
    lv_obj_set_width(lvBootBarFill, (int32_t)BOOT_BAR_W * pct / 100);
    lv_label_set_text(lvBootStatusLabel, status);

    lv_timer_handler();
}

void displayMessage(String line1, String line2 = "", String line3 = "", String line4 = "") {
    if (!gDisplayReady) {
        Serial.printf("[LCD] %s | %s | %s | %s\n",
                      line1.c_str(), line2.c_str(), line3.c_str(), line4.c_str());
        return;
    }
    gfx->fillScreen(DARK_BG);
    gfx->setTextColor(0xFFFF);
    gfx->setTextSize(2);
    gfx->setCursor(24, 28);
    gfx->println(line1);
    gfx->setTextSize(1);
    gfx->setCursor(24, 84);
    if (line2.length()) gfx->println(line2);
    if (line3.length()) gfx->println(line3);
    if (line4.length()) gfx->println(line4);
    gfx->flush();
}


// Draw a simplified country flag at (x,y) w×h pixels.
static void drawFlag(Language lang, int16_t x, int16_t y, int16_t w, int16_t h) {
    int16_t cx = x + w / 2, cy = y + h / 2;
    switch (lang) {
        case LANG_EN: { // Union Jack — blue + white X (1px) + red/white cross
            gfx->fillRect(x, y, w, h, 0x001F);
            gfx->drawLine(x, y,     x+w-1, y+h-1, 0xFFFF);
            gfx->drawLine(x, y+h-1, x+w-1, y,     0xFFFF);
            gfx->fillRect(x,    cy-2, w, 5, 0xFFFF);
            gfx->fillRect(cx-2, y,    5, h, 0xFFFF);
            gfx->fillRect(x,    cy-1, w, 3, 0xF800);
            gfx->fillRect(cx-1, y,    3, h, 0xF800);
            break;
        }
        case LANG_PT: { // Portugal — green | red + yellow circle outline at border
            int16_t gw = w * 2 / 5;
            gfx->fillRect(x,    y, gw,   h, 0x0320);
            gfx->fillRect(x+gw, y, w-gw, h, 0xF800);
            gfx->drawCircle(x+gw, cy, h/3,   0xFFE0);
            gfx->drawCircle(x+gw, cy, h/3-1, 0xFFE0);
            break;
        }
        case LANG_FR: // France — vertical blue | white | red
            gfx->fillRect(x,         y, w / 3,            h, 0x001F);
            gfx->fillRect(x + w/3,   y, w / 3,            h, 0xFFFF);
            gfx->fillRect(x + w*2/3, y, w - w * 2 / 3,   h, 0xF800);
            break;
        case LANG_ES: // Spain — horizontal red | yellow | red
            gfx->fillRect(x, y,           w, h / 4,          0xC000);
            gfx->fillRect(x, y + h/4,     w, h / 2,          0xFFE0);
            gfx->fillRect(x, y + h*3/4,   w, h - h * 3 / 4, 0xC000);
            break;
        case LANG_DE: // Germany — horizontal black | red | gold
            gfx->fillRect(x, y,           w, h / 3,          0x0000);
            gfx->fillRect(x, y + h/3,     w, h / 3,          0xC800);
            gfx->fillRect(x, y + h*2/3,   w, h - h * 2 / 3, 0xFE80);
            break;
        case LANG_ZH: { // China — red + yellow star (cross) + 4 small dots
            gfx->fillRect(x, y, w, h, 0xF800);
            int16_t sx = x + w/5, sy = cy;
            int16_t r  = h/3;
            gfx->fillRect(sx-1, sy-r, 3, r*2+1, 0xFFE0);
            gfx->fillRect(sx-r, sy-1, r*2+1, 3, 0xFFE0);
            gfx->fillRect(x+w/2,    y+h/6,    3, 3, 0xFFE0);
            gfx->fillRect(x+w*3/5,  y+h*5/12, 3, 3, 0xFFE0);
            gfx->fillRect(x+w*3/5,  y+h*7/12, 3, 3, 0xFFE0);
            gfx->fillRect(x+w/2,    y+h*5/6,  3, 3, 0xFFE0);
            break;
        }
    }
}

