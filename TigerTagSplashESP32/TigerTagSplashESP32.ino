// Show language selection menu; returns the chosen language (or current if dismissed).
static Language showLanguageMenu(float weight, const String& uid, OledState state) {
    const int16_t MX = 130, MY = 58, MW = 220, MH = 212;
    const int16_t ROW_H = 34;

    struct { Language lang; const char* name; } opts[6] = {
        { LANG_EN, "English"   },
        { LANG_PT, "Portugues" },
        { LANG_FR, "Francais"  },
        { LANG_ES, "Espanol"   },
        { LANG_DE, "Deutsch"   },
        { LANG_ZH, "Zhongwen"  },
    };

    // Draw overlay panel
    gfx->fillRoundRect(MX - 2, MY - 2, MW + 4, MH + 4, 10, 0x2104);
    gfx->fillRoundRect(MX,     MY,     MW,     MH,      10, 0x18C3);
    gfx->drawRoundRect(MX,     MY,     MW,     MH,      10, 0x8410);

    for (int i = 0; i < 6; i++) {
        int16_t ry = MY + 4 + i * ROW_H;
        if (opts[i].lang == gLanguage) {
            gfx->fillRoundRect(MX + 4, ry + 1, MW - 8, ROW_H - 2, 5, 0x2965);
        }
        drawFlag(opts[i].lang, MX + 10, ry + 7, 30, 20);
        gfx->setTextColor(0xFFFF); gfx->setTextSize(1);
        gfx->setCursor(MX + 48, ry + 13);
        gfx->print(opts[i].name);
        if (i < 5) gfx->drawFastHLine(MX + 6, ry + ROW_H - 1, MW - 12, 0x4208);
    }
    gfx->flush();

    // Wait for a tap (timeout 8 s → cancel)
    int16_t tx, ty;
    { uint32_t t0 = millis(); while (tsRead(tx, ty) && millis()-t0 < 500) delay(10); } // drain
    if (!tsWaitTap(tx, ty, 8000)) {
        displayWeightWithState(weight, uid, state);
        return gLanguage;
    }

    Language chosen = gLanguage;
    for (int i = 0; i < 6; i++) {
        int16_t ry = MY + 4 + i * ROW_H;
        if (tx >= MX && tx <= MX + MW && ty >= ry && ty <= ry + ROW_H - 1) {
            chosen = opts[i].lang;
            break;
        }
    }
    displayWeightWithState(weight, uid, state);
    return chosen;
}

// Dark-theme palette (main weigh screen redesign v2, 2026-07-28) — near-black bg, blue accent.
static const uint16_t COL_BG        = 0x0862;  // page background (near-black navy)
static const uint16_t COL_CARD      = 0x10C4;  // button/card background
static const uint16_t COL_BORDER    = 0x29A8;  // hairline border/divider
static const uint16_t COL_TEXT      = 0xFFFF;  // primary text/icon colour (white)
static const uint16_t COL_MUTED     = 0x8894;  // secondary/label text
static const uint16_t COL_FAINT     = 0x52ED;  // faint hint text (UIDs)
static const uint16_t COL_ACCENT    = 0x2BDF;  // blue accent
