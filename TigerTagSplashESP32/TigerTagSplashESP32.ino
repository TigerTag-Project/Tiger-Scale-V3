            lv_obj_add_event_cb(tb, actionCb, LV_EVENT_CLICKED, nullptr);
            lv_obj_t *tl = lv_label_create(tb);
            lv_label_set_text(tl, themeNames[i]);
            lv_obj_set_style_text_color(tl, sel ? LVCOL_TEXT : LVCOL_MUTED, 0);
            lv_obj_center(tl);
        }

        // Back — top-left arrow, matching the keyboard screen's back button
        lv_obj_t *backBtn = lv_btn_create(scr);
        lv_obj_set_size(backBtn, 34, 36);
        lv_obj_set_pos(backBtn, 0, 0);
        lv_obj_set_style_bg_opa(backBtn, LV_OPA_TRANSP, 0);
        lv_obj_set_style_border_width(backBtn, 0, 0);
        lv_obj_set_style_shadow_width(backBtn, 0, 0);
        lv_obj_set_user_data(backBtn, (void *)(intptr_t)VA_BACK);
        lv_obj_add_event_cb(backBtn, actionCb, LV_EVENT_CLICKED, nullptr);
        lv_obj_t *backIcon = lv_label_create(backBtn);
        lv_label_set_text(backIcon, LV_SYMBOL_LEFT);
        lv_obj_set_style_text_color(backIcon, LVCOL_MUTED, 0);
        lv_obj_center(backIcon);

        lv_scr_load(scr);
        if (prevScr) { lv_obj_del(prevScr); prevScr = nullptr; }

        while (sVolAction == VA_NONE) { lv_timer_handler(); delay(5); }

        prevScr = scr;
        if (sVolAction == VA_BACK) break;

        if (sVolAction == VA_MINUS) {
            int v = (int)gVolume - 10; if (v < 0) v = 0;
            gVolume = (uint8_t)v;
            saveVol();
        } else if (sVolAction == VA_PLUS) {
            int v = (int)gVolume + 10; if (v > 100) v = 100;
            gVolume = (uint8_t)v;
            if (gMute && v > 0) gMute = false;  // auto-unmute on increase
            saveVol();
        } else if (sVolAction >= VA_THEME0 && sVolAction <= VA_THEME3) {
            gSoundTheme = (uint8_t)(sVolAction - VA_THEME0);
            saveVol();
            playSoundTheme();  // preview the selected theme
        }
    }

    lv_scr_load(lvScreen);
    lv_obj_del(prevScr);
    { int16_t dx, dy; uint32_t t0 = millis(); while (tsRead(dx, dy) && millis()-t0 < 800) delay(20); }
}

// Language selector in Settings style: 8 language buttons (4×2 grid), no
// flags, sorted alphabetically by displayed name.
// Language picker, rebuilt as an LVGL screen (same dark theme + card grid as
// the settings menu). Safe to pump its own lv_timer_handler() loop for the
// same reason as tsPick_network() above — only reached from
// runSettingsMenu(), never from an LVGL click callback. Selection
// logic/prefs storage unchanged.
static void runLanguageSettings() {
    const int CW = 110, CH = 96, GAP = 8, X0 = 8;
    const int X1 = X0 + CW + GAP, X2 = X1 + CW + GAP, X3 = X2 + CW + GAP;
    const int Y0 = 44, Y1 = Y0 + CH + GAP;

    struct { Language lang; const char *name; } opts[8] = {
        { LANG_DE, "Deutsch"   },
        { LANG_EN, "English"   },
        { LANG_ES, "Espanol"   },
        { LANG_FR, "Francais"  },
        { LANG_IT, "Italiano"  },
        { LANG_PL, "Polski"    },
        { LANG_PT, "Portugues" },
        { LANG_ZH, "Zhongwen"  },
    };
    const int bx[8] = {X0,X1,X2,X3, X0,X1,X2,X3};
    const int by[8] = {Y0,Y0,Y0,Y0, Y1,Y1,Y1,Y1};

    enum LangAction { LA_NONE, LA_PICK, LA_BACK };
    static LangAction sLangAction;
    static int        sLangIdx;

    auto cardCb = [](lv_event_t *e) {
        lv_obj_t *card = (lv_obj_t *)lv_event_get_target(e);
        sLangIdx = (int)(intptr_t)lv_obj_get_user_data(card);
        sLangAction = LA_PICK;
    };
    auto backCb = [](lv_event_t *e) { sLangAction = LA_BACK; };

    lv_obj_t *prevScr = nullptr;
    for (;;) {
        sLangAction = LA_NONE;

        lv_obj_t *scr = lv_obj_create(nullptr);
        lv_obj_set_style_bg_color(scr, LVCOL_BG, 0);
        lv_obj_set_style_border_width(scr, 0, 0);
        lv_obj_clear_flag(scr, LV_OBJ_FLAG_SCROLLABLE);

        lv_obj_t *title = lv_label_create(scr);
        lv_label_set_text(title, t(I18N_LANGUAGE));
        lv_obj_set_style_text_color(title, LVCOL_TEXT, 0);
        lv_obj_set_style_text_font(title, &lv_font_montserrat_20, 0);
        lv_obj_align(title, LV_ALIGN_TOP_MID, 0, 8);

        lv_obj_t *div = lv_obj_create(scr);
        lv_obj_remove_style_all(div);
        lv_obj_set_size(div, 480, 1);
        lv_obj_set_style_bg_color(div, LVCOL_BORDER, 0);
        lv_obj_set_style_bg_opa(div, LV_OPA_COVER, 0);
        lv_obj_set_pos(div, 0, 36);
        lv_obj_clear_flag(div, LV_OBJ_FLAG_SCROLLABLE);

        for (int i = 0; i < 8; i++) {
            bool sel = (opts[i].lang == gLanguage);
            lv_obj_t *card = lv_btn_create(scr);
            lv_obj_set_size(card, CW, CH);
            lv_obj_set_pos(card, bx[i], by[i]);
            lv_obj_set_style_bg_color(card, LVCOL_CARD, 0);
            lv_obj_set_style_border_color(card, sel ? LVCOL_ACCENT : LVCOL_BORDER, 0);
            lv_obj_set_style_border_width(card, sel ? 2 : 1, 0);
            lv_obj_set_style_radius(card, 12, 0);
            lv_obj_set_style_shadow_width(card, 0, 0);
            lv_obj_set_user_data(card, (void *)(intptr_t)i);
            lv_obj_add_event_cb(card, cardCb, LV_EVENT_CLICKED, nullptr);

            lv_obj_t *lbl = lv_label_create(card);
            lv_label_set_text(lbl, opts[i].name);
            lv_obj_set_style_text_color(lbl, sel ? LVCOL_TEXT : LVCOL_MUTED, 0);
            lv_obj_set_style_text_font(lbl, &lv_font_montserrat_16, 0);
            lv_obj_center(lbl);
        }

        lv_obj_t *backBtn = lv_btn_create(scr);
        lv_obj_set_size(backBtn, 34, 36);
        lv_obj_set_pos(backBtn, 0, 0);
        lv_obj_set_style_bg_opa(backBtn, LV_OPA_TRANSP, 0);
        lv_obj_set_style_border_width(backBtn, 0, 0);
        lv_obj_set_style_shadow_width(backBtn, 0, 0);
        lv_obj_add_event_cb(backBtn, backCb, LV_EVENT_CLICKED, nullptr);
        lv_obj_t *backIcon = lv_label_create(backBtn);
        lv_label_set_text(backIcon, LV_SYMBOL_LEFT);
        lv_obj_set_style_text_color(backIcon, LVCOL_MUTED, 0);
        lv_obj_center(backIcon);

        lv_scr_load(scr);
        if (prevScr) { lv_obj_del(prevScr); prevScr = nullptr; }

        while (sLangAction == LA_NONE) { lv_timer_handler(); delay(5); }

        if (sLangAction != LA_BACK) {
            if (opts[sLangIdx].lang != gLanguage) {
                gLanguage = opts[sLangIdx].lang;
                prefs.begin("config", false);
                prefs.putUChar("language", (uint8_t)gLanguage);
                prefs.end();
            }
        }

        prevScr = scr;
        if (sLangAction == LA_BACK) break;
    }

    lv_scr_load(lvScreen);
    lv_obj_del(prevScr);
    { int16_t dx, dy; uint32_t t0 = millis(); while (tsRead(dx, dy) && millis()-t0 < 1000) delay(20); }
}

static void drawCalibrateIcon(int16_t cx, int16_t cy, int16_t r, uint16_t color, uint16_t bg) {
    const int8_t PW = 5;   // pill half-width  (pill = PW*2 wide)
    const int8_t PH = 13;  // pill half-length (pill spans PH px each side of circle edge)
    int16_t ri = r / 3;    // inner circle radius

    // Outer circle, 2px thick
    gfx->drawCircle(cx, cy, r,   color);
    gfx->drawCircle(cx, cy, r+1, color);

    // Erase 4 small gaps where the pills cross the circle
    gfx->fillRect(cx-PW-1, cy-r-2,   (PW+1)*2, 6, bg); // top
    gfx->fillRect(cx-PW-1, cy+r-3,   (PW+1)*2, 6, bg); // bottom
    gfx->fillRect(cx-r-2,  cy-PW-1,  6, (PW+1)*2, bg); // left
    gfx->fillRect(cx+r-3,  cy-PW-1,  6, (PW+1)*2, bg); // right

    // 4 pills (rounded rects straddling the circle edge)
    gfx->fillRoundRect(cx-PW, cy-r-PH,   PW*2, PH+6, PW, color); // top
    gfx->fillRoundRect(cx-PW, cy+r-5,    PW*2, PH+6, PW, color); // bottom
    gfx->fillRoundRect(cx-r-PH,  cy-PW,  PH+6, PW*2, PW, color); // left
    gfx->fillRoundRect(cx+r-5,   cy-PW,  PH+6, PW*2, PW, color); // right

    // Inner circle, 2px thick
    gfx->drawCircle(cx, cy, ri,   color);
    gfx->drawCircle(cx, cy, ri+1, color);

    // Plus sign, 2px thick
    gfx->drawFastVLine(cx,   cy-ri+4, ri*2-8, color);
    gfx->drawFastVLine(cx+1, cy-ri+4, ri*2-8, color);
    gfx->drawFastHLine(cx-ri+4, cy,   ri*2-8, color);
    gfx->drawFastHLine(cx-ri+4, cy+1, ri*2-8, color);
}

static void drawLanguageIcon(int16_t cx, int16_t cy, uint16_t color, uint16_t bg) {
    // Globe: slightly right+down from icon centre
    int16_t gx=cx+8, gy=cy+6, r=22, mrx=7;
    gfx->drawCircle(gx, gy, r, color);
    gfx->drawCircle(gx, gy, r+1, color);
    // Vertical meridian (diamond approximation)
    gfx->drawLine(gx, gy-r, gx-mrx, gy,   color);
    gfx->drawLine(gx-mrx, gy, gx,   gy+r, color);
    gfx->drawLine(gx, gy-r, gx+mrx, gy,   color);
    gfx->drawLine(gx+mrx, gy, gx,   gy+r, color);
    // Upper latitude arc
    gfx->drawLine(gx-r+3, gy-7, gx,   gy-11, color);
    gfx->drawLine(gx,   gy-11, gx+r-3, gy-7,  color);
    // Lower latitude arc
    gfx->drawLine(gx-r+3, gy+7, gx,   gy+11, color);
    gfx->drawLine(gx,   gy+11, gx+r-3, gy+7,  color);

    // ─── Left bubble (top-left corner of icon) ───
    int16_t lb_x=cx-38, lb_y=cy-32, lb_w=34, lb_h=24;
    gfx->fillRoundRect(lb_x, lb_y, lb_w, lb_h, 4, bg);
    gfx->drawRoundRect(lb_x, lb_y, lb_w, lb_h, 4, color);
    // Tail pointing down-right toward globe
    gfx->fillTriangle(lb_x+lb_w-12, lb_y+lb_h,
                      lb_x+lb_w-4,  lb_y+lb_h,
                      lb_x+lb_w-2,  lb_y+lb_h+10, color);
    gfx->fillRect(lb_x+lb_w-11, lb_y+lb_h-1, 8, 3, bg);
    // "A"
    gfx->setTextColor(color); gfx->setTextSize(2);
    gfx->setCursor(lb_x+(lb_w-12)/2, lb_y+(lb_h-16)/2);
    gfx->print("A");

    // ─── Right bubble (bottom-right corner of icon) ───
    int16_t rb_x=cx+14, rb_y=cy+12, rb_w=32, rb_h=22;
    gfx->fillRoundRect(rb_x, rb_y, rb_w, rb_h, 4, bg);
    gfx->drawRoundRect(rb_x, rb_y, rb_w, rb_h, 4, color);
    // Tail pointing up-left toward globe
    gfx->fillTriangle(rb_x+4,  rb_y,
                      rb_x+12, rb_y,
                      rb_x+2,  rb_y-10, color);
    gfx->fillRect(rb_x+5, rb_y-1, 6, 3, bg);
    // "文" drawn as primitives (12×13 px)
    int16_t wx=rb_x+(rb_w-12)/2, wy=rb_y+(rb_h-13)/2;
    gfx->drawFastVLine(wx+5, wy,   2, color); // top small stroke
    gfx->drawFastVLine(wx+6, wy,   2, color);
    gfx->drawFastHLine(wx,   wy+3, 12, color); // horizontal bar (2px)
    gfx->drawFastHLine(wx,   wy+4, 12, color);
    gfx->drawLine(wx+1,  wy+5, wx+4,  wy+12, color); // left diagonal (2px)
    gfx->drawLine(wx+2,  wy+5, wx+5,  wy+12, color);
    gfx->drawLine(wx+10, wy+5, wx+7,  wy+12, color); // right diagonal (2px)
    gfx->drawLine(wx+11, wy+5, wx+8,  wy+12, color);
    gfx->drawFastHLine(wx+2, wy+12, 8, color); // bottom bar
}

