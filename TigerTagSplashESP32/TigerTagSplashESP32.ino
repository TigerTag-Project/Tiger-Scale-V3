// BROKEN on ESP32-S3, inherited from V4 -- GPIO22 doesn't physically exist
// on this chip (S3 skips GPIO22-25) and GPIO21 is wired to the camera
// connector (CAM_D7) on this board, not I2C. Every boot's I2C scan on this
// bus finds 0 devices ("Invalid pin: 22" from the periman). Left as-is
// since fixing the TCA9554 wiring is out of scope here; do not put new
// peripherals (e.g. PN532 I2C) on this bus -- use Wire1 (GPIO8/7) instead.
#define I2C_SDA       21   // Waveshare demo + .bak: TCA9554 SDA on GPIO21
#define I2C_SCL       22   // Waveshare demo + .bak: TCA9554 SCL on GPIO22
#define TCA_ADDR    0x20

#define PN532_SPI_SCK   47
#define PN532_SPI_MISO  48
#define PN532_SPI_MOSI  41
#if RFID_TRANSPORT_HSU
// HSU mode has no chip-select concept -- these two stay defined only because
// initPN532Reader()/setupRFID() (shared with the SPI build) still toggle
// them as plain GPIOs before reader.init() runs; harmless spare pins here.
#define PN532_1_SS      42
#define PN532_2_SS      38
// ESP32 UART pins are matrix-routable to any GPIO, so these reuse the pins
// freed by not using the SPI bus. PN532 RXD/TXD are the module's HSU pins
// on the back of the PCB (same physical pins as SDA/SCL in I2C mode).
#define PN532_1_RXD     47   // ESP32 RX  <- PN532 TXD (right reader, Serial1)
#define PN532_1_TXD     48   // ESP32 TX  -> PN532 RXD
#define PN532_2_RXD     41   // ESP32 RX  <- PN532 TXD (left reader, Serial2)
#define PN532_2_TXD     18   // ESP32 TX  -> PN532 RXD
#elif RFID_TRANSPORT_I2C
// The I2C reader sits on `Wire1` (SDA=GPIO8, SCL=GPIO7) — see the PN532Reader
// I2C branch in §5, which constructs it with &Wire1. NOT the plain `Wire` bus:
// its I2C_SDA/I2C_SCL below are the broken GPIO21/22 pair described above.
// (This comment used to claim the opposite, which was wrong.)
//
// These SS/IRQ macros are unused placeholders, kept only because shared code
// still references them (initPN532Reader() toggles SS as a plain GPIO; the IRQ
// pin isn't wired -- Adafruit_PN532 polls over I2C, it doesn't need it).
#define PN532_1_SS      42
#define PN532_2_SS      18
#define PN532_1_IRQ     47
#define PN532_2_IRQ     48
#else
#define PN532_1_SS      42
#define PN532_2_SS      18
#endif
#define PN532_1_RST     17
#define PN532_2_RST     9

#define HX711_DOUT    39
