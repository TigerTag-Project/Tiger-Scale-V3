    lv_obj_set_pos(tareBtn, BTN_X0, BTN_Y);
    lv_obj_set_style_bg_color(tareBtn, LVCOL_CARD, 0);
    lv_obj_set_style_border_color(tareBtn, LVCOL_BORDER, 0);
    lv_obj_set_style_border_width(tareBtn, 1, 0);
    lv_obj_set_style_radius(tareBtn, 14, 0);
    lv_obj_set_style_shadow_width(tareBtn, 0, 0);
    lv_obj_add_event_cb(tareBtn, lvglTareBtnEvent, LV_EVENT_CLICKED, nullptr);
    // Value + caption in a centered flex column instead of fixed TOP_MID
    // offsets, so the pair sits centered in the button instead of high with
    // empty space below (per photo feedback).
    lv_obj_t *tareCol = lv_obj_create(tareBtn);
    lv_obj_remove_style_all(tareCol);
    lv_obj_set_size(tareCol, TARE_W, LV_SIZE_CONTENT);
    lv_obj_set_flex_flow(tareCol, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_flex_align(tareCol, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
    lv_obj_center(tareCol);
    lv_obj_clear_flag(tareCol, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_clear_flag(tareCol, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_t *tareValueLabel = lv_label_create(tareCol);
    lv_label_set_text(tareValueLabel, "0.0");
    lv_obj_set_style_text_color(tareValueLabel, LVCOL_TEXT, 0);
    lv_obj_set_style_text_font(tareValueLabel, &lv_font_montserrat_28, 0);
    lvTareCaption = lv_label_create(tareCol);
    lv_label_set_text(lvTareCaption, t(I18N_TARE));
    lv_obj_set_style_text_color(lvTareCaption, LVCOL_MUTED, 0);

    lv_obj_t *settingsBtn = lv_btn_create(lvScreen);
    lv_obj_set_size(settingsBtn, SETTINGS_W, BTN_H);
    lv_obj_set_pos(settingsBtn, BTN_X0 + TARE_W + BTN_GAP, BTN_Y);
    lv_obj_set_style_bg_color(settingsBtn, LVCOL_CARD, 0);
    lv_obj_set_style_border_color(settingsBtn, LVCOL_BORDER, 0);
    lv_obj_set_style_border_width(settingsBtn, 1, 0);
    lv_obj_set_style_radius(settingsBtn, 14, 0);
    lv_obj_set_style_shadow_width(settingsBtn, 0, 0);
    lv_obj_add_event_cb(settingsBtn, lvglSettingsBtnEvent, LV_EVENT_CLICKED, nullptr);
    lv_obj_t *settingsCol = lv_obj_create(settingsBtn);
    lv_obj_remove_style_all(settingsCol);
    lv_obj_set_size(settingsCol, SETTINGS_W, LV_SIZE_CONTENT);
    lv_obj_set_flex_flow(settingsCol, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_flex_align(settingsCol, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
    lv_obj_center(settingsCol);
    lv_obj_clear_flag(settingsCol, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_clear_flag(settingsCol, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_t *gearLabel = lv_label_create(settingsCol);
    lv_label_set_text(gearLabel, LV_SYMBOL_SETTINGS);
    lv_obj_set_style_text_color(gearLabel, LVCOL_TEXT, 0);
    lv_obj_set_style_text_font(gearLabel, &lv_font_montserrat_28, 0);
    lvSettingsCaption = lv_label_create(settingsCol);
    lv_label_set_text(lvSettingsCaption, t(I18N_SETTINGS));
    lv_obj_set_style_text_color(lvSettingsCaption, LVCOL_MUTED, 0);

    lv_scr_load(lvScreen);
}

// Called on every displayWeightWithState() invocation (same call sites, same
// cadence as before). Builds the screen once, then only updates the fields
// that can change: text, colors, and the top-left/brand-card visibility.
static void lvglUpdateMainScreen(float weight, const String& uid, OledState state) {
    if (lvScreen == nullptr) lvglBuildMainScreen();
    if (lvScreen == nullptr) return; // build failed (e.g. buffer alloc failure)

    // Static captions set once at build time don't otherwise track a
    // language change made afterward in Settings -- re-set them every call
    // (cheap: lv_label_set_text() is a no-op redraw-wise if the string is
    // already identical).
    lv_label_set_text(lvContainerLabel, t(I18N_CONTAINER));
    lv_label_set_text(lvFilamentLabel, t(I18N_FILAMENT));
    lv_label_set_text(lvTareCaption, t(I18N_TARE));
    lv_label_set_text(lvSettingsCaption, t(I18N_SETTINGS));

    bool tagActive = (lastUIDLeft.length() > 0 || lastUIDRight.length() > 0)
                  || (wfPhase == WF_DONE && gLastManufacturer.length() > 0 && gLastManufacturer != "--");

    // ---- Top-left: remove-material label vs. status pill ----
    if (tagActive) {
        lv_obj_set_style_bg_opa(lvTopLeftLabel, LV_OPA_COVER, 0);
        lv_obj_set_style_bg_color(lvTopLeftLabel, LVCOL_ORANGE, 0);
        lv_obj_set_style_text_color(lvTopLeftLabel, LVCOL_TEXT, 0);
        lv_label_set_text(lvTopLeftLabel, t(I18N_REMOVE_MATERIAL));
    } else {
        const char *statusLbl;
        lv_color_t statusBg, statusFg;
        switch (state) {
            case OLED_STATE_IDLE:
                statusLbl = t(I18N_READY);   statusBg = LVCOL_GREEN; statusFg = LVCOL_TEXT; break;
            case OLED_STATE_WEIGHING:
            case OLED_STATE_UID_DETECTED:
                statusLbl = t(I18N_WEIGHING); statusBg = LVCOL_ACCENT; statusFg = LVCOL_TEXT; break;
            case OLED_STATE_SENDING:
                statusLbl = t(I18N_SENDING); statusBg = LVCOL_ACCENT; statusFg = LVCOL_TEXT; break;
            case OLED_STATE_SUCCESS:
                statusLbl = t(I18N_SYNCED);  statusBg = LVCOL_GREEN; statusFg = LVCOL_TEXT; break;
            case OLED_STATE_ERROR:
                statusLbl = t(I18N_ERROR);   statusBg = LVCOL_RED;   statusFg = LVCOL_TEXT; break;
            default:
                statusLbl = t(I18N_READY);   statusBg = LVCOL_GREEN; statusFg = LVCOL_TEXT;
        }
        lv_obj_set_style_bg_opa(lvTopLeftLabel, LV_OPA_COVER, 0);
        lv_obj_set_style_bg_color(lvTopLeftLabel, statusBg, 0);
        lv_obj_set_style_text_color(lvTopLeftLabel, statusFg, 0);
        lv_label_set_text(lvTopLeftLabel, statusLbl);
    }

    // ---- Avatar (initials) + name ----
    String scaleName = (firebaseAuth && firebaseDisplayName.length()) ? firebaseDisplayName : "Tiger Scale";
    lv_label_set_text(lvNameLabel, scaleName.c_str());
    if (firebaseAuth) {
        String src = firebaseDisplayName.length() ? firebaseDisplayName : firebaseEmail;
        char ini = src.length() ? (char)toupper((unsigned char)src.charAt(0)) : '?';
        static const uint32_t PALLETE[] = {
            0x1F41E6, 0x1FA000, 0xE60000, 0xE6001F, 0x00E6E6, 0xE6E600, 0x6B1080, 0x102080
        };
        lv_obj_set_style_bg_color(lvAvatarCircle, lv_color_hex(PALLETE[(ini - 'A' + 26) % 8]), 0);
        char iniStr[2] = { ini, 0 };
        lv_label_set_text(lvAvatarInitials, iniStr);
        lv_obj_clear_flag(lvAvatarCircle, LV_OBJ_FLAG_HIDDEN);
    } else {
        lv_obj_set_style_bg_color(lvAvatarCircle, LVCOL_CARD, 0);
        lv_label_set_text(lvAvatarInitials, "?");
    }

    // ---- Brand/material card ----
    if (tagActive) {
        lv_obj_clear_flag(lvBrandCard, LV_OBJ_FLAG_HIDDEN);
        uint32_t circleColor = 0x556070;
        int hi = gLastColor.indexOf('#');
        if (hi >= 0 && (int)gLastColor.length() >= hi + 7) {
            circleColor = (uint32_t)strtol(gLastColor.substring(hi + 1, hi + 7).c_str(), nullptr, 16);
        }
        lv_obj_set_style_bg_color(lvBrandCircle, lv_color_hex(circleColor), 0);
        String brandStr = gLastManufacturer.length() > 10 ? gLastManufacturer.substring(0, 10) : gLastManufacturer;
        String matStr   = gLastMaterial.length() > 10 ? gLastMaterial.substring(0, 10) : gLastMaterial;
        lv_label_set_text(lvBrandLabel, brandStr.c_str());
        lv_label_set_text(lvMaterialLabel, matStr.c_str());
    } else {
        lv_obj_add_flag(lvBrandCard, LV_OBJ_FLAG_HIDDEN);
    }

    // ---- Weight ----
    int totalInt = roundWeight(weight);
    lv_label_set_text_fmt(lvWeightLabel, "%d g", totalInt);

    // ---- Container | Filament ----
    float netWeight = (gLastContainer > 0 && weight > gLastContainer) ? weight - gLastContainer : 0.0f;
    String contStr = gLastContainer > 0 ? (String((int)gLastContainer) + " g") : "-- g";
    String filmStr = netWeight > 0      ? (String((int)roundWeight(netWeight)) + " g") : "-- g";
    lv_label_set_text(lvContainerValue, contStr.c_str());
    lv_label_set_text(lvFilamentValue, filmStr.c_str());

    // ---- Rack name + position (real data from Firebase, "--" placeholder like container/filament) ----
    lv_label_set_text(lvRackNameLabel, gLastRackName.length() ? gLastRackName.c_str() : "--");
    lv_label_set_text(lvPositionLabel, gLastRackPosition.length() ? gLastRackPosition.c_str() : "--");

    // ---- Bottom bar: battery / wifi / cloud / volume ----
    {
        static uint8_t  batPct    = 254;
        static bool     batVbus   = false;
        static uint32_t batLastMs = 0;
        if (millis() - batLastMs > 30000 || batLastMs == 0) {
            batLastMs = millis();
            batPct = axpBatteryPercent(batVbus);
        }
        // batPct == 254 means the AXP2101 couldn't be read at all (not just
        // "no battery", which is its own distinct 255 code). On hardware with
        // no battery wired up, that I2C read can fail outright instead of
        // cleanly reporting "no battery" -- since the device has to be
        // running on *some* power source, and there's no battery to read,
        // treat "unreadable" the same as "charging via USB" rather than
        // showing an empty icon. Used to only do this when a USB-serial
        // monitor happened to be attached ((bool)Serial), which doesn't hold
        // for plain USB power with no monitor open.
        bool charging = (batPct == 255 || batPct == 254 || batVbus);
        int  bars;      // 0-3 lit bars, left slot first -- they deplete right-to-left as % drops
        lv_color_t barCol;
        if (charging)              { bars = 0; barCol = LVCOL_YELLOW; }
        else if (batPct > 66)      { bars = 3; barCol = LVCOL_YELLOW; }
        else if (batPct > 33)      { bars = 2; barCol = LVCOL_YELLOW; }
        else if (batPct > 10)      { bars = 1; barCol = LVCOL_YELLOW; }
        else                       { bars = 1; barCol = LVCOL_RED; } // low-battery warning: 1 red bar, not an empty icon

        // Outline always stays white regardless of charge state -- only the
        // bar fill (and the low-battery red) carries the color signal now.
        lv_obj_set_style_border_color(lvBatteryBody, LVCOL_TEXT, 0);
        for (int i = 0; i < 3; i++) {
            lv_obj_set_style_bg_color(lvBatteryBar[i], barCol, 0);
            if (!charging && i < bars) lv_obj_clear_flag(lvBatteryBar[i], LV_OBJ_FLAG_HIDDEN);
            else                       lv_obj_add_flag(lvBatteryBar[i], LV_OBJ_FLAG_HIDDEN);
        }
        if (charging) lv_obj_clear_flag(lvBatteryBolt, LV_OBJ_FLAG_HIDDEN);
        else          lv_obj_add_flag(lvBatteryBolt, LV_OBJ_FLAG_HIDDEN);

        if (batPct <= 100) lv_label_set_text_fmt(lvBatteryPctLabel, "%u%%", batPct);
        else               lv_label_set_text(lvBatteryPctLabel, "");
    }
    lv_obj_set_style_text_color(lvWifiLabel, wifiConnected ? LVCOL_GREEN : LVCOL_RED, 0);
    {
        lv_color_t cloudCol = firebaseAuth ? LVCOL_GREEN : LVCOL_RED;
        lv_obj_set_style_bg_color(lvCloudDome1, cloudCol, 0);
        lv_obj_set_style_bg_color(lvCloudDome2, cloudCol, 0);
        lv_obj_set_style_bg_color(lvCloudBase, cloudCol, 0);
    }
    if (gMute) {
        lv_label_set_text(lvVolumeLabel, LV_SYMBOL_MUTE);
        lv_obj_set_style_text_color(lvVolumeLabel, LVCOL_RED, 0);
    } else {
        // Fewer/more arcs depending on the configured level (gVolume 0-100),
        // matching the two levels LVGL's built-in glyph actually offers.
        lv_label_set_text(lvVolumeLabel, gVolume >= 50 ? LV_SYMBOL_VOLUME_MAX : LV_SYMBOL_VOLUME_MID);
        lv_obj_set_style_text_color(lvVolumeLabel, LVCOL_TEXT, 0);
    }
}

// ============================================================================
// §26 — SETUP & LOOP
// ============================================================================

void setup() {
    Serial.begin(115200);
#if ARDUINO_USB_CDC_ON_BOOT
    Serial.setTxTimeoutMs(0); // non-blocking: drop data if no host reading (avoids CDC lag)
    // With TinyUSB (USBMode=default), Serial correctly reflects CDC connection state.
    // Wait up to 4s for a host to open the port; then proceed regardless.
    { uint32_t _t = millis(); while (!Serial && millis() - _t < 4000) delay(10); }
#endif
    Serial.println("[BOOT] setup() start");
    Serial.printf("[BOOT] reset reason=%d\n", (int)esp_reset_reason());
    if (LED_PIN >= 0) pinMode(LED_PIN, OUTPUT);
    #if !RFID_DIAG_DISABLE_DISPLAY_STACK
    pinMode(LCD_BL, OUTPUT);
    digitalWrite(LCD_BL, LOW); // backlight off until display init confirmed OK
    #endif

    prefs.begin("config", true);
    firebaseEmail        = prefs.getString("fbEmail",       "");
    firebaseDisplayName  = prefs.getString("fbDisplayName", "");
    firebasePassword     = prefs.getString("fbPass",        "");
    firebaseRefreshToken = prefs.getString("fbRefresh",     "");
    firebaseUid          = prefs.getString("fbUid",         "");
    gUserAvatarUrl       = prefs.getString("avatarUrl",     "");
    gUserAvatarUid       = prefs.getString("avatarUid",     "");
    calibrationFactor    = prefs.getFloat("calFactor", calibrationFactor);
    gLanguage            = (Language)prefs.getUChar("language", LANG_EN);
    gVolume              = prefs.getUChar("volume",     75);
    gMute                = prefs.getBool ("mute",       false);
    gSoundTheme          = prefs.getUChar("soundTheme", 0);
    servoEnabled         = prefs.getBool("servoEnabled",   false);
    hwRfidCount          = prefs.getUChar("hwRfidCnt",     1);
    hwRfidSide           = prefs.getUChar("hwRfidSide",    1);
    gRfidPowerLevel      = prefs.getUChar("rfidPower",     3);
    if (gRfidPowerLevel >= PN532_RF_LEVEL_COUNT) gRfidPowerLevel = 3;
    hwMotorConnected     = prefs.getBool("hwMotorConn",    false);
    hwMotorSpeed         = prefs.getUChar("hwMotorSpd",    0);
    if (hwMotorSpeed > 5) hwMotorSpeed = 0;
    prefs.end();
    normalizeRfidHwConfig();

    hwRfidCount = 2;

    // This Waveshare scale variant has no motor/servo hardware.
    servoEnabled = false;
    hwMotorConnected = false;
    hwMotorSpeed = 0;
    servoSearching = false;
    servoTestActive = false;

    if (RFID_INIT_BEFORE_DISPLAY || RFID_DIAG_DISABLE_DISPLAY_STACK) {
        Serial.println("[BOOT] earliest setupRFID()");
        setupRFID();
    } else {
        Serial.println("[BOOT] early RFID init skipped; will init after display");
    }

    #if !RFID_DIAG_DISABLE_DISPLAY_STACK
    // NOTE: this Wire bus (GPIO21/22) cannot work on this board — GPIO22 does not
    // exist on the ESP32-S3 and GPIO21 goes to the camera connector. The begin()
    // below therefore logs "perimanSetPinBus(): Invalid pin: 22", and the
    // lcdResetByTCA9554() that follows logs a handful of "NULL TX buffer pointer"
    // errors because the bus never came up. Both are expected on this hardware and
    // harmless: the display initialises fine without the TCA9554 reset, as the
    // "[LCD] begin OK" line right below proves on every boot. Left in place rather
    // than removed because it is the vendor's documented reset sequence and a
    // future board revision may wire it correctly. Do not chase those errors, and
    // do not attach new peripherals here — use Wire1 (GPIO8/7).
    Wire.begin(I2C_SDA, I2C_SCL);
    lcdResetByTCA9554();

    if (!gfx->begin()) {
        Serial.println("Display init failed — continuing without display");
    } else {
        gDisplayReady = true;
        // Canvas handles rotation — no setRotation() needed here
        digitalWrite(LCD_BL, HIGH); // backlight on now that display is ready
        Serial.printf("[LCD] begin OK w=%d h=%d\n", gfx->width(), gfx->height());
        setupTouchI2C();  // AXS5106L on Wire1 (SDA=8, SCL=7, addr=0x3B)
        _touchI2CReady = true;
        // Scan the bus that is actually wired, now that it has been begun. This
        // enumerates the touch controller (0x3B), the AXP2101 PMIC (0x34), the
        // ES8311 codec (0x18) and, in the I2C build, the PN532 (0x24) — a useful
        // one-line health check for a device whose owner wired it themselves.
        scanI2C(Wire1, "Wire1", TS_SDA, TS_SCL);
        lvglInit();  // main weigh screen is built lazily on the first lvglUpdateMainScreen() call
    }

    drawSplash();
    delay(2000);
    bootProgress(5, "Starting...");

    // Re-arm the RC522 readers after the LCD/QSPI stack comes up.
    // On this board, bringing the display online can leave the RFID side
    // unresponsive unless we explicitly reinitialize the readers afterward.
    Serial.println("[BOOT] setupRFID() after display init");
    setupRFID();
    #else
    Serial.println("[LCD] display stack disabled for RFID diagnostic");
    #endif

    Serial.printf("[BOOT] Firebase configured: %s (mode=%s)\n",
                  isFirebaseConfigured() ? "yes" : "no",
                  firebaseRefreshToken.length() ? "token" :
                    (firebasePassword.length() ? "password" : "none"));

    WiFi.onEvent(onWiFiEvent);
    setupWiFi();
    if (WiFi.isConnected()) startMDNS();

    // Sign in to Firebase on boot if credentials are stored.
    // ensureFirebaseToken() handles both paths:
    //   - if a refreshToken is present, refresh via securetoken.googleapis.com
    //     (Google Auth users — no password ever needed)
    //   - else if email+password is present, fall back to firebaseSignIn()
    if (isFirebaseConfigured() && WiFi.isConnected()) {
        bootProgress(62, "Firebase...");
        delay(400);
    }

    Serial.println("[BOOT] setupFileSystem()");
    bootProgress(70, "Filesystem...");
    setupFileSystem();
    Serial.println("[BOOT] loadTagDbs()");
    bootProgress(78, "Loading databases...");
    loadTagDbs();       // Preload brand/material name DBs from LittleFS into RAM
    gLastDbCheckMs = 0;
    Serial.printf("[BOOT] DB sync deferred by %lu ms\n", (unsigned long)DB_BOOT_DEFER_MS);
    Serial.println("[BOOT] setupWebServer()");
    bootProgress(85, "Web server...");
    setupWebServer();
    Serial.println("[BOOT] setupScale()");
    setupScale();
    // setupScale() already handles tare (restores saved tare or runs first-boot tare)
    currentWeight = 0.0f;
    resetWeightFilters();
    autoTarePending = false;
    autoTareStableSinceMs = 0;

    Serial.println("[BOOT] setupServo()");
    setupServo();
    gCloudBootReadyAtMs = millis() + CLOUD_BOOT_DELAY_MS;
    gFirebaseBootReadyAtMs = millis() + FIREBASE_BOOT_DELAY_MS;
    gLastHeartbeatScheduleMs = millis();
    gLastCommandPollMs = millis();
    Serial.printf("[BOOT] cloud startup deferred by %lu ms\n", (unsigned long)CLOUD_BOOT_DELAY_MS);
    Serial.printf("[BOOT] firebase startup deferred by %lu ms\n", (unsigned long)FIREBASE_BOOT_DELAY_MS);

    // Defer background task creation until loop() after the boot settles.
    Serial.println("[BOOT] background tasks deferred");

    gLastActivityMs = millis(); // start screensaver timer from boot completion

    Serial.println("[BOOT] setup() complete");
    bootProgress(100, "Ready!");
    delay(1200);
    gBootComplete = true;
}

void loop() {
#if LVGL_TEST_MODE
    // Isolated hardware smoke test: only pump the LVGL timer, skip all normal
    // firmware logic (WiFi/RFID/scale/display) so the flush+touch bridge can
    // be validated without any interference. Set LVGL_TEST_MODE to 0 above to
    // restore normal operation.
    if (lvglReady) lv_timer_handler();
    delay(5);
    return;
#endif
    if (lvglReady) lv_timer_handler();
    if (gSettingsRequested) {
        gSettingsRequested = false;
        runSettingsMenu();
        lv_obj_invalidate(lvScreen);
    }
    static uint32_t lastUpdate = 0;
    static uint32_t lastBlink  = 0;
    static bool lastServerReadyLog = false;
    static uint32_t lastAliveLogMs = 0;
    static uint32_t lastHeartbeatMs = 0;

    if (millis() - lastHeartbeatMs >= 5000) {
        lastHeartbeatMs = millis();
        Serial.printf("[HB] up=%lus heap=%u wifi=%d disp=%d\n",
                      millis()/1000UL, ESP.getFreeHeap(), (int)WiFi.isConnected(), (int)gDisplayReady);
    }

    if ((USE_SYNC_WEBSERVER || MINIMAL_HTTP_DIAG) && gWebServerStarted) {
        syncServer.handleClient();
    }

    if (millis() - lastBlink > 1000) {
        if (LED_PIN >= 0) digitalWrite(LED_PIN, !digitalRead(LED_PIN));
        lastBlink = millis();
    }

    if (ENABLE_HTTP_SERVER && gWebServerStartPending && !gWebServerStarted &&
        !gWebServerStarting && millis() >= gCloudBootReadyAtMs) {
        gWebServerStarting = true;
        Serial.println("[HTTP] Starting server from main loop");
        startWebServerNow();
    }

    if (ENABLE_BACKGROUND_TASKS && !gBackgroundTasksStarted && millis() >= gCloudBootReadyAtMs) {
        Serial.println("[BOOT] start cloudWorkerTask");
        xTaskCreatePinnedToCore(cloudWorkerTask, "cloudWorker",
                                20480, nullptr, 1, nullptr, 0);
        Serial.println("[BOOT] start twinWorkerTask");
        xTaskCreatePinnedToCore(twinWorkerTask, "twinWorker",
                                12288, nullptr, 1, nullptr, 0);
        gBackgroundTasksStarted = true;
        Serial.println("[BOOT] background tasks started");
    }

    // Detect WiFi network change - clear credentials if WiFi SSID changed
    if (WiFi.isConnected()) {
        String currentSSID = WiFi.SSID();
        if (lastConnectedSSID.length() > 0 && currentSSID != lastConnectedSSID) {
            // WiFi changed! Clear Firebase credentials to force relogin
            Serial.printf("[WIFI] Network changed: %s -> %s. Clearing Firebase credentials.\n",
                          lastConnectedSSID.c_str(), currentSSID.c_str());
            firebaseAuth = false;
            firebaseIdToken = "";
            firebaseRefreshToken = "";
            firebaseUid = "";
            firebaseEmail = "";
            firebasePassword = "";
            lastConnectedSSID = currentSSID;
        }
        if (lastConnectedSSID.length() == 0) {
            lastConnectedSSID = currentSSID;
        }
    }

    if (ENABLE_FIREBASE_BACKGROUND && !lastServerReadyLog && millis() >= gFirebaseBootReadyAtMs) {
        lastServerReadyLog = true;
        Serial.println("[BOOT] firebase/cloud gate opened");
    }

    if (gPostFirebaseStabilizePending && millis() >= gPostFirebaseStabilizeAtMs) {
        gPostFirebaseStabilizePending = false;
        gPostFirebaseStabilized = true;
        Serial.println("[BOOT] post-Firebase stabilization");
        stopServoSearch();
        scale.tare();
        currentWeight = 0.0f;
        resetWeightFilters();
        autoTarePending = false;
        autoTareStableSinceMs = 0;
        autoTareStartedMs = 0;
        wfPhase = WF_IDLE;
        sendPhase = "idle";
        sendCountdown = -1;
        wfContainerWeight = 0.0f;
        wfContainerFetched = false;
        lastUID = ""; lastUID2 = ""; lastUIDHex = ""; lastUID2Hex = "";
        lastUIDLeft = ""; lastUIDRight = ""; lastUIDTwin = "";
        gTwinFetchDone = false; gTwinFetchPending = false; gTwinFetchUID = ""; gTwinFetchResult = "";
        gLastRfidUid1 = ""; gLastRfidUid2 = ""; gLastRfidUid1Ms = 0; gLastRfidUid2Ms = 0;
        gLastRfidNoUid1Ms = 0; gLastRfidNoUid2Ms = 0;
        firstUidDetectedMs = 0; firstUidPauseUntilMs = 0;
        Serial.println("[BOOT] post-Firebase setupRFID()");
        setupRFID();
        logMem("postFirebaseStabilized");
        Serial.printf("[BOOT] ready wifi=%d firebase=%d readers=%u side=%s\n",
                      WiFi.isConnected() ? 1 : 0,
                      firebaseAuth ? 1 : 0,
                      hwRfidCount,
                      hwRfidSide == 1 ? "right" : "left");
        pushSessionEvent("boot_ready", "wifi=" + String(WiFi.isConnected() ? 1 : 0) +
                                      " firebase=" + String(firebaseAuth ? 1 : 0) +
                                      " readers=" + String(hwRfidCount));
        gIdleHeartbeatMs = millis() + 15000;
    }

    // Defer cloud/Firebase startup until the boot sequence is fully settled.
    if (ENABLE_FIREBASE_BACKGROUND && millis() >= gFirebaseBootReadyAtMs) {
        // Renew the idToken every 30 minutes in the background so it is never
        // stale. ensureFirebaseToken() is a no-op if the token is still fresh.
        static uint32_t lastTokenRenew = 0;
        if (WiFi.isConnected() && isFirebaseConfigured()
            && (lastTokenRenew == 0 || (millis() - lastTokenRenew) > 1800000UL)) {
            bool firstBoot = (lastTokenRenew == 0);
            lastTokenRenew = millis();
            gTokenRenewPending   = true;
            if (firstBoot) gFirestoreSyncNeeded = true;
        }

        // Firestore heartbeat every 30 seconds.
        if (WiFi.isConnected() && (millis() - gLastHeartbeatScheduleMs) >= HEARTBEAT_INTERVAL_MS) {
            gLastHeartbeatScheduleMs = millis();
            gHeartbeatPending = true;
        }

        // OTA poll at the same cadence gate as normal operation.
        if ((millis() - gLastCommandPollMs) >= OTA_COMMAND_POLL_MS) {
            gLastCommandPollMs = millis();
            gOtaPollPending = true;
        }
    }

    // Periodic TigerTag DB update check - every 24 h.
    // Same logic as the Python script: fetch last_update.json, download only
    // what changed. Runs in a one-shot Core-0 task so loop() is never blocked.
    if (ENABLE_DB_BACKGROUND && millis() >= gFirebaseBootReadyAtMs && WiFi.isConnected() && !gDbUpdateRunning) {
        bool shouldRunDbSync = false;
        if (gLastDbCheckMs == 0) {
            if (millis() >= DB_BOOT_DEFER_MS) shouldRunDbSync = true;
        } else if (millis() - gLastDbCheckMs >= DB_CHECK_INTERVAL_MS) {
            shouldRunDbSync = true;
        }

        if (shouldRunDbSync) {
            gLastDbCheckMs   = millis();
            gDbUpdateRunning = true;
            xTaskCreatePinnedToCore(dbUpdateTaskFn, "dbUpdate", 12288, nullptr, 1, nullptr, 0);
        }
    }


    // -- RFID antenna sleep/wake ----------------------------------------------
    // Silence the 13.56 MHz field when the platform is empty (< 50 g) and no
    // active session is in progress.  Uses currentWeight from the previous
    // cycle — 1-cycle latency is irrelevant for a sleep decision.
    {
        bool needAntennas = true;
        if (needAntennas != rfidAntennasOn) rfidAntennaSetAll(needAntennas);
    }

    static uint32_t lastRfidDiagMs = 0;
    bool rfidPollingAllowed = rfidAntennasOn && !rfidTestActive;
    if (!rfidPollingAllowed && millis() - lastRfidDiagMs >= 2000) {
        lastRfidDiagMs = millis();
        RFID_DEBUG_PRINTF("[RFID DBG] poll=OFF locked=%d autoTare=%d antennas=%d test=%d wf=%d\n",
                          rfidLockedForCurrentLoad ? 1 : 0,
                          autoTarePending ? 1 : 0,
                          rfidAntennasOn ? 1 : 0,
                          rfidTestActive ? 1 : 0,
                          (int)wfPhase);
    }

    if (rfidPollingAllowed && millis() >= gNextRfidPollMs) {
        // Halved vs. single-reader polling when both are present, since the
        // round-robin split below (gRfidPollRightNext) now checks only one
        // reader per cycle -- keeps each reader's effective poll rate the
        // same as before while never letting both RF fields pulse together.
        gNextRfidPollMs = millis() + (gRfid1Present && gRfid2Present ? 45 : 20);
        // --- Step 1: poll readers with short dwell (pure SPI, no HTTP) ---
        String uid1Hex;
        String uid2Hex;
        bool canPollRight = gRfid1Present;
        bool canPollLeft  = gRfid2Present;

        if (FORCE_SINGLE_RFID_STABLE_MODE && hwRfidCount == 1) {
            if (hwRfidSide == 1 && canPollRight) {
                uid1Hex = readRFIDFromReaderTestStyle(rfid1, uid1Hex, "RIGHT", nullptr);
            } else if (hwRfidSide == 0 && canPollLeft) {
                uid2Hex = readRFIDFromReaderTestStyle(rfid2, uid2Hex, "LEFT", nullptr);
            }

            if (uid1Hex.length() == 0 && uid2Hex.length() == 0 && millis() - lastRfidDiagMs >= 3000) {
                lastRfidDiagMs = millis();
                RFID_DEBUG_PRINTF("[RFID DBG] poll=ON no UID right=%d left=%d\n",
                                  gRfid1Present ? 1 : 0,
                                  gRfid2Present ? 1 : 0);
                if (gRfid1Present) {
                    uint32_t ver = rfid1.firmwareVersion();
                    bool present = rfid1.isNewCardPresent();
                    RFID_DEBUG_PRINTF("[RFID DBG] RIGHT fw=0x%08lX present=%d streak=%u\n",
                                      (unsigned long)ver, present ? 1 : 0, gRfid1TimeoutStreak);
                }
                if (gRfid2Present) {
                    uint32_t ver = rfid2.firmwareVersion();
                    bool present = rfid2.isNewCardPresent();
                    RFID_DEBUG_PRINTF("[RFID DBG] LEFT fw=0x%08lX present=%d streak=%u\n",
                                      (unsigned long)ver, present ? 1 : 0, gRfid2TimeoutStreak);
                }
            }

            if (uid1Hex.length() > 0) {
                gRfidReadOkCount++;
                gLastActivityMs = millis(); // RFID activity resets screensaver timer
                lastUIDRight = uid1Hex;
                lastUID = uid1Hex;
                lastUIDHex = uid1Hex;
                lastUID2 = "";
                lastUID2Hex = "";
                if (firstUidDetectedMs == 0) firstUidDetectedMs = millis();
                readTigerTagMetadata(rfid1, uid1Hex);
                currentOledState = OLED_STATE_UID_DETECTED;
                oledStateChangeMs = millis();
                if (wfPhase != WF_SCANNING) stopServoSearch();
                netLog("[TAG] R uid=" + uid1Hex + " mfr=" + gLastManufacturer + " mat=" + gLastMaterial);
                Serial.println("[RFID] UID1: " + uid1Hex);
                pushSessionEvent("rfid_right", "uid=" + uid1Hex, currentWeight);
                gNextRfidPollMs = millis() + 1200;
            } else if (uid2Hex.length() > 0) {
                gRfidReadOkCount++;
                gLastActivityMs = millis(); // RFID activity resets screensaver timer
                lastUIDLeft = uid2Hex;
                lastUID = uid2Hex;
                lastUIDHex = uid2Hex;
                lastUID2 = "";
                lastUID2Hex = "";
                if (firstUidDetectedMs == 0) firstUidDetectedMs = millis();
                readTigerTagMetadata(rfid2, uid2Hex);
                currentOledState = OLED_STATE_UID_DETECTED;
                oledStateChangeMs = millis();
                if (wfPhase != WF_SCANNING) stopServoSearch();
                netLog("[TAG] L uid=" + uid2Hex + " mfr=" + gLastManufacturer + " mat=" + gLastMaterial);
                Serial.println("[RFID] UID2: " + uid2Hex);
                pushSessionEvent("rfid_left", "uid=" + uid2Hex, currentWeight);
                gNextRfidPollMs = millis() + 1200;
            }
        } else {

        if (canPollRight && canPollLeft) {
            // Round-robin: the two PN532 antennas sit ~75mm apart facing each
            // other, and each isNewCardPresent() call pulses that reader's own
            // RF field. Querying both back-to-back every cycle let the fields
            // overlap in time and couple into each other (cross-detections /
            // missed reads). Polling only one per cycle keeps the fields from
            // ever pulsing simultaneously; gNextRfidPollMs above is halved to
            // compensate so each reader is still checked at the same
            // effective rate as before.
            if (gRfidPollRightNext) {
                uid1Hex = pollRFIDReader(rfid1, uid1Hex, PN532_1_SS, PN532_1_RST, "RIGHT", gRfid1TimeoutStreak);
            } else {
                uid2Hex = pollRFIDReader(rfid2, uid2Hex, PN532_2_SS, PN532_2_RST, "LEFT", gRfid2TimeoutStreak);
            }
            gRfidPollRightNext = !gRfidPollRightNext;
        } else {
            if (canPollRight) {
                uid1Hex = pollRFIDReader(rfid1, uid1Hex, PN532_1_SS, PN532_1_RST, "RIGHT", gRfid1TimeoutStreak);
            }
            if (canPollLeft) {
                uid2Hex = pollRFIDReader(rfid2, uid2Hex, PN532_2_SS, PN532_2_RST, "LEFT", gRfid2TimeoutStreak);
            }
        }

        if (uid1Hex.length() > 0 && !isLikelyTigerTagUidHex(uid1Hex)) {
            RFID_DEBUG_PRINTF("[RFID] Non-TigerTag UID1 detected: %s\n", uid1Hex.c_str());
        }
        if (uid2Hex.length() > 0 && !isLikelyTigerTagUidHex(uid2Hex)) {
            RFID_DEBUG_PRINTF("[RFID] Non-TigerTag UID2 detected: %s\n", uid2Hex.c_str());
        }

        if (uid1Hex.length() == 0 && uid2Hex.length() == 0 && millis() - lastRfidDiagMs >= 3000) {
            lastRfidDiagMs = millis();
            RFID_DEBUG_PRINTF("[RFID DBG] poll=ON no UID right=%d left=%d\n",
                              gRfid1Present ? 1 : 0,
                              gRfid2Present ? 1 : 0);
            if (gRfid1Present) {
                RFID_DEBUG_PRINTF("[RFID DBG] RIGHT timeout streak=%u\n", gRfid1TimeoutStreak);
            }
            if (gRfid2Present) {
                RFID_DEBUG_PRINTF("[RFID DBG] LEFT timeout streak=%u\n", gRfid2TimeoutStreak);
            }
        }

        // Periodic reader re-init: if no UID detected for 2 minutes and no active tag,
        // re-initialize readers to clear any stuck state.
        {
            static uint32_t lastUidSeenMs = 0;
            static uint32_t lastRfidReinitMs = 0;
            if (uid1Hex.length() > 0 || uid2Hex.length() > 0) lastUidSeenMs = millis();
            if (lastUID.length() == 0 && lastUID2.length() == 0
                && millis() - lastUidSeenMs  > 120000
                && millis() - lastRfidReinitMs > 120000) {
                lastRfidReinitMs = millis();
                Serial.println("[RFID] Periodic re-init (2 min no UID)");
                if (gRfid1Present) initPN532Reader(rfid1, PN532_1_SS, PN532_1_RST, "PN532-1");
                if (gRfid2Present) initPN532Reader(rfid2, PN532_2_SS, PN532_2_RST, "PN532-2");
            }
        }

        // Track left/right per physical reader (rfid1=Right, rfid2=Left)
        if (uid1Hex.length() > 0) lastUIDRight = uid1Hex;
        if (uid2Hex.length() > 0) lastUIDLeft  = uid2Hex;

        // Keep the "last no UID" timestamps from the previous cycle so the
        // latch logic can tell whether the card truly disappeared long enough
        // before it reappeared. Updating these too early falsely suppresses
        // valid fresh reads.
        uint32_t prevNoUid1Ms = gLastRfidNoUid1Ms;
        uint32_t prevNoUid2Ms = gLastRfidNoUid2Ms;

        if (uid1Hex.length() == 0) {
            if (gLastRfidNoUid1Ms == 0) gLastRfidNoUid1Ms = millis();
        } else {
            gLastRfidNoUid1Ms = 0;
        }
        if (uid2Hex.length() == 0) {
            if (gLastRfidNoUid2Ms == 0) gLastRfidNoUid2Ms = millis();
        } else {
            gLastRfidNoUid2Ms = 0;
        }
        if (uid1Hex.length() > 0 || uid2Hex.length() > 0) {
            gNextRfidPollMs = millis() + 1200;
        }

        bool dupUid1 = isDuplicateRecentUid(uid1Hex, gLastRfidUid1, gLastRfidUid1Ms);
        bool dupUid2 = isDuplicateRecentUid(uid2Hex, gLastRfidUid2, gLastRfidUid2Ms);
        bool latchedUid1 = isUidLatched(uid1Hex, gLastRfidUid1, prevNoUid1Ms);
        bool latchedUid2 = isUidLatched(uid2Hex, gLastRfidUid2, prevNoUid2Ms);
        if (uid1Hex.length() > 0 && !dupUid1) {
            gLastRfidUid1 = uid1Hex;
            gLastRfidUid1Ms = millis();
        }
        if (uid2Hex.length() > 0 && !dupUid2) {
            gLastRfidUid2 = uid2Hex;
            gLastRfidUid2Ms = millis();
        }

        // --- Step 2: store new UIDs ---
        bool newUid1 = uid1Hex.length() > 0 && !dupUid1 && !latchedUid1 && uid1Hex != lastUID && uid1Hex != lastUID2;
        bool newUid2 = uid2Hex.length() > 0 && !dupUid2 && !latchedUid2 && uid2Hex != lastUID && uid2Hex != lastUID2;

        if (uid1Hex.length() > 0 && !newUid1) {
            RFID_DEBUG_PRINTF("[RFID DBG] RIGHT suppressed dup=%d latched=%d same1=%d same2=%d lastUID=%s lastUID2=%s\n",
                              dupUid1 ? 1 : 0,
                              latchedUid1 ? 1 : 0,
                              uid1Hex == lastUID ? 1 : 0,
                              uid1Hex == lastUID2 ? 1 : 0,
                              lastUID.c_str(),
                              lastUID2.c_str());
            finishRfidSession(rfid1);
        }
        if (uid2Hex.length() > 0 && !newUid2) {
            RFID_DEBUG_PRINTF("[RFID DBG] LEFT suppressed dup=%d latched=%d same1=%d same2=%d lastUID=%s lastUID2=%s\n",
                              dupUid2 ? 1 : 0,
                              latchedUid2 ? 1 : 0,
                              uid2Hex == lastUID ? 1 : 0,
                              uid2Hex == lastUID2 ? 1 : 0,
                              lastUID.c_str(),
                              lastUID2.c_str());
            finishRfidSession(rfid2);
        }

        if (newUid1) {
            bool uid1IsRemovalEcho = (uid1Hex == gRecentlyRemovedUid1 || uid1Hex == gRecentlyRemovedUid2)
                                     && (millis() - gRemovalDetectedMs < RFID_REMOVAL_BEEP_SUPPRESS_MS);
            // Suppress the detection beep when the scale reads near-zero weight:
            // during physical tag removal the same chip can still flicker back
            // into range for a moment and looks like a fresh detection, but
            // there's nothing genuinely being placed on the scale at that point.
            // Also suppress if this exact UID was just cleared by a removal
            // reset: blocking Firebase/cloud HTTPS calls can stall loop() long
            // enough that weight hasn't fully decayed yet when the same tag's
            // echo read arrives (see gRecentlyRemovedUid1/2 declaration).
            if (currentWeight >= MIN_WEIGHT_TO_SEND_G && !uid1IsRemovalEcho) playSoundTheme();
            gRfidReadOkCount++;
            readTigerTagMetadata(rfid1, uid1Hex);
            // If right reader failed metadata, try fresh poll on left reader for twin chip
            if (gLastManufacturer == "--" && gLastMaterial == "--" && gRfid2Present) {
                Serial.println("[META] Right failed, fresh poll on left reader for twin chip");
                String rfid2UidOut;
                bool rfid2Fail = false;
                String foundUid = readRFIDFromReaderTestStyle(rfid2, rfid2UidOut, "LEFT_FB", &rfid2Fail);
                if (foundUid.length() > 0) {
                    Serial.printf("[META] Left reader found uid=%s, reading metadata\n", foundUid.c_str());
                    readTigerTagMetadata(rfid2, foundUid);
                } else {
                    Serial.println("[META] Left reader found no card in field");
                }
            }
            if (lastUID.length() == 0) {
                lastUID = uid1Hex; lastUIDHex = uid1Hex;
                if (firstUidDetectedMs == 0) firstUidDetectedMs = millis();
            } else {
                lastUID2 = uid1Hex; lastUID2Hex = uid1Hex;
            }
            currentOledState = OLED_STATE_UID_DETECTED;
            oledStateChangeMs = millis();
            if (wfPhase != WF_SCANNING) stopServoSearch();  // Don't interrupt scan window
            Serial.printf("[TAG] uid=%s -> Fab=%s Mat=%s Col=%s\n",
                          uid1Hex.c_str(), gLastManufacturer.c_str(), gLastMaterial.c_str(), gLastColor.c_str());
            Serial.println("[RFID] UID1: " + uid1Hex);
            // Force immediate display update so brand/material appear without waiting for WS tick
            displayWeightWithState(currentWeight, lastUID, currentOledState);
            pushSessionEvent("rfid_right", "uid=" + uid1Hex, currentWeight);
        }

        if (newUid2) {
            bool uid2IsRemovalEcho = (uid2Hex == gRecentlyRemovedUid1 || uid2Hex == gRecentlyRemovedUid2)
                                     && (millis() - gRemovalDetectedMs < RFID_REMOVAL_BEEP_SUPPRESS_MS);
            // See newUid1 above: suppress the beep for a near-zero-weight flicker
            // read, or for a delayed echo of a UID just cleared by removal.
            if (currentWeight >= MIN_WEIGHT_TO_SEND_G && !uid2IsRemovalEcho) playSoundTheme();
            gRfidReadOkCount++;
            readTigerTagMetadata(rfid2, uid2Hex);
            // If left reader failed metadata, try right reader as fallback.
            // After finishRfidSession the card is HALTed — rfid1 can still
            // wake it with WUPA if the card is within its RF field.
            if (gLastManufacturer == "--" && gLastMaterial == "--" && gRfid1Present) {
                // Left reader couldn't read block 5 (sc=3 timeout or sc=1 CRC fail).
                // Fresh poll on rfid1 — the card's RIGHT-side chip may be within rfid1's
                // field even when the spool is placed left-side-down.
                Serial.println("[META] Left failed, fresh poll on right reader for twin chip");
                String rfid1UidOut;
                bool rfid1Fail = false;
                String foundUid = readRFIDFromReaderTestStyle(rfid1, rfid1UidOut, "RIGHT_FB", &rfid1Fail);
                if (foundUid.length() > 0) {
                    Serial.printf("[META] Right reader found uid=%s, reading metadata\n", foundUid.c_str());
                    readTigerTagMetadata(rfid1, foundUid);
                } else {
                    Serial.println("[META] Right reader found no card in field");
                }
            }
            if (lastUID.length() == 0) {
                lastUID = uid2Hex; lastUIDHex = uid2Hex;
                lastUID2 = ""; lastUID2Hex = "";
                if (firstUidDetectedMs == 0) firstUidDetectedMs = millis();
            } else {
                lastUID2 = uid2Hex; lastUID2Hex = uid2Hex;
            }
            currentOledState = OLED_STATE_UID_DETECTED;
            oledStateChangeMs = millis();
            if (wfPhase != WF_SCANNING) stopServoSearch();  // Don't interrupt scan window
            Serial.printf("[TAG] uid=%s -> Fab=%s Mat=%s Col=%s\n",
                          uid2Hex.c_str(), gLastManufacturer.c_str(), gLastMaterial.c_str(), gLastColor.c_str());
            Serial.println("[RFID] UID2: " + uid2Hex);
            // Force immediate display update so brand/material appear without waiting for WS tick
            displayWeightWithState(currentWeight, lastUID, currentOledState);
            pushSessionEvent("rfid_left", "uid=" + uid2Hex, currentWeight);
        }

        #if ENABLE_LEGACY_API_BRIDGE
        // --- Step 3: HTTP metadata fetch from legacy cloud function ---
        if (newUid1) fetchMetaFromApiByUid(uid1Hex);
        if (newUid2 && uid2Hex != uid1Hex) fetchMetaFromApiByUid(uid2Hex);
        #endif
        }
    }

    // -- RFID hardware test mode ----------------------------------------------
    // When active, poll both readers simultaneously and store raw UIDs for the
    // web UI.  Bypasses the normal flow guards; accepts any UID length.
    if (rfidTestActive) {
        if (!rfidAntennasOn) rfidAntennaSetAll(true);
        bool doLeft  = gRfid2Present && ((hwRfidCount >= 2) || (hwRfidSide == 0));
        bool doRight = gRfid1Present && ((hwRfidCount >= 2) || (hwRfidSide == 1));
        if (doLeft) {
            String hexL;
            readRFIDUidOnly(rfid2, hexL);   // rfid2 = physically Left
            if (hexL.length() > 0) {
                rfidTestLastUidLeft = hexL;
                Serial.printf("[RFID TEST] Left uid=%s\n", hexL.c_str());
            }
        }
        if (doRight) {
            String hexR;
            readRFIDUidOnly(rfid1, hexR);   // rfid1 = physically Right
            if (hexR.length() > 0) {
                rfidTestLastUidRight = hexR;
                Serial.printf("[RFID TEST] Right uid=%s\n", hexR.c_str());
            }
        }
    }

    if (!DEBUG_RFID
        && gPostFirebaseStabilized
        && millis() >= gIdleHeartbeatMs
        && wfPhase == WF_IDLE
        && !autoTarePending) {
        gIdleHeartbeatMs = millis() + 15000;
        Serial.printf("[IDLE] waiting tag/weight wifi=%d firebase=%d readers=%u scale=%.2fg\n",
                      WiFi.isConnected() ? 1 : 0,
                      firebaseAuth ? 1 : 0,
                      hwRfidCount,
                      currentWeight);
    }

    if (gPostFirebaseStabilized && millis() - lastAliveLogMs >= 5000) {
        lastAliveLogMs = millis();
        Serial.printf("[ALIVE] up=%lus heap=%u min=%u wifi=%d firebase=%d wf=%d hx=%d weight=%.2f\n",
                      millis() / 1000UL,
                      ESP.getFreeHeap(),
                      ESP.getMinFreeHeap(),
                      WiFi.isConnected() ? 1 : 0,
                      firebaseAuth ? 1 : 0,
                      (int)wfPhase,
                      gHx711Online ? 1 : 0,
                      currentWeight);
    }

    // Event push disabled — Firestore rules don't allow writes to scales/{mac}/events/
    if (gEventPushPending) gEventPushPending = false;

    bool isolateSingleRfidRead = false;

    float weight = currentWeight;
    if (!isolateSingleRfidRead) {
        weight = readWeight();
    } else {
        static uint32_t lastRfidOnlyDiagMs = 0;
        if (millis() - lastRfidOnlyDiagMs >= 3000) {
            lastRfidOnlyDiagMs = millis();
            Serial.println("[RFID] HX711 polling paused during single-reader scan");
        }
    }
    // Immediate auto-tare-on-negative-weight was removed here (2026-07-19):
    // placing an item can cause a brief but LARGE mechanical undershoot (seen
    // on the bench: raw dipping to -270g for the debounce window's full
    // 250ms during a firmer placement) that this handler was still able to
    // catch. Taring off that transient locks the scale's new "zero" onto the
    // item's true resting weight (since the item was already on the platform
    // when tare() ran) -- the display then reads ~0g for as long as the item
    // stays put, which read as "the scale doesn't react when I place
    // something." The existing, more conservative "Negative-drift auto-tare"
    // block below (1s sustained + idle/empty + 10s cooldown) is the sole
    // handler for genuine negative drift now -- it already requires far
    // longer sustained negative readings than any placement/removal
    // transient produces.
    if (weight < 0.0f) weight = 0.0f;

    if (!isolateSingleRfidRead) {
        // Auto-tare logic:
        // 1. If weight is locked after send AND weight is low (< 50g): trigger auto-tare
        // 2. Also trigger if no RFID is detected AND weight drops to near-zero (< 5g)
        // This allows scale to go back to 0 before weighing again

        // Case 1: Servo locked after weight sent (normal flow)
        if (servoLockedUntilAutotare && !autoTarePending && weight < 50.0f) {
            // Weight is in low range and servo is locked - start auto-tare
            autoTarePending = true;
            autoTareStartedMs = millis();  // Track when auto-tare started
            Serial.printf("[AUTOTARE] Activated (servo locked, weight=%.2f g)\n", weight);
        }

        // Case 2: No RFID detected AND weight is very low (< 5g) - auto-tare anyway
        // Anti-loop: trigger once, then wait until weight leaves near-zero band before rearming.
        if (!servoLockedUntilAutotare && !autoTarePending && lastUID.length() == 0) {
            const float IDLE_AUTOTARE_TRIGGER_G = 5.0f;
            const float IDLE_AUTOTARE_REARM_G   = 12.0f;
            const uint32_t IDLE_AUTOTARE_COOLDOWN_MS = 5000;

            if (weight > IDLE_AUTOTARE_REARM_G) {
                idleAutoTareArmed = true;
            }

            bool cooldownOk = (millis() - lastIdleAutoTareMs) > IDLE_AUTOTARE_COOLDOWN_MS;
            if (idleAutoTareArmed && cooldownOk && weight < IDLE_AUTOTARE_TRIGGER_G) {
                autoTarePending = true;
                autoTareStartedMs = millis();
                idleAutoTareArmed = false;
                lastIdleAutoTareMs = millis();
                Serial.printf("[AUTOTARE] Activated (no RFID, weight=%.2f g)\n", weight);
            }
        }
    }

    // -- Negative-drift auto-tare ---------------------------------------------
    // If weight stays below 0g for NEG_DRIFT_TARE_DELAY_MS (1s) while idle with
    // no load/RFID, the tare point has drifted. Correct immediately without
    // waiting for processAutoTare stability — the weight is already stable.
    {
        static uint32_t negWeightSinceMs  = 0;
        static uint32_t lastNegTareMs     = 0;
        bool idleAndEmpty = (wfPhase == WF_IDLE && lastUID.length() == 0 && !autoTarePending);
        if (idleAndEmpty && weight < 0.0f) {
            if (negWeightSinceMs == 0) negWeightSinceMs = millis();
            bool cooldownOk = (millis() - lastNegTareMs) > NEG_DRIFT_TARE_COOLDOWN_MS;
            if (cooldownOk && (millis() - negWeightSinceMs) >= NEG_DRIFT_TARE_DELAY_MS) {
                scale.tare();
                currentWeight = 0.0f;
                resetWeightFilters();
                lastNegTareMs    = millis();
                negWeightSinceMs = 0;
                netLog("AUTOTARE neg-drift=" + String(weight, 1) + "g corrected");
                Serial.printf("[AUTOTARE] Negative drift %.2fg corrected\n", weight);
            }
        } else {
            negWeightSinceMs = 0;  // reset timer when weight goes back positive
        }
    }

    // Safety timeout: unlock servo if auto-tare takes too long (10 seconds)
    if (!isolateSingleRfidRead && autoTarePending && autoTareStartedMs > 0 && millis() - autoTareStartedMs > AUTO_TARE_TIMEOUT_MS) {
        Serial.printf("[AUTOTARE] TIMEOUT - Force unlock servo after %.0f seconds\n", (millis() - autoTareStartedMs) / 1000.0f);
        autoTarePending = false;
        servoLockedUntilAutotare = false;
        autoTareStableSinceMs = 0;
        autoTareStartedMs = 0;
    }

    if (!isolateSingleRfidRead) {
        if (autoTarePending) {
            processAutoTare(weight);
        } else {
            updateServoWorkflow(weight);
        }
    }

    // Failsafe: if cycle is locked while weight stays low for some time, force reset.
    // This avoids getting stuck because of residual/noisy grams.
    bool lockedCycle = (rfidLockedForCurrentLoad || servoLockedUntilAutotare || servoHoldAfterRemoval || autoTarePending);
    const float LOW_WEIGHT_UNLOCK_G = 18.0f;
    const uint32_t LOW_WEIGHT_UNLOCK_MS = 6000;

    if (!isolateSingleRfidRead && lockedCycle && fabs(weight) <= LOW_WEIGHT_UNLOCK_G) {
        if (lowWeightSinceMs == 0) lowWeightSinceMs = millis();
        if (millis() - lowWeightSinceMs >= LOW_WEIGHT_UNLOCK_MS) {
            autoTarePending = false;
            autoTareStableSinceMs = 0;
            autoTareStartedMs = 0;
            rfidLockedForCurrentLoad = false;
            servoLockedUntilAutotare = false;
            servoHoldAfterRemoval = false;
            idleAutoTareArmed = true;
            lowWeightSinceMs = 0;
            gLastSentWeight = NAN;
            gLastCloudWeight = NAN;
            gCloudWeightSetMs = 0;
            firstUidDetectedMs = 0;
            firstUidPauseUntilMs = 0;
            lastUID = ""; lastUID2 = ""; lastUIDHex = ""; lastUID2Hex = "";
            lastUIDLeft = ""; lastUIDRight = ""; lastUIDTwin = ""; gTwinFetchDone = false; gTwinFetchPending = false; gTwinFetchUID = ""; gTwinFetchResult = "";
            gLastRfidUid1 = ""; gLastRfidUid2 = ""; gLastRfidUid1Ms = 0; gLastRfidUid2Ms = 0; gLastRfidNoUid1Ms = 0; gLastRfidNoUid2Ms = 0;
            wfPhase = WF_IDLE;
            wfContainerWeight = 0.0f; wfContainerFetched = false;
            currentOledState = OLED_STATE_IDLE;
            gProductImgReady = false; gLastProductId = 0xFFFFFFFF;
            gLastManufacturer = "--"; gLastMaterial = "--"; gLastColor = "--";
            gLastContainer = 0.0f;
            gLastRackPosition = ""; gLastRackName = ""; gLastLevel = -1; gLastPosition = -1; gLastRackId = "";
            Serial.println("[CYCLE] Forced unlock after low-weight timeout");
        }
    } else {
        lowWeightSinceMs = 0;
    }

    // Detect spool removal by comparing to last sent weight
    if (!isolateSingleRfidRead && !isnan(gLastSentWeight) && fabs(weight - gLastSentWeight) > MIN_WEIGHT_CHANGE_TO_RESET_G) {
        Serial.printf("[REMOVAL] Sent: %.2f, Now: %.2f\n", gLastSentWeight, weight);
        gLastSentWeight = NAN; gLastCloudWeight = NAN; gCloudWeightSetMs = 0;
        lastUID = ""; lastUID2 = ""; lastUIDHex = ""; lastUID2Hex = "";
        lastUIDLeft = ""; lastUIDRight = ""; lastUIDTwin = ""; gTwinFetchDone = false; gTwinFetchPending = false; gTwinFetchUID = ""; gTwinFetchResult = "";
        gLastRfidUid1 = ""; gLastRfidUid2 = ""; gLastRfidUid1Ms = 0; gLastRfidUid2Ms = 0; gLastRfidNoUid1Ms = 0; gLastRfidNoUid2Ms = 0;
        firstUidDetectedMs = 0; firstUidPauseUntilMs = 0;
        rfidLockedForCurrentLoad = true;   // Keep RFID locked during removal hold
        servoLockedUntilAutotare = false;  // CRITICAL: unlock servo for next measurement
        servoHoldAfterRemoval = true;      // Keep servo stopped until weight returns to empty
        autoTarePending = false;            // Cancel any pending auto-tare
        autoTareStableSinceMs = 0;          // Reset auto-tare timer
        autoTareStartedMs = 0;              // Reset auto-tare start time
        currentOledState = OLED_STATE_IDLE;
        gProductImgReady = false; gLastProductId = 0xFFFFFFFF;
        // Only clear inventory display data when weight is truly low (spool removed).
        // If weight is still substantial, the spool is still on the scale — keep the info visible.
        if (weight < SPOOL_REMOVED_WEIGHT_G) {
            gLastManufacturer = "--"; gLastMaterial = "--"; gLastColor = "--";
            gLastContainer = 0.0f;
            gLastRackPosition = ""; gLastRackName = ""; gLastLevel = -1; gLastPosition = -1; gLastRackId = "";
        }
        Serial.printf("[SERVO] Spool removal detected - hold active until empty scale\n");
    }

    // Run workflow BEFORE building the WS frame so the frame always reflects
    // the post-workflow state (cleared UIDs, reset phase, etc.)
    if (!autoTarePending && !isolateSingleRfidRead) handleWeighWorkflow(weight);

    if (millis() - lastUpdate > WS_UPDATE_INTERVAL_MS) {
        uint32_t now = millis();

        if (sendPhase == "countdown" && currentOledState != OLED_STATE_SENDING) {
            currentOledState = OLED_STATE_SENDING; oledStateChangeMs = now;
        }
        bool keepInfoOnScreen = (fabs(weight) >= MIN_WEIGHT_TO_SEND_G) &&
                                (lastUID.length() > 0 || gLastManufacturer != "--" || gLastMaterial != "--" || gLastColor != "--" || gLastRackPosition.length() > 0);

        // UID_DETECTED ("A pesar...") doesn't need the OLED_MESSAGE_DURATION_MS
        // minimum hold that SUCCESS/ERROR banners get (those are messages the
        // user should have time to read even if they react instantly) -- once
        // the scale confirms the item is actually gone (weight below
        // threshold), snap back to Ready immediately instead of leaving a
        // stale "A pesar..." on screen for up to 2s after removal.
        bool holdExpired = (currentOledState == OLED_STATE_UID_DETECTED)
                          ? (fabs(weight) < MIN_WEIGHT_TO_SEND_G)
                          : (now - oledStateChangeMs > OLED_MESSAGE_DURATION_MS);
        if (!keepInfoOnScreen &&
            (currentOledState == OLED_STATE_UID_DETECTED ||
             currentOledState == OLED_STATE_SUCCESS ||
             currentOledState == OLED_STATE_ERROR) &&
            holdExpired) {
            currentOledState = (sendPhase == "countdown") ? OLED_STATE_SENDING : OLED_STATE_IDLE;
        }
        if (sendPhase == "send" && currentOledState != OLED_STATE_SENDING) {
            currentOledState = OLED_STATE_SENDING; oledStateChangeMs = now;
        }

        // Screensaver: activates after 5 minutes of inactivity
        if (millis() - gLastActivityMs > 300000UL) {
            runScreensaver();
            // Screensaver draws directly on the canvas, bypassing LVGL -- same
            // fix as lvglSettingsBtnEvent(), otherwise LVGL has no "dirty" area
            // to repaint and the last bounced frame stays on screen as residue.
            if (gUseLvglMainScreen && lvScreen != nullptr) lv_obj_invalidate(lvScreen);
            gLastActivityMs = millis();
        }

        #if !RFID_DIAG_DISABLE_DISPLAY_REFRESH
        displayWeightWithState(weight, lastUID, currentOledState);
        #endif

        // Check touch on WiFi / Firebase buttons (bottom-right corner)
        // LVGL main screen (2026-07-28): tare/settings taps are now handled by
        // lvglTareBtnEvent()/lvglSettingsBtnEvent() via the LVGL indev driver.
        // Keep this block only as the fallback path for gUseLvglMainScreen=false,
        // otherwise it would double-handle every tap alongside the LVGL buttons.
        if (!gUseLvglMainScreen)
        {
            static uint32_t lastBtnCheckMs   = 0;
            static uint32_t ignoreUntilMs    = 0;  // absolute time — buttons blocked until then

            // Helper: drain all residual touches and block buttons for ms milliseconds.
            // Must be called AFTER returning from a full-screen sub-UI (keyboard, menu, etc.)
            // to prevent the last tap from leaking into the button handler.
            auto drainAndBlock = [&](uint32_t blockMs) {
                int16_t a, b;
                uint32_t t0 = millis();
                // Wait until no touch for 4 consecutive reads (≈48 ms)
                int noCount = 0;
                while (millis() - t0 < 800) {
                    if (!tsRead(a, b)) { if (++noCount >= 4) break; } else noCount = 0;
                    delay(12);
                }
                ignoreUntilMs = millis() + blockMs;
            };

            if (millis() - lastBtnCheckMs > 120 && millis() >= ignoreUntilMs) {
                lastBtnCheckMs = millis();
                int16_t tx, ty;
                if (tsRead(tx, ty)) {
                    gLastActivityMs = millis(); // any touch resets screensaver timer
                    // Tare button: x=220-350, y=248-320
                    if (tx >= 220 && tx <= 350 && ty >= 248 && ty <= 320) {
                        Serial.println("[BTN] Tare button tapped");
                        scale.tare();
                        autoTarePending = false;
                        autoTareStableSinceMs = 0;
                        float offset = scale.get_offset();
                        prefs.begin("config", false);
                        prefs.putFloat("tareFactor", offset);
                        prefs.end();
                        Serial.printf("[TARE] Manual tare saved: %f\n", offset);
                        gfx->fillScreen(DARK_BG);
                        gfx->setTextColor(0x07E0); gfx->setTextSize(3);
                        gfx->setCursor(120, 130);
                        gfx->print(t(I18N_TARE_OK));
                        gfx->setTextColor(0x6B4D); gfx->setTextSize(1);
                        gfx->setCursor(120, 170); gfx->print("0.00 g");
                        gfx->flush();
                        delay(800);
                        drainAndBlock(500);
                        displayWeightWithState(weight, lastUID, currentOledState);
                    }
                    // Settings button: x=358-472, y=248-320
                    else if (tx >= 358 && tx <= 472 && ty >= 248 && ty <= 320) {
                        Serial.println("[BTN] Settings button tapped");
                        runSettingsMenu();
                        drainAndBlock(500);
                        displayWeightWithState(weight, lastUID, currentOledState);
                    }
                }
            }
        }

        // Unified WS frame — same tick as OLED, contains ALL fields the web UI needs.
        // No separate HTTP polling required on the client side.
        // NOTE: handleWeighWorkflow() runs BEFORE this block so the frame always
        //       reflects the post-workflow state (cleared UIDs, updated phase, etc.)
        { String frame = buildWsFrame(weight); if (frame.length()) ws.textAll(frame); }
        if (!USE_SYNC_WEBSERVER && !MINIMAL_HTTP_DIAG) {
            ws.cleanupClients();
        }
        lastUpdate = millis();
    }

    delay(10);
}
