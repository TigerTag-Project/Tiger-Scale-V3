// Thin wrapper around Adafruit_PN532 exposing the same call pattern the rest
// of the firmware used against MFRC522 (isNewCardPresent/readCardSerial/uid/
// antennaOn-Off/halt) so the poll loop and metadata code stay unchanged.
// PN532's readPassiveTargetID() already does REQA+anticollision+select in one
// shot, so isNewCardPresent() runs it and caches the UID; readCardSerial()
// just hands back the cached result.
//
// Three transports share this exact public API (selected by
// RFID_TRANSPORT_HSU / RFID_TRANSPORT_I2C, set in platformio.ini): the
// default is SPI over the header pins, 2 readers; esp32s3_hsu wires the
// module's HSU pins straight to two ESP32 HardwareSerial ports, 2 readers;
// esp32s3_i2c wires ONE module onto Wire1 (the PN532's I2C address is fixed,
// so 2 would collide). A fourth, USB-host transport was attempted and is a
// confirmed hardware dead end -- docs/USB_HOST_POSTMORTEM.md.
// setupRFID()/rfidSelectReader()/pollRFIDReader()/etc. below only ever call
// this class's public methods, so none of that code needed to change across
// any of these transports.

// RF power/sensitivity presets, selectable live from the Hardware/RFID Test
// screen (the level stepper) while tuning the two-readers-facing-each-other-
// at-75mm cross-talk issue -- no recompile/reflash needed to try a different
// level. GsNOn/CWGsP/ModGsP are TX driver conductance (N- and P-channel,
// continuous-wave/idle and modulation states) -- mapping cross-checked
// against this project's own pre-PN532 MFRC522 code, which used the same
// CIU transceiver core/register map (GsNReg/CWGsPReg = 0xFF/0x3F there for
// MAXIMUM gain, so smaller values here are those same fields at lower drive).
//
// 2026-07-16 (2nd pass): the original 0-4 range spanned all the way to full
// datasheet TX drive, but that upper half was never useful for this
// setup -- narrowed to 5 finer steps between just the original level 0
// (floor: TX ~off, least sensitive) and level 1 (TX still very low, one
// step more sensitive), linearly interpolated. The old levels 2-4 (up to
// full datasheet TX drive) are gone; if more range is ever needed above the
// current index 4, re-derive from the deleted values in WORKLOG.md history.
struct PN532RfLevel { uint8_t gsNOn, cwGsP, modGsP, rxThresholdMinLevel; };
static const PN532RfLevel PN532_RF_LEVELS[] = {
    { 0x00, 0x00, 0x00, 0xF }, // 0: floor -- TX ~off, least sensitive
    { 0x10, 0x04, 0x01, 0xE },
    { 0x20, 0x08, 0x02, 0xD },
    { 0x30, 0x0C, 0x03, 0xC },
    { 0x40, 0x10, 0x04, 0xB }, // 4: former level 1 endpoint
};
static const uint8_t PN532_RF_LEVEL_COUNT = sizeof(PN532_RF_LEVELS) / sizeof(PN532_RF_LEVELS[0]);
uint8_t gRfidPowerLevel = 3; // index into PN532_RF_LEVELS, adjustable live from the Hardware/RFID Test screen

// Sent through Adafruit_PN532's public sendCommandCheckAck(), no library
// patch needed. Baseline payload byte-for-byte confirmed against dotnet/
// iot's Pn532 bindings (Microsoft-maintained, matches the PN532 datasheet
// reset values); RFCfg (RxGain, bits 6:4) is left at that datasheet default
// (0x59) at every level -- another lever to pull later if levels 0-4 aren't
// enough on their own.
static void applyPN532RfTuning(Adafruit_PN532 &pn532, uint8_t level) {
    if (level >= PN532_RF_LEVEL_COUNT) level = PN532_RF_LEVEL_COUNT - 1;
    const PN532RfLevel &lv = PN532_RF_LEVELS[level];
    uint8_t cmd[13] = {
        PN532_COMMAND_RFCONFIGURATION,
        0x0A, // CfgItem: analog settings, 106 kbps type A (reader mode)
        0x59, // RFCfg (RxGain) -- untouched, datasheet default
        lv.gsNOn,
        lv.cwGsP,
        lv.modGsP,
        0x4D, // DemodWhenRfOn
        (uint8_t)((lv.rxThresholdMinLevel << 4) | 0x5), // RxThreshold: MinLevel | CollLevel=0x5
        0x61, // DemodWhenRfOff
        0x6F, // GsNOff
        0x26, // ModWidth
        0x62, // MifNFC
        0x87, // TxBitPhase
    };
    if (!pn532.sendCommandCheckAck(cmd, sizeof(cmd))) {
        Serial.printf("[RFID] RF tuning level %u: no ACK (kept previous config)\n", level);
    }
}

#if RFID_TRANSPORT_HSU

// PN532 wired directly to two ESP32 HardwareSerial ports (Serial1/Serial2)
// via its HSU pins -- no SPI bus sharing, no USB Host. Set the module's
// mode switch to HSU (see CLAUDE.md) before flashing this env.
class PN532Reader {
public:
    struct Uid { uint8_t size = 0; uint8_t uidByte[10] = {0}; } uid;

    PN532Reader(uint8_t resetPin, HardwareSerial &serial, int8_t rxPin, int8_t txPin)
        : _pn532(resetPin, &serial), _serial(serial), _rxPin(rxPin), _txPin(txPin) {}

    bool init() {
        // Adafruit_PN532::begin() re-calls serial->begin(115200) with no
        // pins of its own; the ESP32 core's HardwareSerial remembers the
        // last-configured pins when none are given, so this explicit call
        // has to run first to actually land on _rxPin/_txPin.
        _serial.begin(115200, SERIAL_8N1, _rxPin, _txPin);
        _pn532.begin();
        if (_pn532.getFirmwareVersion() == 0) return false;
        _pn532.SAMConfig();
        applyPN532RfTuning(_pn532, gRfidPowerLevel);
        _pn532.setPassiveActivationRetries(1);
        return true;
    }

    uint32_t firmwareVersion() { return _pn532.getFirmwareVersion(); }

    bool isNewCardPresent() {
        uint8_t len = 0;
        bool ok = _pn532.readPassiveTargetID(PN532_MIFARE_ISO14443A, uid.uidByte, &len, 30);
        if (ok) uid.size = len;
        _pendingUid = ok;
        return ok;
    }

    bool readCardSerial() {
        bool ok = _pendingUid;
        _pendingUid = false;
        return ok;
    }

    void haltA() {}
    void stopCrypto1() {}
    void antennaOn()  { _fieldOn = true; }
    void antennaOff() { _fieldOn = false; }
    // Re-applies RF power/sensitivity live (no re-init needed) -- used by
    // the Hardware/RFID Test screen's "Pot:" stepper.
    void applyRfPower(uint8_t level) { applyPN532RfTuning(_pn532, level); }
    bool antennaIsOn() const { return _fieldOn; }

    bool readPages16(uint8_t page, uint8_t *out16) {
        for (uint8_t i = 0; i < 4; i++) {
            if (!_pn532.mifareultralight_ReadPage(page + i, out16 + (i * 4))) return false;
        }
        return true;
    }

private:
    Adafruit_PN532 _pn532;
    HardwareSerial &_serial;
    int8_t _rxPin, _txPin;
    bool _pendingUid = false;
    bool _fieldOn = true;
};

PN532Reader rfid1(PN532_1_RST, Serial1, PN532_1_RXD, PN532_1_TXD);
PN532Reader rfid2(PN532_2_RST, Serial2, PN532_2_RXD, PN532_2_TXD);

#elif RFID_TRANSPORT_I2C

// PN532 on `Wire1` (SDA=GPIO8, SCL=GPIO7) -- NOT the plain `Wire` bus.
// `Wire`'s documented pins (I2C_SDA=21, I2C_SCL=22) are wrong on ESP32-S3:
// GPIO22 doesn't physically exist on this chip (S3 skips 22-25 entirely),
// and GPIO21 is wired to the camera connector (CAM_D7) on this board, not
// I2C. Every boot log confirms this ("Invalid pin: 22", "0 device(s)
// found") -- a pre-existing bug inherited from V4, unrelated to PN532.
// Wire1 is the bus that's actually wired and working (touch @0x3B,
// AXP2101 @0x34, ES8311 codec @0x18) -- PN532 @0x24 doesn't collide.
//
// Single reader only: the PN532's I2C address is fixed (0x24), so a second
// module on the same bus would collide -- only the first-constructed
// instance (rfid1) is live; rfid2 always reports absent, same pattern as
// the USB build's single-reader PoC.
class PN532Reader {
public:
    struct Uid { uint8_t size = 0; uint8_t uidByte[10] = {0}; } uid;

    PN532Reader(uint8_t resetPin, uint8_t irqPin)
        : _pn532(irqPin, resetPin, &Wire1), _isPrimary(!_primaryClaimed) {
        if (_isPrimary) _primaryClaimed = true;
    }

    bool init() {
        if (!_isPrimary) return false;
        _pn532.begin();
        if (_pn532.getFirmwareVersion() == 0) return false;
        _pn532.SAMConfig();
        applyPN532RfTuning(_pn532, gRfidPowerLevel);
        _pn532.setPassiveActivationRetries(1);
        return true;
    }

    uint32_t firmwareVersion() { return _isPrimary ? _pn532.getFirmwareVersion() : 0; }

    bool isNewCardPresent() {
        if (!_isPrimary) return false;
        uint8_t len = 0;
        bool ok = _pn532.readPassiveTargetID(PN532_MIFARE_ISO14443A, uid.uidByte, &len, 30);
        if (ok) uid.size = len;
        _pendingUid = ok;
        return ok;
    }

    bool readCardSerial() {
        bool ok = _pendingUid;
        _pendingUid = false;
        return ok;
    }

    void haltA() {}
    void stopCrypto1() {}
    void antennaOn()  { _fieldOn = true; }
    void antennaOff() { _fieldOn = false; }
    // Re-applies RF power/sensitivity live (no re-init needed) -- used by
    // the Hardware/RFID Test screen's "Pot:" stepper.
    void applyRfPower(uint8_t level) { applyPN532RfTuning(_pn532, level); }
    bool antennaIsOn() const { return _fieldOn; }

    bool readPages16(uint8_t page, uint8_t *out16) {
        if (!_isPrimary) return false;
        for (uint8_t i = 0; i < 4; i++) {
            if (!_pn532.mifareultralight_ReadPage(page + i, out16 + (i * 4))) return false;
        }
        return true;
    }

private:
    Adafruit_PN532 _pn532;
    bool _isPrimary;
    bool _pendingUid = false;
    bool _fieldOn = true;
    static bool _primaryClaimed;
};
bool PN532Reader::_primaryClaimed = false;

PN532Reader rfid1(PN532_1_RST, PN532_1_IRQ);
PN532Reader rfid2(PN532_2_RST, PN532_2_IRQ);

