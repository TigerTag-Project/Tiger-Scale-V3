    lv_obj_t *pill2 = lv_btn_create(scr);
    lv_obj_set_size(pill2, 44, 44);
    lv_obj_align(pill2, LV_ALIGN_TOP_RIGHT, -6, 52);
    lv_obj_set_style_radius(pill2, 22, 0);
    lv_obj_set_style_border_width(pill2, 1, 0);
    lv_obj_set_style_border_color(pill2, LVCOL_BORDER, 0);
    lv_obj_set_style_shadow_width(pill2, 0, 0);
    lv_obj_set_user_data(pill2, (void *)(intptr_t)HA_PILL2);
    lv_obj_add_event_cb(pill2, actionCb, LV_EVENT_CLICKED, nullptr);
    lv_obj_t *pill2Lbl = lv_label_create(pill2);
    lv_label_set_text(pill2Lbl, "2");
    lv_obj_set_style_text_color(pill2Lbl, LVCOL_TEXT, 0);
    lv_obj_set_style_text_font(pill2Lbl, &lv_font_montserrat_16, 0);
    lv_obj_center(pill2Lbl);

    // UID boxes, side by side, centered vertically between the top controls
    // and the Scan button
    lv_obj_t *box1 = lv_obj_create(scr);
    lv_obj_remove_style_all(box1);
    lv_obj_set_size(box1, 228, 64);
    lv_obj_set_pos(box1, 6, 137);
    lv_obj_set_style_bg_color(box1, LVCOL_CARD, 0);
    lv_obj_set_style_bg_opa(box1, LV_OPA_COVER, 0);
    lv_obj_set_style_border_color(box1, LVCOL_BORDER, 0);
    lv_obj_set_style_border_width(box1, 1, 0);
    lv_obj_set_style_radius(box1, 8, 0);
    lv_obj_clear_flag(box1, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_t *box1Title = lv_label_create(box1);
    lv_label_set_text(box1Title, t(I18N_HW_LEFT));
    lv_obj_set_style_text_color(box1Title, LVCOL_MUTED, 0);
    lv_obj_set_style_text_font(box1Title, &lv_font_montserrat_14, 0);
    lv_obj_set_pos(box1Title, 10, 8);
    lv_obj_t *box1Val = lv_label_create(box1);
    lv_obj_set_pos(box1Val, 10, 30);

    lv_obj_t *box2 = lv_obj_create(scr);
    lv_obj_remove_style_all(box2);
    lv_obj_set_size(box2, 228, 64);
    lv_obj_set_pos(box2, 246, 137);
    lv_obj_set_style_bg_color(box2, LVCOL_CARD, 0);
    lv_obj_set_style_bg_opa(box2, LV_OPA_COVER, 0);
    lv_obj_set_style_border_color(box2, LVCOL_BORDER, 0);
    lv_obj_set_style_border_width(box2, 1, 0);
    lv_obj_set_style_radius(box2, 8, 0);
    lv_obj_clear_flag(box2, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_t *box2Title = lv_label_create(box2);
    lv_label_set_text(box2Title, t(I18N_HW_RIGHT));
    lv_obj_set_style_text_color(box2Title, LVCOL_MUTED, 0);
    lv_obj_set_style_text_font(box2Title, &lv_font_montserrat_14, 0);
    lv_obj_set_pos(box2Title, 10, 8);
    lv_obj_t *box2Val = lv_label_create(box2);
    lv_obj_set_pos(box2Val, 10, 30);

    // Scan / Stop button — centered, not full width, big enough to tap easily
    lv_obj_t *scanBtn = lv_btn_create(scr);
    lv_obj_set_size(scanBtn, 280, 70);
    lv_obj_align(scanBtn, LV_ALIGN_TOP_MID, 0, 242);
    lv_obj_set_style_border_width(scanBtn, 1, 0);
    lv_obj_set_style_radius(scanBtn, 12, 0);
    lv_obj_set_style_shadow_width(scanBtn, 0, 0);
    lv_obj_set_user_data(scanBtn, (void *)(intptr_t)HA_SCAN);
    lv_obj_add_event_cb(scanBtn, actionCb, LV_EVENT_CLICKED, nullptr);
    lv_obj_t *scanLbl = lv_label_create(scanBtn);
    lv_obj_set_style_text_font(scanLbl, &lv_font_montserrat_16, 0);
    lv_obj_center(scanLbl);

    // Back
    lv_obj_t *backBtn = lv_btn_create(scr);
    lv_obj_set_size(backBtn, 34, 36);
    lv_obj_set_pos(backBtn, 0, 0);
    lv_obj_set_style_bg_opa(backBtn, LV_OPA_TRANSP, 0);
    lv_obj_set_style_border_width(backBtn, 0, 0);
    lv_obj_set_style_shadow_width(backBtn, 0, 0);
    lv_obj_set_user_data(backBtn, (void *)(intptr_t)HA_BACK);
    lv_obj_add_event_cb(backBtn, actionCb, LV_EVENT_CLICKED, nullptr);
    lv_obj_t *backIcon = lv_label_create(backBtn);
    lv_label_set_text(backIcon, LV_SYMBOL_LEFT);
    lv_obj_set_style_text_color(backIcon, LVCOL_MUTED, 0);
    lv_obj_center(backIcon);

    auto updatePower = [&]() {
        lv_label_set_text_fmt(powNumLbl, "%u", (unsigned)gRfidPowerLevel);
        lv_obj_set_style_text_color(minusBtn, gRfidPowerLevel > 0 ? LVCOL_TEXT : LVCOL_BORDER, 0);
        lv_obj_set_style_text_color(minusLbl, gRfidPowerLevel > 0 ? LVCOL_TEXT : LVCOL_BORDER, 0);
        lv_obj_set_style_text_color(plusLbl,  gRfidPowerLevel < PN532_RF_LEVEL_COUNT-1 ? LVCOL_TEXT : LVCOL_BORDER, 0);
    };
    auto updatePills = [&]() {
        // Cumulative, not exclusive: pill "2" means reader 2 is ALSO active
        // (on top of reader 1), not "instead of" reader 1 -- both light up
        // together in 2-reader mode, matching what's actually active.
        lv_obj_set_style_bg_color(pill1, hwRfidCount>=1 ? LVCOL_ACCENT : LVCOL_CARD, 0);
        lv_obj_set_style_bg_color(pill2, hwRfidCount>=2 ? LVCOL_ACCENT : LVCOL_CARD, 0);
    };
    auto updateBoxes = [&]() {
        lv_label_set_text(box1Val, uid1.length() ? uid1.c_str() : "-");
        lv_obj_set_style_text_color(box1Val, uid1.length() ? LVCOL_GREEN : LVCOL_MUTED, 0);
        bool r2on = (hwRfidCount == 2);
        lv_label_set_text(box2Val, r2on ? (uid2.length() ? uid2.c_str() : "-") : "-");
        lv_obj_set_style_text_color(box2Val, r2on && uid2.length() ? LVCOL_GREEN : LVCOL_MUTED, 0);
        lv_obj_set_style_border_color(box2, r2on ? LVCOL_BORDER : LVCOL_CARD, 0);
        lv_obj_set_style_text_color(box2Title, r2on ? LVCOL_MUTED : LVCOL_CARD, 0);
    };
    auto updateScanBtn = [&]() {
        lv_obj_set_style_bg_color(scanBtn, scanning ? LVCOL_RED : LVCOL_CARD, 0);
        lv_obj_set_style_border_color(scanBtn, LVCOL_BORDER, 0);
        lv_label_set_text(scanLbl, scanning ? t(I18N_STOP) : t(I18N_SCAN));
        lv_obj_set_style_text_color(scanLbl, LVCOL_TEXT, 0);
    };

    updatePower();
    updatePills();
    updateBoxes();
    updateScanBtn();
    lv_scr_load(scr);

    for (;;) {
        sHwAction = HA_NONE;

        if (!scanning) {
            // Idle: block until a button fires (mirrors tsWaitTap)
            while (sHwAction == HA_NONE) { lv_timer_handler(); delay(5); }

            if (sHwAction == HA_MINUS) {
                if (gRfidPowerLevel > 0) {
                    gRfidPowerLevel--;
                    prefs.begin("config", false); prefs.putUChar("rfidPower", gRfidPowerLevel); prefs.end();
                    if (gRfid1Present) rfid1.applyRfPower(gRfidPowerLevel);
                    if (gRfid2Present) rfid2.applyRfPower(gRfidPowerLevel);
                    updatePower();
                }
            } else if (sHwAction == HA_PLUS) {
                if (gRfidPowerLevel < PN532_RF_LEVEL_COUNT-1) {
                    gRfidPowerLevel++;
                    prefs.begin("config", false); prefs.putUChar("rfidPower", gRfidPowerLevel); prefs.end();
                    if (gRfid1Present) rfid1.applyRfPower(gRfidPowerLevel);
                    if (gRfid2Present) rfid2.applyRfPower(gRfidPowerLevel);
                    updatePower();
                }
            } else if (sHwAction == HA_PILL1) {
                hwRfidCount = 1;
                prefs.begin("config", false); prefs.putUChar("hwRfidCnt", 1); prefs.end();
                updatePills(); updateBoxes();
            } else if (sHwAction == HA_PILL2) {
                hwRfidCount = 2;
                prefs.begin("config", false); prefs.putUChar("hwRfidCnt", 2); prefs.end();
                updatePills(); updateBoxes();
            } else if (sHwAction == HA_SCAN) {
                uid1 = ""; uid2 = "";
                scanning = true;
                updateBoxes(); updateScanBtn();
                // Wait for finger lift before entering the scan loop
                { int16_t dx, dy; uint32_t t0 = millis(); while (tsRead(dx, dy) && millis()-t0 < 600) delay(20); }
            } else if (sHwAction == HA_BACK) {
                break;
            }
        } else {
            // Scanning: poll RFID readers, watch for a tap on the (now "Stop") button
            String h; bool fail;
            bool changed = false;

            // rfid2 = physically LEFT, rfid1 = physically RIGHT
            if (readRFIDFromReaderTestStyle(rfid2, h, "L", &fail).length() > 0) {
                if (h != uid1) { uid1 = h; changed = true; }
            } else {
                finishRfidSession(rfid2);
            }
            if (hwRfidCount >= 2) {
                if (readRFIDFromReaderTestStyle(rfid1, h, "R", &fail).length() > 0) {
                    if (h != uid2) { uid2 = h; changed = true; }
                } else {
                    finishRfidSession(rfid1);
                }
            }
            if (changed) updateBoxes();

            lv_timer_handler();
            delay(20);

            if (sHwAction == HA_SCAN) {
                scanning = false;
                updateScanBtn();
                { int16_t dx, dy; uint32_t t0 = millis(); while (tsRead(dx, dy) && millis()-t0 < 600) delay(20); }
            }
        }
    }

    lv_scr_load(lvScreen);
    lv_obj_del(scr);
    { int16_t dx, dy; uint32_t t0 = millis(); while (tsRead(dx, dy) && millis()-t0 < 800) delay(20); }
}

