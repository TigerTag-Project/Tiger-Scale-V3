class PN532Reader {
public:
    struct Uid { uint8_t size = 0; uint8_t uidByte[10] = {0}; } uid;

    explicit PN532Reader(uint8_t ssPin) : _pn532(ssPin), _ssPin(ssPin) {}

    bool init() {
        _pn532.begin();
        if (_pn532.getFirmwareVersion() == 0) return false;
        _pn532.SAMConfig();
        applyPN532RfTuning(_pn532, gRfidPowerLevel);
        _pn532.setPassiveActivationRetries(1);
        return true;
    }

    uint32_t firmwareVersion() { return _pn532.getFirmwareVersion(); }

    bool isNewCardPresent() {
        uint8_t len = 0;
        bool ok = _pn532.readPassiveTargetID(PN532_MIFARE_ISO14443A, uid.uidByte, &len, 30);
        if (ok) uid.size = len;
        _pendingUid = ok;
        return ok;
    }

    bool readCardSerial() {
        bool ok = _pendingUid;
        _pendingUid = false;
        return ok;
    }

    // No-ops: PN532 re-selects fresh on every readPassiveTargetID() call and
    // TigerTag pages are unauthenticated Ultralight/NTAG reads, so there is
    // no HALT/crypto-stop equivalent needed between reads.
    void haltA() {}
    void stopCrypto1() {}

    void antennaOn()  { _fieldOn = true; }
    void antennaOff() { _fieldOn = false; }
    // Re-applies RF power/sensitivity live (no re-init needed) -- used by
    // the Hardware/RFID Test screen's "Pot:" stepper.
    void applyRfPower(uint8_t level) { applyPN532RfTuning(_pn532, level); }
    bool antennaIsOn() const { return _fieldOn; }

    // Reads 4 pages (16 bytes) starting at `page` — matches the block-of-4
    // semantics of MFRC522::MIFARE_Read() used to fetch the TigerTag block.
    bool readPages16(uint8_t page, uint8_t *out16) {
        for (uint8_t i = 0; i < 4; i++) {
            if (!_pn532.mifareultralight_ReadPage(page + i, out16 + (i * 4))) return false;
        }
        return true;
    }

private:
    Adafruit_PN532 _pn532;
    uint8_t _ssPin;
    bool _pendingUid = false;
    bool _fieldOn = true;
};

PN532Reader rfid1(PN532_1_SS);
PN532Reader rfid2(PN532_2_SS);

