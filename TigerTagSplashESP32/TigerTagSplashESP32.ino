// Map user speed level (1-5) → µs for the continuous-rotation servo
// 1500 = full stop, higher = faster forward rotation
static inline int motorLevelToUs(uint8_t lvl) {
    switch (lvl) {
        case 1: return 1530;
        case 2: return 1580;
        case 3: return 1650;
        case 4: return 1750;
        case 5: return 1900;
        default: return 1650;
    }
}
