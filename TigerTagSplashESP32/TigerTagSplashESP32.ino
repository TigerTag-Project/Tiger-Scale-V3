// Chinese glyphs. The built-in Montserrat faces are Latin-only, which is why
// the Chinese column of i18n.h used to be pinyin. These are subset fonts holding
// only the 173 Han characters our own translations use — generated by
// scripts/make-cjk-font.sh from Noto Sans SC, so they are reproducible and the
// licence is recorded.
//
// They are attached as *fallbacks* rather than swapped in per language, so one
// wiring point covers every screen: Latin still renders through Montserrat and
// only a glyph it does not have reaches the CJK face. LVGL's built-in fonts are
// const and live in flash, so their .fallback field cannot be written — hence
// the RAM copies below, which every label in the UI uses instead.
extern "C" {
    extern const lv_font_t font_cjk_14;
    extern const lv_font_t font_cjk_16;
    extern const lv_font_t font_cjk_20;
}
static lv_font_t gFont14, gFont16, gFont20;

// Icon glyphs the CJK subset fonts carry beyond LVGL's built-in symbol set —
// FontAwesome codepoints riding in font_cjk_* (see scripts/make-cjk-font.sh),
// so they draw through any gFont* like ordinary text.
#define TT_SYMBOL_LOCK "\xEF\x80\xA3"   /* U+F023, padlock */
#define TT_SYMBOL_SUN  "\xEF\x86\x85"   /* U+F185, sun — the brightness row */
#define TT_SYMBOL_GOOGLE "\xEF\x86\xA0" /* U+F1A0, Google G — the sign-in button */

// What LV_FONT_DEFAULT resolves to. lv_conf.h points the macro here instead of
// at &lv_font_montserrat_14 so that the labels which never name a font -- which
// is nearly all of them -- get the fallback-carrying face too. Starts at the
// plain Montserrat so that anything drawn before lvglInitFonts() still has a
// font, rather than a null dereference.
extern "C" const lv_font_t *lv_font_ui_default = &lv_font_montserrat_14;

static void lvglInitFonts() {
    gFont14 = lv_font_montserrat_14; gFont14.fallback = &font_cjk_14;
    gFont16 = lv_font_montserrat_16; gFont16.fallback = &font_cjk_16;
    gFont20 = lv_font_montserrat_20; gFont20.fallback = &font_cjk_20;
    lv_font_ui_default = &gFont14;
}

// One-shot check, reported over /api/logs because the USB console on this unit
// stops producing output after a while. Asks the three faces for a Han glyph the
// subset is known to contain, so "the font is missing the character" and "the
// fallback is never consulted" stop looking the same on screen — both render an
// empty box and nothing distinguishes them.
static void lvglReportFontProbe() {
    struct { const char *name; const lv_font_t *f; } probes[] = {
        { "font14", &gFont14 }, { "font16", &gFont16 }, { "font20", &gFont20 },
        { "cjk14", &font_cjk_14 },
        // The one that actually mattered: what a label inherits when it names no
        // font. Probing only the three named faces is what made this look fixed
        // for a whole session while the screen still showed boxes.
        { "inherited", lv_font_default() },
    };
    for (auto &p : probes) {
        lv_font_glyph_dsc_t dsc;
        bool ok = lv_font_get_glyph_dsc(p.f, &dsc, 0x5C31, 0);   // U+5C31 jiu
        netLog("FONTPROBE " + String(p.name) + (ok ? " found" : " MISSING")
               + " w=" + String(ok ? dsc.box_w : 0)
               + " fb=" + String(p.f->fallback ? "yes" : "no"));
    }
}


