static const uint16_t COL_UNIT      = 0xAD97;  // weight unit "g" (softer than the number)

// Settings/gear icon centred at (cx, cy): filled ring r=8, 8 teeth, centre dot r=3.
// bg = button background colour used to punch the inner hole.
static void drawSettingsIcon(int16_t cx, int16_t cy, uint16_t color, uint16_t bg) {
    // Gear body
    gfx->fillCircle(cx, cy, 10, color);
    // 8 teeth at r=12, 45° apart — pre-computed (dx,dy) rounded to integer pixels
    // Angles: 0,45,90,135,180,225,270,315 × r12 → (12,0),(8,8),(0,12),(-8,8),(-12,0),(-8,-8),(0,-12),(8,-8)
    const int8_t tdx[8] = { 12,  8,  0, -8, -12, -8,  0,  8};
    const int8_t tdy[8] = {  0,  8, 12,  8,   0, -8,-12, -8};
    for (int i = 0; i < 8; i++)
        gfx->fillRect(cx + tdx[i] - 2, cy + tdy[i] - 2, 4, 4, color);
    // Inner hole (punch background colour)
    gfx->fillCircle(cx, cy, 6, bg);
    // Centre circle
    gfx->fillCircle(cx, cy, 3, color);
}

// Battery icon: minimal outline body 48×26, terminal 5×14 on right, single
// proportional fill bar (no segmented rainbow bars — matches the flat light theme).
// pct: 0-100 = battery %, 254 = unknown, 255 = USB/VBUS. vbus = charger detected.
// Fill colour: COL_ACCENT normally, red only when critically low (<=15%), COL_ACCENT + bolt when charging.
static void drawBatteryIcon(int16_t bx, int16_t by, uint8_t pct, bool vbus) {
    const int16_t BW=48, BH=26, TW=5, TH=14;
    // Body: thin outline only (hollow), no card fill
    gfx->drawRoundRect(bx, by, BW, BH, 4, COL_TEXT);
    // Terminal nub (right side, vertically centred)
    gfx->fillRoundRect(bx+BW, by+(BH-TH)/2, TW, TH, 2, COL_TEXT);

    const int16_t PAD = 3;
    const int16_t innerX = bx+PAD, innerY = by+PAD, innerW = BW-2*PAD, innerH = BH-2*PAD;

    if (pct == 254) {
        // Unknown — just a "?" in the outline, no fill
        gfx->setTextColor(COL_MUTED); gfx->setTextSize(1);
        gfx->setCursor(bx + (BW-6)/2, by + (BH-8)/2);
        gfx->print("?");
        return;
    }

    bool charging = (pct == 255 || vbus);
    uint8_t level = charging ? 100 : pct;
    uint16_t fillCol = (!charging && level <= 15) ? (uint16_t)0xF800 : COL_ACCENT;
    int16_t fillW = (int16_t)((int32_t)innerW * level / 100);
    if (fillW < 3) fillW = 3; // always show a sliver so the icon reads as "a battery"
    gfx->fillRoundRect(innerX, innerY, fillW, innerH, 2, fillCol);

    // Lightning bolt overlay when USB / charging
    if (charging) {
        int16_t bcx = bx + BW/2, bcy = by + BH/2;
        gfx->fillTriangle(bcx+4, bcy-8, bcx-4, bcy+1, bcx+1, bcy+1, COL_ON_ACCENT);
        gfx->fillTriangle(bcx+4, bcy-1, bcx-1, bcy-1, bcx-4, bcy+8, COL_ON_ACCENT);
    }
}

// WiFi icon: 14 wide × 10 tall, drawn at (ix, iy).
// Large arc (row 0-1), medium arc (row 3-4), small arc (row 6), dot (rows 8-9).
static void drawWifiIcon(int16_t ix, int16_t iy, uint16_t color) {
    gfx->drawFastHLine(ix+1,  iy+0, 12, color);  // large arc top
    gfx->drawPixel(ix+0,  iy+1, color);           // large arc sides
    gfx->drawPixel(ix+1,  iy+1, color);
    gfx->drawPixel(ix+12, iy+1, color);
    gfx->drawPixel(ix+13, iy+1, color);
    gfx->drawFastHLine(ix+3,  iy+3, 8, color);   // medium arc top
    gfx->drawPixel(ix+2,  iy+4, color);           // medium arc sides
    gfx->drawPixel(ix+3,  iy+4, color);
    gfx->drawPixel(ix+10, iy+4, color);
    gfx->drawPixel(ix+11, iy+4, color);
    gfx->drawFastHLine(ix+5,  iy+6, 4, color);   // small arc
    gfx->fillRect(ix+6,   iy+8, 2, 2, color);    // dot
}

// Volume icon 44×28px — type: 0=mute(X) 1=unmute(waves) 2=vol_up(+) 3=vol_down(-)
// Speaker body: left 16px, symbol: right 28px from sx=ix+16
static void drawVolumeIcon(int16_t ix, int16_t iy, uint8_t type, uint16_t color) {
    // Speaker body
    gfx->fillRect(ix, iy+9, 4, 10, color);                              // box
    gfx->fillTriangle(ix+4, iy+9, ix+14, iy+3, ix+14, iy+25, color);  // upper cone
    gfx->fillTriangle(ix+4, iy+9, ix+4,  iy+19, ix+14, iy+25, color); // lower cone
    int16_t sx = ix+18, cy = iy+14;
    switch (type) {
        case 0: // Mute — X (3px thick diagonals)
            for (int t=0; t<3; t++) {
                gfx->drawLine(sx+t,    cy-9, sx+24+t, cy+9, color);
                gfx->drawLine(sx+24-t, cy-9, sx-t,    cy+9, color);
            }
            break;
        case 1: // Unmute — 3 waves (chevron approximation)
            for (int t=0; t<2; t++) {
                gfx->drawLine(sx+t,    cy-4,  sx+5+t, cy,   color);
                gfx->drawLine(sx+5+t,  cy,    sx+t,   cy+4, color);
                gfx->drawLine(sx+8+t,  cy-7,  sx+14+t,cy,   color);
                gfx->drawLine(sx+14+t, cy,    sx+8+t, cy+7, color);
                gfx->drawLine(sx+17+t, cy-11, sx+24+t,cy,   color);
                gfx->drawLine(sx+24+t, cy,    sx+17+t,cy+11,color);
            }
            break;
        case 2: // Vol Up — + symbol
            gfx->fillRect(sx+11, cy-10, 4, 20, color); // vertical
            gfx->fillRect(sx,    cy-2,  26, 4,  color); // horizontal
            break;
        case 3: // Vol Down — - symbol
            gfx->fillRect(sx, cy-2, 26, 4, color);
            break;
    }
}

