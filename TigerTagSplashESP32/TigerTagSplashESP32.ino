void startMDNS() {
    MDNS.end();
    delay(50);
    if (!WiFi.isConnected()) return;
    if (MDNS.begin(gMdnsName.c_str())) {
        MDNS.addService("http", "tcp", 80);
        Serial.println("[mDNS] http://" + gMdnsName + ".local");
    } else {
        Serial.println("[mDNS] start failed");
    }
}

void onWiFiEvent(WiFiEvent_t event) {
    switch (event) {
        case ARDUINO_EVENT_WIFI_STA_GOT_IP:
#ifdef SYSTEM_EVENT_STA_GOT_IP
        case SYSTEM_EVENT_STA_GOT_IP:
#endif
            wifiConnected = true;
            Serial.println("[WiFi] Connected: " + WiFi.localIP().toString());
            startMDNS();
            break;
        case ARDUINO_EVENT_WIFI_STA_DISCONNECTED:
#ifdef SYSTEM_EVENT_STA_DISCONNECTED
        case SYSTEM_EVENT_STA_DISCONNECTED:
#endif
            wifiConnected = false;
            Serial.println("[WiFi] Disconnected");
            MDNS.end();
            break;
        default: break;
    }
}

// ============================================================================
// §23 — SCALE
// ============================================================================

void setupScale() {
    scale.begin(HX711_DOUT, HX711_SCK);
    scale.set_scale(calibrationFactor);

    prefs.begin("config", true);
    float savedTare = prefs.getFloat("tareFactor", 0.0f);
    prefs.end();

    bool tareLooksValid = (savedTare != 0.0f && savedTare != -1.0f && fabs(savedTare) > 10.0f);
    if (tareLooksValid) {
        scale.set_offset(savedTare);
        Serial.printf("[SCALE] Tare restored: %f\n", savedTare);
    } else {
        scale.tare();
        Serial.printf("[SCALE] Fresh tare applied (saved offset invalid: %f)\n", savedTare);
    }
    if (!gBootComplete) { bootProgress(92, "Scale ready"); delay(400); }
    else { displayMessage("Scale OK", tareLooksValid ? "Tare restored" : "Fresh tare"); delay(1000); }
}

// Rate-of-change based rapid-change detector. The previous version gated on
// a fixed 50-100ms window between STATE-UPDATING calls before it would even
// look at delta -- but readWeight() (and therefore this function) is called
// once per loop() iteration with no fixed cadence, so that window rarely
// lined up with the real call interval and EMA_ALPHA_FAST essentially never
// engaged. Every weight change (placing OR removing a spool) fell through to
// the slow EMA_ALPHA_FINE path, which read as "the scale doesn't react when
// I put weight on it" -- the value was still converging, just very slowly,
// and only became visible a couple of seconds later. Fixed by computing an
// actual rate (g/s), independent of loop cadence, and updating state on
// every call.
static bool isRapidChange(float raw) {
    static float    gLastRaw     = 0.0f;
    static uint32_t gLastRawTime = 0;
    uint32_t now = millis();
    uint32_t dt  = now - gLastRawTime;
    float delta  = fabs(raw - gLastRaw);
    gLastRaw     = raw;
    gLastRawTime = now;
    if (dt == 0) return false; // first call / same-millisecond call, no rate yet
    float ratePerSec = delta / (dt / 1000.0f);
    return ratePerSec > 20.0f; // > ~20 g/s ~= something was just placed or removed
}

static float applyDeadZone(float value) {
    if (fabs(value) < DEAD_ZONE_G) return 0.0f;
    return (value >= 0) ? (value - DEAD_ZONE_G) : (value + DEAD_ZONE_G);
}

static float applyHysteresis(float newValue, float lastValue) {
    return (fabs(newValue - lastValue) < HYSTERESIS_THRESHOLD) ? lastValue : newValue;
}

static float computeMedian() {
    if (gMedianCount == 0) return gEmaWeight;
    float tmp[MEDIAN_WINDOW_LARGE];
    memcpy(tmp, gMedianBuf, gMedianCount * sizeof(float));
    for (int i = 1; i < gMedianCount; ++i) {
        float key = tmp[i]; int j = i - 1;
        while (j >= 0 && tmp[j] > key) { tmp[j+1] = tmp[j]; j--; }
        tmp[j+1] = key;
    }
    return (gMedianCount % 2 == 1)
        ? tmp[gMedianCount / 2]
        : (tmp[gMedianCount/2 - 1] + tmp[gMedianCount/2]) / 2.0f;
}

float readWeight() {
    static uint32_t lastHxWarnMs = 0;
    const uint32_t HX711_OFFLINE_HOLD_MS = 600;

    if (!scale.is_ready()) {
        // No warning here below the offline hold: a 10 Hz HX711 is "not
        // ready" ~90% of the time between samples, so logging on the raw
        // test printed a scary "[HX711] not ready" every 2 s on a scale
        // that was weighing perfectly. Only a streak past the hold is news.
        if (gHx711NotReadySinceMs == 0) gHx711NotReadySinceMs = millis();
        gHx711Online = false;
        if ((millis() - gHx711NotReadySinceMs) >= HX711_OFFLINE_HOLD_MS) {
            if (millis() - lastHxWarnMs >= 2000) {
                lastHxWarnMs = millis();
                Serial.println("[HX711] not ready");
            }
            currentWeight = 0.0f;
            gLastDisplayedWeight = 0.0f;
            gEmaWeight = 0.0f;
            gEmaInit = false;
            gMedianIdx = 0;
            gMedianCount = 0;
            gStableStartMs = 0;
            gIsStable = false;
        }
        return currentWeight;
    }

    if (!scale.wait_ready_timeout(20, 1)) {
        if (gHx711NotReadySinceMs == 0) gHx711NotReadySinceMs = millis();
        gHx711Online = false;
        if (millis() - lastHxWarnMs >= 2000) {
            lastHxWarnMs = millis();
            Serial.println("[HX711] wait_ready_timeout");
        }
        if ((millis() - gHx711NotReadySinceMs) >= HX711_OFFLINE_HOLD_MS) {
            currentWeight = 0.0f;
            gLastDisplayedWeight = 0.0f;
            gEmaWeight = 0.0f;
            gEmaInit = false;
            gMedianIdx = 0;
            gMedianCount = 0;
            gStableStartMs = 0;
            gIsStable = false;
        }
        return currentWeight;
    }

    gHx711Online = true;
    gHx711NotReadySinceMs = 0;

    float raw = scale.get_units(1);
    if (isnan(raw) || isinf(raw)) {
        gHx711Online = false;
        if (gHx711NotReadySinceMs == 0) gHx711NotReadySinceMs = millis();
        if (millis() - lastHxWarnMs >= 2000) {
            lastHxWarnMs = millis();
            Serial.println("[HX711] invalid reading");
        }
        if ((millis() - gHx711NotReadySinceMs) >= HX711_OFFLINE_HOLD_MS) {
            currentWeight = 0.0f;
            gLastDisplayedWeight = 0.0f;
            gEmaWeight = 0.0f;
            gEmaInit = false;
            gMedianIdx = 0;
            gMedianCount = 0;
            gStableStartMs = 0;
            gIsStable = false;
        }
        return currentWeight;
    }

    gMedianBuf[gMedianIdx] = raw;
    gMedianIdx = (gMedianIdx + 1) % MEDIAN_WINDOW_LARGE;
    if (gMedianCount < MEDIAN_WINDOW_LARGE) gMedianCount++;
    float medianVal = computeMedian();

    bool  rapidChange = isRapidChange(raw);
    float alphaToUse  = rapidChange ? EMA_ALPHA_FAST : EMA_ALPHA_FINE;

    if (!gEmaInit) { gEmaWeight = medianVal; gEmaInit = true; }
    else            { gEmaWeight += alphaToUse * (medianVal - gEmaWeight); }

    float withHysteresis = applyHysteresis(gEmaWeight, gLastDisplayedWeight);
    float withDeadZone   = applyDeadZone(withHysteresis);

    float delta = fabs(withDeadZone - gLastDisplayedWeight);
    if (delta < 0.2f) {
        if (gStableStartMs == 0) gStableStartMs = millis();
        else if (millis() - gStableStartMs > STABLE_DISPLAY_MS) gIsStable = true;
    } else {
        gStableStartMs = millis();
        gIsStable = false;
    }

    gLastDisplayedWeight = withDeadZone;
    currentWeight        = withDeadZone;
    return currentWeight;
}

// ============================================================================
// §AUDIO — ES8311 codec beep (I2S slave mode, Wire I2C @ 0x18)
// ============================================================================

static I2SClass spkI2s;
static bool     spkReady = false;

static void es8311Write(uint8_t reg, uint8_t val) {
    // ES8311 is on Wire1 (GPIO8=SDA, GPIO7=SCL) — same bus as touch controller
    Wire1.beginTransmission(ES8311_I2C_ADDR);
    Wire1.write(reg); Wire1.write(val);
    uint8_t err = Wire1.endTransmission();
    if (err) Serial.printf("[ES8311] reg=0x%02X val=0x%02X err=%d\n", reg, val, err);
}

static void es8311Init() {
    // Reset sequence (matches Espressif esp-bsp ES8311 driver)
    es8311Write(0x00, 0x1F); delay(20); // reset all blocks
    es8311Write(0x00, 0x00); delay(5);  // clear reset (all blocks running)
    es8311Write(0x00, 0x80); delay(5);  // CSM on, slave mode (bit6=0)

    // Clocks: all on, MCLK from MCLK pin (GPIO44), slave mode
    es8311Write(0x01, 0x3F);  // MCLK_ON|BCLK_ON|CLKADC_ON|CLKDAC_ON

    // Clock coefficients for MCLK=4096000 Hz (256*16000), sample_rate=16000 Hz
    // From Espressif coeff_div[] table: pre_div=1, pre_multi=0, adc_div=1, dac_div=1,
    //   fs_mode=0, lrck_h=0x00, lrck_l=0xFF, bclk_div=4, adc_osr=0x10, dac_osr=0x10
    es8311Write(0x02, 0x00);  // pre_div=1 -> (1-1)<<5=0, pre_multi=1x -> 0
    es8311Write(0x03, 0x10);  // fs_mode=single, adc_osr=0x10
    es8311Write(0x04, 0x10);  // dac_osr=0x10
    es8311Write(0x05, 0x00);  // adc_div=1 -> (1-1)<<4=0, dac_div=1 -> 0
    es8311Write(0x06, 0x03);  // bclk_div=4 -> DIV_BCLK=(4-1)=3
    es8311Write(0x07, 0x00);  // LRCK divider high byte
    es8311Write(0x08, 0xFF);  // LRCK divider low byte

    // I2S format: standard I2S, 16-bit, slave mode
    es8311Write(0x09, 0x00);  // SDP_IN: I2S, 16-bit, left channel -> DAC
    es8311Write(0x0A, 0x00);  // SDP_OUT: I2S, 16-bit

    // Power up analog path
    es8311Write(0x0D, 0x01);  // power up analog circuitry
    es8311Write(0x0E, 0x02);  // enable analog PGA + ADC modulator
    es8311Write(0x12, 0x00);  // power up DAC
    es8311Write(0x13, 0x10);  // enable HP driver output

    // DAC signal path
    es8311Write(0x1C, 0x6A);  // ADC EQ bypass + DC offset cancellation
    es8311Write(0x37, 0x08);  // bypass DAC equalizer

    // DAC digital volume from gVolume (0–100 → 0x00–0xFF)
    es8311Write(0x32, gMute ? 0x00 : (uint8_t)(gVolume * 255 / 100));
}

// Internal: generate one tone. Requires spkReady already confirmed.
static void playNote(int freqHz, int durationMs) {
    es8311Write(0x32, (uint8_t)(gVolume * 255 / 100));
    const int     RATE = 16000;
    const int16_t AMP  = 28000;
    int halfW = (freqHz > 0) ? RATE / freqHz / 2 : 0;
    int total = RATE * durationMs / 1000;
    int16_t s = AMP;
    for (int i = 0; i < total; i++) {
        if (halfW > 0 && i % halfW == 0) s = -s;
        uint8_t buf[4] = {
            (uint8_t)(s & 0xFF), (uint8_t)((s >> 8) & 0xFF),
            (uint8_t)(s & 0xFF), (uint8_t)((s >> 8) & 0xFF)
        };
        spkI2s.write(buf, 4);
    }
}

// Play silence gap between notes.
static void playSilence(int durationMs) {
    const int RATE = 16000;
    int total = RATE * durationMs / 1000;
    uint8_t buf[4] = {0, 0, 0, 0};
    for (int i = 0; i < total; i++) spkI2s.write(buf, 4);
}

// Play the current sound theme (gSoundTheme). Synchronous, call from main loop only.
static void playSoundTheme() {
    if (gMute) return;
    if (!spkReady) {
        Wire1.beginTransmission(ES8311_I2C_ADDR);
        uint8_t scanErr = Wire1.endTransmission();
        log_e("[BEEP] ES8311 scan 0x%02X: %s (err=%d)",
              ES8311_I2C_ADDR, scanErr == 0 ? "ACK" : "NACK", scanErr);
        es8311Init();
        delay(50);
        spkI2s.setPins(SPK_I2S_BCLK, SPK_I2S_WS, SPK_I2S_DOUT, -1, SPK_I2S_MCLK);
        if (!spkI2s.begin(I2S_MODE_STD, 16000,
                          I2S_DATA_BIT_WIDTH_16BIT, I2S_SLOT_MODE_STEREO)) {
            log_e("[BEEP] I2S begin() failed");
            return;
        }
        spkReady = true;
        log_e("[BEEP] ES8311 + I2S ready");
    }
    switch (gSoundTheme) {
        case 0:  // Beep — single 880 Hz pulse
            playNote(880, 200);
            break;
        case 1:  // Double — two short 1047 Hz pips
            playNote(1047, 60);
            playSilence(50);
            playNote(1047, 60);
            break;
        case 2:  // Chime — ascending 3-note arpeggio
            playNote(523, 70);
            playNote(784, 70);
            playNote(1047, 120);
            break;
        case 3:  // Click — very short high-frequency pulse
            playNote(1760, 25);
            break;
    }
}

// ============================================================================
// §24 — RFID
// ============================================================================

static String normalizeUidHex(const String& uid) {
    String s = uid;
    s.trim();
    s.toUpperCase();
    return s;
}


static bool initPN532Reader(PN532Reader &reader, uint8_t ssPin, uint8_t rstPin, const char *label) {
    Serial.printf("[RFID] init %s ss=%u rst=%u\n", label, ssPin, rstPin);
    pinMode(ssPin, OUTPUT);
    digitalWrite(ssPin, HIGH);
    pinMode(rstPin, OUTPUT);
    digitalWrite(rstPin, LOW);
    delay(5);
    digitalWrite(rstPin, HIGH);
    delay(50);
    if (!reader.init()) {
        Serial.printf("[RFID] %s init failed\n", label);
        return false;
    }
    // reader.init() already confirmed a non-zero firmware version -- don't
    // immediately re-query it again via probePN532() here. Two
    // GetFirmwareVersion round-trips back-to-back sometimes has the second
    // one time out on this hardware even though the first (inside init())
    // just succeeded.
    Serial.printf("[RFID] %s ready\n", label);
    return true;
}

// RF self-test: one reader impersonates a card carrying three random bytes,
// the other reads it with the ordinary tag path.
//
// This proves far more than the version query the boot screen relies on. That
// query only shows the module answers on its serial link and says nothing about
// the antenna — which is exactly why a working reader could be reported offline.
// This drives one antenna's transmitter and the other's receiver, and carries
// three bytes across the 75 mm gap that the firmware chose a moment earlier, so
// a cached or stuck value cannot pass for a success.
//
// Run in both directions it isolates a fault. Right->left working while
// left->right does not puts the trouble in the left transmitter or the right
// receiver, which no single-ended probe can tell you.
//
// The frame is the library's own AsTarget() payload with NFCID1T replaced. The
// response is deliberately never read: TgInitAsTarget only answers once an
// initiator activates the module, so reading here would block the very poll
// meant to do the activating.
//
// The platform must be empty. A spool between the antennas blocks the field and
// fails the test for a reason that has nothing to do with the hardware.

static void rfidSelectReader(uint8_t which) {
    if (FORCE_SINGLE_RFID_STABLE_MODE) {
        gRfidSelectedReader = which;
        gRfidSelectedSinceMs = millis();
        return;
    }

    gRfidSelectedReader = which;
    gRfidSelectedSinceMs = millis();

    digitalWrite(PN532_1_SS, HIGH);
    digitalWrite(PN532_2_SS, HIGH);

    // Put both readers into reset first so only one device is electrically
    // active on the shared SPI bus at a time. PN532's RSTPDN pin doubles as a
    // power-down line, so holding it low fully silences the non-selected chip.
    digitalWrite(PN532_1_RST, LOW);
    digitalWrite(PN532_2_RST, LOW);
    delay(3);

    if (which == 1) {
        digitalWrite(PN532_1_RST, HIGH);
        delay(6);
        if (gRfid1Present) {
            rfid1.init();
            rfid1.haltA();
            rfid1.stopCrypto1();
        }
    } else if (which == 2) {
        digitalWrite(PN532_2_RST, HIGH);
        delay(6);
        if (gRfid2Present) {
            rfid2.init();
            rfid2.haltA();
            rfid2.stopCrypto1();
        }
    } else {
        digitalWrite(PN532_1_RST, HIGH);
        digitalWrite(PN532_2_RST, HIGH);
        delay(6);
        if (gRfid1Present) {
            rfid1.init();
            rfid1.haltA();
            rfid1.stopCrypto1();
        }
        if (gRfid2Present) {
            rfid2.init();
            rfid2.haltA();
            rfid2.stopCrypto1();
        }
    }
    delay(10);
}

static void normalizeRfidHwConfig() {
    if (hwRfidSide > 1) hwRfidSide = 0;
    if (FORCE_SINGLE_RFID_STABLE_MODE) {
        hwRfidCount = 1;
    } else {
        if (hwRfidCount < 1) hwRfidCount = 1;
        if (hwRfidCount > 2) hwRfidCount = 2;
    }
}

void setupRFID() {
    normalizeRfidHwConfig();
    Serial.printf("[RFID] setup start count=%u side=%s\n",
                  hwRfidCount,
                  hwRfidSide == 1 ? "right" : "left");
    Serial.printf("[RFID] reader test mode=%d (0=both,1=right,2=left)\n", RFID_READER_TEST_MODE);

    pinMode(PN532_1_SS, OUTPUT);
    digitalWrite(PN532_1_SS, HIGH);
    pinMode(PN532_1_RST, OUTPUT);
    digitalWrite(PN532_1_RST, HIGH);

    pinMode(PN532_2_SS, OUTPUT);
    digitalWrite(PN532_2_SS, HIGH);
    pinMode(PN532_2_RST, OUTPUT);
    digitalWrite(PN532_2_RST, HIGH);

#if !RFID_TRANSPORT_HSU && !RFID_TRANSPORT_I2C
    // SPI-only: claims PN532_SPI_SCK/MISO/MOSI via the GPIO matrix. The HSU
    // build reuses those exact same GPIOs (47/48/41) for Serial1/Serial2
    // TX/RX -- running this unconditionally left SPI.begin() holding the
    // pins first, so the later Serial1/Serial2.begin() silently never took
    // over the pin's peripheral binding and nothing was ever transmitted.
    SPI.end();
    delay(20);
    SPI.begin(PN532_SPI_SCK, PN532_SPI_MISO, PN532_SPI_MOSI);
    delay(20);
#endif

    bool ok1 = false;
    bool ok2 = false;

    bool wantRight = false;
    bool wantLeft  = false;

    if (hwRfidCount >= 2) {
        wantRight = true;
        wantLeft  = true;
    } else {
        wantRight = (hwRfidSide == 1);
        wantLeft  = (hwRfidSide == 0);
    }

    if (FORCE_SINGLE_RFID_STABLE_MODE) {
        if (wantRight) {
            digitalWrite(PN532_2_RST, LOW);
            delay(5);
            ok1 = initPN532Reader(rfid1, PN532_1_SS, PN532_1_RST, "PN532-1");
            if (!ok1) {
                Serial.println("[RFID] right reader failed, trying left fallback");
                wantRight = false;
                wantLeft = true;
                digitalWrite(PN532_1_RST, LOW);
                delay(5);
                digitalWrite(PN532_2_RST, HIGH);
                delay(5);
                ok2 = initPN532Reader(rfid2, PN532_2_SS, PN532_2_RST, "PN532-2");
                if (ok2) hwRfidSide = 0;
            }
        } else if (wantLeft) {
            digitalWrite(PN532_1_RST, LOW);
            delay(5);
            ok2 = initPN532Reader(rfid2, PN532_2_SS, PN532_2_RST, "PN532-2");
            if (!ok2) {
                Serial.println("[RFID] left reader failed, trying right fallback");
                wantLeft = false;
                wantRight = true;
                digitalWrite(PN532_2_RST, LOW);
                delay(5);
                digitalWrite(PN532_1_RST, HIGH);
                delay(5);
                ok1 = initPN532Reader(rfid1, PN532_1_SS, PN532_1_RST, "PN532-1");
                if (ok1) hwRfidSide = 1;
            }
        }
    } else {
        if (wantRight) {
            digitalWrite(PN532_2_RST, LOW);
            delay(5);
            ok1 = initPN532Reader(rfid1, PN532_1_SS, PN532_1_RST, "PN532-1");
            digitalWrite(PN532_1_SS, HIGH);
        } else {
            Serial.println("[RFID] skipping PN532-1 by config");
        }

        if (wantLeft) {
            if (wantRight) digitalWrite(PN532_1_RST, LOW);
            delay(5);
            ok2 = initPN532Reader(rfid2, PN532_2_SS, PN532_2_RST, "PN532-2");
            digitalWrite(PN532_2_SS, HIGH);
        } else {
            Serial.println("[RFID] skipping PN532-2 by config");
        }

        if (wantRight) { digitalWrite(PN532_1_RST, HIGH); delay(5); }
        if (wantLeft)  { digitalWrite(PN532_2_RST, HIGH); delay(5); }
    }

    gRfid1Present = ok1; // physically right
    gRfid2Present = ok2; // physically left
    gRfid1TimeoutStreak = 0;
    gRfid2TimeoutStreak = 0;
    gNextRfidPollMs = millis() + 100;
    gRfidPollRightNext = true;

    if (FORCE_SINGLE_RFID_STABLE_MODE) {
        if (!wantRight && !wantLeft) {
            wantRight = true;
            hwRfidSide = 1;
        }
        if (wantRight) {
            gRfidSelectedReader = 1;
            gRfidSelectedSinceMs = millis();
            digitalWrite(PN532_1_RST, HIGH);
            digitalWrite(PN532_2_RST, LOW);
        } else if (wantLeft) {
            gRfidSelectedReader = 2;
            gRfidSelectedSinceMs = millis();
            digitalWrite(PN532_1_RST, LOW);
            digitalWrite(PN532_2_RST, HIGH);
        } else {
            gRfidSelectedReader = 0;
            gRfidSelectedSinceMs = millis();
            digitalWrite(PN532_1_RST, LOW);
            digitalWrite(PN532_2_RST, LOW);
        }
    } else {
        digitalWrite(PN532_1_SS, HIGH);
        digitalWrite(PN532_2_SS, HIGH);
        if (ok1 && ok2) {
            digitalWrite(PN532_1_RST, HIGH);
            digitalWrite(PN532_2_RST, HIGH);
            delay(10);
            rfid1.antennaOn();
            rfid2.antennaOn();
            gRfidSelectedReader = 1;
            gRfidSelectedSinceMs = millis();
            gRfidPollRightNext = false;
        } else if (ok1) {
            digitalWrite(PN532_1_RST, HIGH);
            digitalWrite(PN532_2_RST, LOW);
            delay(10);
            rfid1.antennaOn();
            gRfidSelectedReader = 1;
            gRfidSelectedSinceMs = millis();
            gRfidPollRightNext = false;
        } else if (ok2) {
            digitalWrite(PN532_1_RST, LOW);
            digitalWrite(PN532_2_RST, HIGH);
            delay(10);
            rfid2.antennaOn();
            gRfidSelectedReader = 2;
            gRfidSelectedSinceMs = millis();
            gRfidPollRightNext = true;
        } else {
            gRfidSelectedReader = 0;
            gRfidSelectedSinceMs = millis();
        }
    }

    if (FORCE_SINGLE_RFID_STABLE_MODE) {
        hwRfidCount = 1;
    } else if (ok1 && ok2) {
        hwRfidCount = 2;
    } else if (ok1 || ok2) {
        hwRfidCount = 1;
        hwRfidSide = ok1 ? 1 : 0; // 1=right, 0=left
    } else {
        hwRfidCount = 0;
    }

    prefs.begin("config", false);
    prefs.putUChar("hwRfidCnt", hwRfidCount);
    prefs.putUChar("hwRfidSide", hwRfidSide);
    prefs.end();

    if (!gBootComplete) {
        const char* rfidStatus = (ok1 && ok2) ? "RFID ready" : (ok1 || ok2) ? "RFID partial" : "RFID error";
        bootProgress(20, rfidStatus);
        delay(400);
    } else {
        // No toast once the scale is running. This branch fires on the
        // post-Firebase re-init a few seconds after boot, and it used to throw a
        // full-screen badge over the weigh screen reading "RFID WARN" with a red
        // cross whenever one of the two version queries happened to time out.
        //
        // That query is not a presence test. It hard-resets the module, waits
        // 50 ms and asks for a firmware version over the UART — and a UART has
        // no address ACK, so a module that is merely busy is indistinguishable
        // from one that is absent. The comment in initPN532Reader() records the
        // same flakiness from a previous session: two version queries in a row
        // and the second one times out on hardware that is working perfectly.
        //
        // The honest health signal is gRfid1TimeoutStreak / gRfid2TimeoutStreak:
        // maintained on every real poll, per reader, derived from work the scale
        // does anyway, and it names which one is in trouble. A one-shot probe
        // that interrupts the screen tells the owner less and worries them more.
        //
        // The full status is still shown at boot and in Settings -> RFID, which
        // is where someone goes when they actually want to know.
        Serial.printf("[RFID] re-init: PN532-1 %s, PN532-2 %s\n",
                      ok1 ? "ok" : "no answer", ok2 ? "ok" : "no answer");
    }

}

void setupServo() {
    servoSearching = false;
    servoTestActive = false;
    Serial.println("[SERVO] disabled: no motor on this scale");
}

void startServoSearch() {
    servoSearching = false;
}

void stopServoSearch() {
    servoSearching = false;
}

bool processAutoTare(float weight) {
    if (!autoTarePending) return false;

    // CRITICAL: Always stop servo immediately when entering auto-tare mode
    // This prevents the servo from running if updateServoWorkflow() was skipped
    stopServoSearch();

    sendPhase = "idle"; sendCountdown = -1;
    stableSinceMs = 0; stableCandidate = NAN;

    if (fabs(weight) <= AUTO_TARE_EMPTY_THRESHOLD_G) {
        if (autoTareStableSinceMs == 0) {
            autoTareStableSinceMs = millis();
            Serial.printf("[AUTOTARE] Waiting for stable empty (weight=%.2f)\n", weight);
        } else if (millis() - autoTareStableSinceMs >= AUTO_TARE_STABLE_MS) {
            scale.tare();
            currentWeight = 0.0f;
            resetWeightFilters();
            autoTarePending = false;
            gAutoTareCount++;
            currentOledState = OLED_STATE_AUTOTARE; oledStateChangeMs = millis();
            servoLockedUntilAutotare = false;  // Unlock servo after auto-tare completes
            autoTareStableSinceMs = 0;
            autoTareStartedMs = 0;              // Reset auto-tare start time
            if (servoHoldAfterRemoval) {
                servoHoldAfterRemoval = false;
                rfidLockedForCurrentLoad = false;
                Serial.println("[SERVO] Removal hold released after auto-tare - ready for next measurement");
            }

            // Clear display information (RFID, rack, material, etc.)
            gLastRackId = "";
            gLastRackName = "";
            gLastLevel = -1;
            gLastPosition = -1;
            gLastRackPosition = "";
            gLastManufacturer = "--";
            gLastMaterial = "--";
            gLastColor = "--";
            gLastContainer = 0.0f;

            float offset = scale.get_offset();
            prefs.begin("config", false);
            prefs.putFloat("tareFactor", offset);
            prefs.end();
            Serial.printf("[AUTOTARE] OK Auto tare complete, scale ready for next measurement\n");
            pushSessionEvent("auto_tare", "complete", 0.0f);
            return true;
        }
    } else {
        autoTareStableSinceMs = 0;
    }
    return false;
}

void updateServoWorkflow(float weight) {
    (void)weight;
    servoSearching = false;
}


static String toHex2(uint8_t v) {
    char b[3]; snprintf(b, sizeof(b), "%02X", v); return String(b);
}

static String mapColorName(uint8_t r, uint8_t g, uint8_t b) {
    uint8_t mx = max(r, max(g, b));
    uint8_t mn = min(r, min(g, b));
    uint8_t diff = mx - mn;
    if (mx < 25)  return "Black";
    if (mn > 230) return "White";
    if (diff < 18 && mx > 80 && mx < 230)       return "Gray";
    if (r > 200 && g > 160 && b < 100)           return "Yellow";
    if (r > 200 && b > 170 && g < 130)           return "Pink";
    if (g > 160 && b > 160 && r < 120)           return "Cyan";
    if (r > 140 && g > 80 && g < 170 && b < 90)  return "Orange";
    if (r > 120 && b > 120 && g < 100)           return "Purple";
    if (g > r + 25 && g > b + 25)                return "Green";
    if (b > r + 25 && b > g + 25)                return "Blue";
    if (r > g + 25 && r > b + 25)                return "Red";
    return "Unknown";
}

static uint16_t be16(uint8_t hi, uint8_t lo) {
    return ((uint16_t)hi << 8) | (uint16_t)lo;
}

static String lookupNameInTigerTagDb(const char* url, uint32_t id) {
    if (!WiFi.isConnected()) return "--";
    HTTPClient http;
    http.setTimeout(4500);
    if (!http.begin(url)) return "--";
    int code = http.GET();
    if (code < 200 || code >= 300) { http.end(); return "--"; }
    String body = http.getString();
    http.end();
    if (body.length() == 0) return "--";

    int p = 0;
    while (true) {
        p = body.indexOf("\"id\"", p);
        if (p < 0) break;
        int c = body.indexOf(':', p); if (c < 0) break;
        int s = c + 1;
        while (s < (int)body.length() && (body[s] == ' ' || body[s] == '\t')) s++;
        int e = s;
        while (e < (int)body.length() && body[e] >= '0' && body[e] <= '9') e++;
        if (e <= s) { p = c + 1; continue; }
        uint32_t got = (uint32_t)body.substring(s, e).toInt();
        if (got != id) { p = e; continue; }
        int objEnd = body.indexOf('}', e);
        if (objEnd < 0) objEnd = min((int)body.length(), e + 500);
        String obj = body.substring(p, objEnd);
        int k = obj.indexOf("\"label\""); if (k < 0) k = obj.indexOf("\"name\"");
        if (k < 0) return "--";
        int c2 = obj.indexOf(':', k); if (c2 < 0) return "--";
        int q1 = obj.indexOf('"', c2 + 1);
        int q2 = (q1 >= 0) ? obj.indexOf('"', q1 + 1) : -1;
        if (q1 < 0 || q2 <= q1) return "--";
        String out = obj.substring(q1 + 1, q2); out.trim();
        return out.length() ? out : "--";
    }
    return "--";
}

static String resolveBrandNameOnlineFirst(uint32_t idBrand) {
    String name = lookupNameInTigerTagDb(TIGERTAG_DB_BRAND_URL, idBrand);
    if (name == "--") name = String("ID ") + String(idBrand);
    return name;
}

static String resolveMaterialNameOnlineFirst(uint32_t idMaterial) {
    String name = lookupNameInTigerTagDb(TIGERTAG_DB_MATERIAL_URL, idMaterial);
    if (name == "--") name = String("ID ") + String(idMaterial);
    return name;
}


