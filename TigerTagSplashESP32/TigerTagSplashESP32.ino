                String resp = "{\"active\":false" +
                              String(",\"reader_left\":")  + (gRfid2Present ? "true" : "false") +
                              String(",\"reader_right\":") + (gRfid1Present ? "true" : "false") +
                              ",\"uid_left\":null,\"uid_right\":null}";
