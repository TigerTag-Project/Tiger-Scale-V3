static const uint16_t COL_MUTED     = 0x8894;  // secondary/label text
static const uint16_t COL_FAINT     = 0x52ED;  // faint hint text (UIDs)
static const uint16_t COL_ACCENT    = 0x2BDF;  // blue accent
static const uint16_t COL_ON_ACCENT = 0xFFFF;  // text on an accent fill
static const uint16_t COL_UNIT      = 0xAD97;  // weight unit "g" (softer than the number)

// Settings/gear icon centred at (cx, cy): filled ring r=8, 8 teeth, centre dot r=3.
// bg = button background colour used to punch the inner hole.
static void drawSettingsIcon(int16_t cx, int16_t cy, uint16_t color, uint16_t bg) {
    // Gear body
    gfx->fillCircle(cx, cy, 10, color);
    // 8 teeth at r=12, 45° apart — pre-computed (dx,dy) rounded to integer pixels
    // Angles: 0,45,90,135,180,225,270,315 × r12 → (12,0),(8,8),(0,12),(-8,8),(-12,0),(-8,-8),(0,-12),(8,-8)
    const int8_t tdx[8] = { 12,  8,  0, -8, -12, -8,  0,  8};
    const int8_t tdy[8] = {  0,  8, 12,  8,   0, -8,-12, -8};
    for (int i = 0; i < 8; i++)
        gfx->fillRect(cx + tdx[i] - 2, cy + tdy[i] - 2, 4, 4, color);
    // Inner hole (punch background colour)
    gfx->fillCircle(cx, cy, 6, bg);
    // Centre circle
    gfx->fillCircle(cx, cy, 3, color);
}

// Battery icon: minimal outline body 48×26, terminal 5×14 on right, single
// proportional fill bar (no segmented rainbow bars — matches the flat light theme).
// pct: 0-100 = battery %, 254 = unknown, 255 = no battery. charging = current is
// actually flowing into the cell (STATUS2), not merely "a cable is plugged in".
// Fill colour follows the phone convention the LVGL icon uses: green while
// charging, blue on battery, red at or below 20%. The fill is ALWAYS the real
// percentage — it used to be forced to 100% while charging, which hid the very
// number the icon exists to show.
static void drawBatteryIcon(int16_t bx, int16_t by, uint8_t pct, bool charging) {
    const int16_t BW=48, BH=26, TW=5, TH=14;
    // Body: thin outline only (hollow), no card fill
    gfx->drawRoundRect(bx, by, BW, BH, 4, COL_TEXT);
    // Terminal nub (right side, vertically centred)
    gfx->fillRoundRect(bx+BW, by+(BH-TH)/2, TW, TH, 2, COL_TEXT);

    const int16_t PAD = 3;
    const int16_t innerX = bx+PAD, innerY = by+PAD, innerW = BW-2*PAD, innerH = BH-2*PAD;

    if (pct == 254) {
        // Unknown — just a "?" in the outline, no fill
        gfx->setTextColor(COL_MUTED); gfx->setTextSize(1);
        gfx->setCursor(bx + (BW-6)/2, by + (BH-8)/2);
        gfx->print("?");
        return;
    }

    uint8_t level = (pct == 255) ? 100 : pct;
    uint16_t fillCol = charging          ? (uint16_t)0x3D2B   // green, charging (RGB565 of LVCOL_GREEN #3BA55D)
                     : (level <= 20)     ? (uint16_t)0xF800   // red, low
                                         : COL_ACCENT;
    int16_t fillW = (int16_t)((int32_t)innerW * level / 100);
    if (fillW < 3) fillW = 3; // always show a sliver so the icon reads as "a battery"
    gfx->fillRoundRect(innerX, innerY, fillW, innerH, 2, fillCol);

    // Lightning bolt overlay while current is flowing in. It disappears once the
    // charger reports "done", the same way a phone drops it at 100% on the cable.
    if (charging) {
        int16_t bcx = bx + BW/2, bcy = by + BH/2;
        gfx->fillTriangle(bcx+4, bcy-8, bcx-4, bcy+1, bcx+1, bcy+1, COL_ON_ACCENT);
        gfx->fillTriangle(bcx+4, bcy-1, bcx-1, bcy-1, bcx-4, bcy+8, COL_ON_ACCENT);
    }
}

// WiFi icon: 14 wide × 10 tall, drawn at (ix, iy).
// Large arc (row 0-1), medium arc (row 3-4), small arc (row 6), dot (rows 8-9).
static void drawWifiIcon(int16_t ix, int16_t iy, uint16_t color) {
    gfx->drawFastHLine(ix+1,  iy+0, 12, color);  // large arc top
    gfx->drawPixel(ix+0,  iy+1, color);           // large arc sides
    gfx->drawPixel(ix+1,  iy+1, color);
    gfx->drawPixel(ix+12, iy+1, color);
    gfx->drawPixel(ix+13, iy+1, color);
    gfx->drawFastHLine(ix+3,  iy+3, 8, color);   // medium arc top
    gfx->drawPixel(ix+2,  iy+4, color);           // medium arc sides
    gfx->drawPixel(ix+3,  iy+4, color);
    gfx->drawPixel(ix+10, iy+4, color);
    gfx->drawPixel(ix+11, iy+4, color);
    gfx->drawFastHLine(ix+5,  iy+6, 4, color);   // small arc
    gfx->fillRect(ix+6,   iy+8, 2, 2, color);    // dot
}

// Volume icon 44×28px — type: 0=mute(X) 1=unmute(waves) 2=vol_up(+) 3=vol_down(-)
// Speaker body: left 16px, symbol: right 28px from sx=ix+16
static void drawVolumeIcon(int16_t ix, int16_t iy, uint8_t type, uint16_t color) {
    // Speaker body
    gfx->fillRect(ix, iy+9, 4, 10, color);                              // box
    gfx->fillTriangle(ix+4, iy+9, ix+14, iy+3, ix+14, iy+25, color);  // upper cone
    gfx->fillTriangle(ix+4, iy+9, ix+4,  iy+19, ix+14, iy+25, color); // lower cone
    int16_t sx = ix+18, cy = iy+14;
    switch (type) {
        case 0: // Mute — X (3px thick diagonals)
            for (int t=0; t<3; t++) {
                gfx->drawLine(sx+t,    cy-9, sx+24+t, cy+9, color);
                gfx->drawLine(sx+24-t, cy-9, sx-t,    cy+9, color);
            }
            break;
        case 1: // Unmute — 3 waves (chevron approximation)
            for (int t=0; t<2; t++) {
                gfx->drawLine(sx+t,    cy-4,  sx+5+t, cy,   color);
                gfx->drawLine(sx+5+t,  cy,    sx+t,   cy+4, color);
                gfx->drawLine(sx+8+t,  cy-7,  sx+14+t,cy,   color);
                gfx->drawLine(sx+14+t, cy,    sx+8+t, cy+7, color);
                gfx->drawLine(sx+17+t, cy-11, sx+24+t,cy,   color);
                gfx->drawLine(sx+24+t, cy,    sx+17+t,cy+11,color);
            }
            break;
        case 2: // Vol Up — + symbol
            gfx->fillRect(sx+11, cy-10, 4, 20, color); // vertical
            gfx->fillRect(sx,    cy-2,  26, 4,  color); // horizontal
            break;
        case 3: // Vol Down — - symbol
            gfx->fillRect(sx, cy-2, 26, 4, color);
            break;
    }
}

// Scale/tare icon — minimal flat plate + two feet, "0.0" readout below (no skeuomorphic body/window).
static void drawScaleIcon(int16_t ix, int16_t iy, uint16_t color) {
    const int16_t PW = 64, PH = 16;
    gfx->drawRoundRect(ix, iy, PW, PH, 5, color);            // plate outline
    gfx->fillRoundRect(ix+13, iy+PH,   5, 6, 2, color);       // left foot
    gfx->fillRoundRect(ix+PW-18, iy+PH, 5, 6, 2, color);      // right foot
    gfx->setTextColor(COL_MUTED); gfx->setTextSize(1);
    gfx->setCursor(ix + (PW-18)/2, iy + PH + 9);
    gfx->print("0.0");
}

// Home icon ~22×18px — filled roof triangle + body rectangle (icon_home.svg)
static void drawHomeIcon(int16_t ix, int16_t iy, uint16_t color) {
    gfx->fillTriangle(ix+11, iy,  ix, iy+12,  ix+22, iy+12, color);  // roof
    gfx->fillRect(ix+3, iy+11, 16, 7, color);                         // body
}

// WiFi XL ~60×40px — 3 arcs 3px thick + 8×6 dot (for Settings buttons)
static void drawWifiIconXL(int16_t ix, int16_t iy, uint16_t color) {
    // Large arc
    for (int t=0;t<3;t++) gfx->drawFastHLine(ix+2, iy+t, 56, color);
    gfx->fillRect(ix,    iy+3, 3, 3, color); gfx->fillRect(ix+57, iy+3, 3, 3, color);
    // Medium arc
    for (int t=0;t<3;t++) gfx->drawFastHLine(ix+12, iy+13+t, 36, color);
    gfx->fillRect(ix+8,  iy+16, 3, 3, color); gfx->fillRect(ix+49, iy+16, 3, 3, color);
    // Small arc
    for (int t=0;t<3;t++) gfx->drawFastHLine(ix+22, iy+26+t, 16, color);
    gfx->fillRect(ix+18, iy+29, 3, 3, color); gfx->fillRect(ix+39, iy+29, 3, 3, color);
    // Dot
    gfx->fillRect(ix+26, iy+34, 8, 6, color);
}

// Cloud XL ~60×36px (for Settings buttons)
static void drawCloudIconXL(int16_t ix, int16_t iy, uint16_t color) {
    gfx->fillCircle(ix+20, iy+20, 18, color);  // main dome
    gfx->fillCircle(ix+42, iy+24, 13, color);  // right bump
    gfx->fillRect(ix+2,   iy+20, 56, 16, color); // flat base
}

// Cloud icon ~22×14px — large left dome + small right dome + flat base (icon_cloud.svg)
static void drawCloudIcon(int16_t ix, int16_t iy, uint16_t color) {
    gfx->fillCircle(ix+8,  iy+8,  7, color);  // main left dome
    gfx->fillCircle(ix+16, iy+10, 5, color);  // right bump
    gfx->fillRect(ix+1,   iy+8, 20, 6, color); // flat base body
}

// Larger WiFi icon: 22×17px, ix/iy = top-left corner
// Large arc (rows 0-1, width 20), medium (rows 4-5, width 12), small (rows 8-9, width 6), dot 3×3
static void drawWifiIconLarge(int16_t ix, int16_t iy, uint16_t color) {
    // Large arc — 2px thick top, 2px side pixels
    gfx->drawFastHLine(ix+1,  iy+0,  20, color);
    gfx->drawFastHLine(ix+1,  iy+1,  20, color);
    gfx->drawPixel(ix+0,  iy+2, color); gfx->drawPixel(ix+0,  iy+3, color);
    gfx->drawPixel(ix+21, iy+2, color); gfx->drawPixel(ix+21, iy+3, color);
    // Medium arc
    gfx->drawFastHLine(ix+4,  iy+5,  14, color);
    gfx->drawFastHLine(ix+4,  iy+6,  14, color);
    gfx->drawPixel(ix+2,  iy+7, color); gfx->drawPixel(ix+3,  iy+7, color);
    gfx->drawPixel(ix+19, iy+7, color); gfx->drawPixel(ix+18, iy+7, color);
    // Small arc
    gfx->drawFastHLine(ix+7,  iy+9,  8,  color);
    gfx->drawFastHLine(ix+7,  iy+10, 8,  color);
    gfx->drawPixel(ix+5,  iy+11, color); gfx->drawPixel(ix+6,  iy+11, color);
    gfx->drawPixel(ix+16, iy+11, color); gfx->drawPixel(ix+15, iy+11, color);
    // Dot 3×3
    gfx->fillRect(ix+9, iy+14, 4, 3, color);
}

void displayWeightWithState(float weight, const String& uid, OledState state) {
    if (!gDisplayReady || gfx == nullptr) return;

    // LVGL main screen (2026-07-28 migration) -- same entry point, same call
    // sites throughout the file, internals swapped. The raw gfx drawing below
    // is kept intact and unused as an easy fallback (flip gUseLvglMainScreen
    // to false to revert without touching any call site).
    if (gUseLvglMainScreen) {
        lvglUpdateMainScreen(weight, uid, state);
        return;
    }

    const int W = 480, H = 320;

    // --- Solid background: light theme (cream) ---
    gfx->fillScreen(COL_BG);

    // --- Tag active flag ---
    // Keep panel visible in WF_DONE (post-send, spool still on scale) even after UIDs are cleared
    bool tagActive = (lastUIDLeft.length() > 0 || lastUIDRight.length() > 0)
                  || (wfPhase == WF_DONE && gLastManufacturer.length() > 0 && gLastManufacturer != "--");

    // --- Top-left: "Remove material" label when tag active, else status badge ---
    if (tagActive) {
        const char* btnLbl = t(I18N_REMOVE_MATERIAL);
        gfx->setTextColor(COL_TEXT); gfx->setTextSize(1);
        gfx->setCursor(10, 16);
        gfx->print(btnLbl);
    } else {
        const char* statusLbl;
        uint16_t statusBg, statusFg;
        switch (state) {
            case OLED_STATE_IDLE:
                statusLbl = t(I18N_READY);
                statusBg  = 0x07E0; statusFg = 0x0000; break;
            case OLED_STATE_WEIGHING:
            case OLED_STATE_UID_DETECTED:
                statusLbl = t(I18N_WEIGHING);
                statusBg  = 0xFD20; statusFg = 0x0000; break;
            case OLED_STATE_SENDING:
                statusLbl = t(I18N_SENDING);
                statusBg  = 0x031F; statusFg = 0xFFFF; break;
            case OLED_STATE_SUCCESS:
                statusLbl = t(I18N_SYNCED);
                statusBg  = 0x07E0; statusFg = 0x0000; break;
            case OLED_STATE_ERROR:
                statusLbl = t(I18N_ERROR);
                statusBg  = 0xF800; statusFg = 0xFFFF; break;
            case OLED_STATE_NO_TAG:
            case OLED_STATE_CANCELLED:
                statusLbl = t(state == OLED_STATE_NO_TAG ? I18N_NO_TAG_DETECTED
                                                         : I18N_WEIGH_CANCELLED);
                statusBg  = 0xFD20; statusFg = 0x0000; break;
            case OLED_STATE_AUTOTARE:
                statusLbl = t(I18N_AUTO_TARE);
                statusBg  = 0x031F; statusFg = 0xFFFF; break;
            default:
                statusLbl = t(I18N_READY);
                statusBg  = 0x07E0; statusFg = 0x0000;
        }
        int16_t badgeW = (int16_t)(strlen(statusLbl) * 6 + 14);
        gfx->fillRoundRect(8, 8, badgeW, 22, 8, statusBg);
        gfx->setTextColor(statusFg); gfx->setTextSize(1);
        gfx->setCursor(8 + 7, 8 + 8);
        gfx->print(statusLbl);
    }

    // --- User/scale name + initials badge centered at top ---
    String scaleName = (firebaseAuth && firebaseDisplayName.length()) ? firebaseDisplayName : "Tiger Scale";
    int16_t nameW = (int16_t)(scaleName.length() * 12);
    if (firebaseAuth) {
        const int16_t AV = 32, GAP = 6;
        int16_t gx = (W - (AV + GAP + nameW)) / 2;
        {
            // Initials circle
            String src = firebaseDisplayName.length() ? firebaseDisplayName : firebaseEmail;
            char ini = src.length() ? (char)toupper((unsigned char)src.charAt(0)) : '?';
            // Pick a colour from the initial (deterministic)
            const uint16_t PALLETE[] = {
                0x041F, 0x03E0, 0xF800, 0xF81F, 0x07FF, 0xFFE0, 0x8010, 0x0410
            };
            uint16_t circCol = PALLETE[(ini - 'A' + 26) % 8];
            gfx->fillCircle(gx + AV/2, 6 + AV/2, AV/2, circCol);
            gfx->setTextColor(0xFFFF); gfx->setTextSize(2);
            gfx->setCursor(gx + AV/2 - 6, 6 + AV/2 - 8);
            gfx->print(ini);
        }
        gfx->setTextColor(COL_TEXT); gfx->setTextSize(2);
        gfx->setCursor(gx + AV + GAP, 12);
        gfx->print(scaleName);
    } else {
        gfx->setTextColor(COL_TEXT); gfx->setTextSize(2);
        gfx->setCursor((W - nameW) / 2, 12);
        gfx->print(scaleName);
    }

    // --- Brand/material (top-right, compact, only when tag active) ---
    if (tagActive) {
        const int16_t textRightX = 444;   // right edge for right-aligned brand/material text
        const int16_t circleCx = 462, circleCy = 21, circleR = 14;
        // colour circle — use filament colour from Firestore (#RRGGBB in gLastColor)
        uint16_t circleColor = COL_ACCENT;
        {
            int hi = gLastColor.indexOf('#');
            if (hi >= 0 && (int)gLastColor.length() >= hi + 7) {
                uint8_t cr = (uint8_t)strtol(gLastColor.substring(hi+1, hi+3).c_str(), nullptr, 16);
                uint8_t cg = (uint8_t)strtol(gLastColor.substring(hi+3, hi+5).c_str(), nullptr, 16);
                uint8_t cb = (uint8_t)strtol(gLastColor.substring(hi+5, hi+7).c_str(), nullptr, 16);
                circleColor = ((uint16_t)(cr >> 3) << 11) | ((uint16_t)(cg >> 2) << 5) | (cb >> 3);
            }
        }
        gfx->fillCircle(circleCx, circleCy, circleR, circleColor);
        // BRAND value (no label, bold via size1 dark text)
        String brandStr = gLastManufacturer.length() > 10 ? gLastManufacturer.substring(0, 10) : gLastManufacturer;
        gfx->setTextColor(COL_TEXT); gfx->setTextSize(1);
        gfx->setCursor(textRightX - (int16_t)(brandStr.length() * 6), 8);
        gfx->print(brandStr);
        // MATERIAL value (muted, smaller emphasis)
        String matStr = gLastMaterial.length() > 10 ? gLastMaterial.substring(0, 10) : gLastMaterial;
        gfx->setTextColor(COL_MUTED);
        gfx->setCursor(textRightX - (int16_t)(matStr.length() * 6), 20);
        gfx->print(matStr);
    }

    // --- Large weight display: total weight (gross, container included) ---
    int totalInt = roundWeight(weight);
    String totalStr = String(totalInt);
    int16_t numW   = (int16_t)(totalStr.length() * 30); // textSize=5: 30px/char
    int16_t unitW  = 3 * 18;                             // " g" textSize=3: 18px/char
    int16_t startX = (W - numW - unitW) / 2;
    if (startX < 4) startX = 4;
    gfx->setTextColor(COL_TEXT); gfx->setTextSize(5);
    gfx->setCursor(startX, 52);
    gfx->print(totalStr);
    gfx->setTextColor(COL_UNIT); gfx->setTextSize(3);
    gfx->print(" g");
    // Accent underline centred below the weight
    gfx->fillRoundRect(W/2 - 30, 96, 60, 3, 1, COL_ACCENT);

    // --- CONTAINER | FILAMENT ---
    // FILAMENT = net weight (total - container)
    float netWeight = (gLastContainer > 0 && weight > gLastContainer)
                      ? weight - gLastContainer : 0.0f;
    int16_t midX = W / 2;
    // Labels
    gfx->setTextColor(COL_MUTED); gfx->setTextSize(1);
    gfx->setCursor(midX - 110, 110);
    gfx->print(t(I18N_CONTAINER));
    gfx->setCursor(midX + 18, 110);
    gfx->print(t(I18N_FILAMENT));
    // Divider
    gfx->drawFastVLine(midX, 106, 38, COL_BORDER);
    // Values
    gfx->setTextColor(COL_ACCENT); gfx->setTextSize(2);
    String contStr = gLastContainer > 0 ? (String((int)gLastContainer) + " g") : "-- g";
    String filmStr = netWeight > 0      ? (String((int)roundWeight(netWeight)) + " g") : "-- g";
    gfx->setCursor(midX - 106, 124);
    gfx->print(contStr);
    gfx->setCursor(midX + 20, 124);
    gfx->print(filmStr);

    // --- Thin divider ---
    gfx->drawFastHLine(0, 152, W, COL_BORDER);

    // --- Reader buttons ---
    const int RBY = 160, RBH = 28, RBW = 110;
    // Left reader (rfid2)
    bool leftActive  = lastUIDLeft.length()  > 0;
    bool rightActive = lastUIDRight.length() > 0;
    gfx->fillRoundRect(8, RBY, RBW, RBH, 6, COL_CARD);
    gfx->drawRoundRect(8, RBY, RBW, RBH, 6, leftActive ? COL_ACCENT : COL_BORDER);
    gfx->setTextColor(COL_TEXT); gfx->setTextSize(1);
    { const char* lbl = t(I18N_READER_LEFT);
      gfx->setCursor(8 + (RBW - (int16_t)(strlen(lbl)*6))/2, RBY + (RBH-8)/2);
      gfx->print(lbl); }
    // Right reader (rfid1)
    gfx->fillRoundRect(W - RBW - 8, RBY, RBW, RBH, 6, COL_CARD);
    gfx->drawRoundRect(W - RBW - 8, RBY, RBW, RBH, 6, rightActive ? COL_ACCENT : COL_BORDER);
    { const char* lbl = t(I18N_READER_RIGHT);
      gfx->setCursor((W-RBW-8) + (RBW - (int16_t)(strlen(lbl)*6))/2, RBY + (RBH-8)/2);
      gfx->print(lbl); }
    // --- Rack: name centred in button row, position badge below UIDs ---
    const int16_t cx = W / 2;
    if (gLastRackName.length() > 0) {
        // Safe zone between the two Reader buttons
        const int16_t nameAreaX = 8 + RBW + 4;                 // 122
        const int16_t nameAreaW = W - 2 * (RBW + 8) - 8;       // 236
        const int16_t maxChars  = nameAreaW / 12;               // 19 chars at textSize=2

        gfx->setTextColor(COL_ACCENT); gfx->setTextSize(2);

        if ((int16_t)gLastRackName.length() <= maxChars) {
            // fits — centre as before
            gfx->setCursor(cx - (int16_t)(gLastRackName.length() * 12 / 2), RBY + 6);
            gfx->print(gLastRackName);
        } else {
            // scroll: one char per 250 ms, 1 s pause at start when name changes
            static String   _scrollName;
            static uint32_t _scrollBase = 0;
            if (_scrollName != gLastRackName) {
                _scrollName  = gLastRackName;
                _scrollBase  = millis() + 1000;
            }
            int32_t elapsed = (int32_t)(millis() - _scrollBase);
            if (elapsed < 0) elapsed = 0;
            String padded = gLastRackName + "   "; // gap before repeat
            int32_t offset = (elapsed / 250) % (int32_t)padded.length();
            String display = "";
            for (int16_t i = 0; i < maxChars; i++)
                display += padded[(offset + i) % (int32_t)padded.length()];
            gfx->setCursor(nameAreaX, RBY + 6);
            gfx->print(display);
        }
    }

    // UIDs below reader buttons
    gfx->setTextColor(COL_FAINT); gfx->setTextSize(1);
    String lUID = lastUIDLeft.length()  ? lastUIDLeft.substring(0, 14)  : "--";
    String rUID = lastUIDRight.length() ? lastUIDRight.substring(0, 14) : "--";
    gfx->setCursor(8,         RBY + RBH + 4);
    gfx->print(lUID);
    gfx->setCursor(W - RBW - 8, RBY + RBH + 4);
    gfx->print(rUID);

    // Position badge centred below the UID row
    if (gLastRackPosition.length() > 0) {
        const int16_t PBY = RBY + RBH + 14;   // y=202 — safely below UIDs
        int16_t pw = (int16_t)(gLastRackPosition.length() * 12 + 16);
        gfx->fillRoundRect(cx - pw/2, PBY,     pw, 22, 5, COL_ACCENT);
        gfx->setTextColor(COL_ON_ACCENT); gfx->setTextSize(2);
        gfx->setCursor(cx - (int16_t)(gLastRackPosition.length() * 12 / 2), PBY + 3);
        gfx->print(gLastRackPosition);
    }

    // --- Thin divider above control buttons ---
    const int16_t BTN_Y = 252;   // bottom bar top (moved up for bigger buttons)
    const int16_t BTN_H = 64;    // bottom bar height
    gfx->drawFastHLine(0, BTN_Y - 4, W, COL_BORDER);

    // --- Control buttons: BAT | TARA | SETTINGS ---
    // Battery icon (far left, vertically centred in bar)
    {
        // Same shared state as the LVGL path. This fallback used to keep its own
        // 30 s poll, which meant the two drawings of the same icon could
        // disagree -- a divergence in standby code is found at the worst moment.
        uint8_t    batPct = gBattery.known ? (gBattery.present ? gBattery.percent : 255) : 254;
        const bool batChg = gBattery.charging;
        // AXP unreadable and a USB CDC host attached: there is no cell to show.
        if (batPct == 254 && (bool)Serial) { batPct = 255; }
        const int16_t ICON_H=26;
        const int16_t bx = 8, by = BTN_Y + (BTN_H - ICON_H) / 2;
        drawBatteryIcon(bx, by, batPct, batChg);
    }
    // WiFi icon — standalone, no pill, next to battery
    {
        uint16_t wfCol = wifiConnected ? (uint16_t)0x07E0 : (uint16_t)0xF800;
        drawWifiIconLarge(65, BTN_Y + (BTN_H - 17) / 2, wfCol);
    }
    // Firebase cloud icon — no pill, next to WiFi (WiFi ends at x=87)
    {
        uint16_t fbCol = firebaseAuth ? (uint16_t)0x07E0 : (uint16_t)0xF800;
        drawCloudIcon(93, BTN_Y + (BTN_H - 14) / 2, fbCol);
    }
    // Volume indicator — small speaker + 3 level bars
    {
        int16_t vx = 122, vy = BTN_Y + (BTN_H - 12) / 2;
        uint16_t vCol = gMute ? (uint16_t)0xF800 : COL_TEXT;
        // Speaker body: box + cone
        gfx->fillRect(vx, vy+2, 4, 8, vCol);
        gfx->fillTriangle(vx+4, vy+2, vx+9, vy, vx+9, vy+12, vCol);
        if (gMute) {
            // X for muted
            gfx->drawLine(vx+12, vy+2, vx+19, vy+10, vCol);
            gfx->drawLine(vx+19, vy+2, vx+12, vy+10, vCol);
        } else {
            // 3 bars of increasing height; filled up to current level
            int bars = gVolume < 1 ? 0 : (gVolume < 34 ? 1 : (gVolume < 67 ? 2 : 3));
            const uint16_t DIM = COL_BORDER;
            gfx->fillRect(vx+12, vy+8,  3, 4,  bars >= 1 ? vCol : DIM);
            gfx->fillRect(vx+16, vy+5,  3, 7,  bars >= 2 ? vCol : DIM);
            gfx->fillRect(vx+20, vy+2,  3, 10, bars >= 3 ? vCol : DIM);
        }
    }
    // TARA — scale icon, no pill (icon_scale.svg), centred in 130×64 touch area
    drawScaleIcon(220 + (130-64)/2, BTN_Y + (BTN_H-31)/2, COL_TEXT);
    // Settings button — gear icon only, no pill background
    drawSettingsIcon(358 + 114/2, BTN_Y + BTN_H/2, COL_TEXT, COL_BG);

    gfx->flush();
}

