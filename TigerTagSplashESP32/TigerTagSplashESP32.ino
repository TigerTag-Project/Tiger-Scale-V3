  function startPoll(){if(!pt){console.log('[POLL] HTTP fallback');poll();pt=setInterval(poll,1000);}}
  function stopPoll(){if(pt){clearInterval(pt);pt=null;}}
  var origWs=window.wsConnect;
  window.wsConnect=function(){
