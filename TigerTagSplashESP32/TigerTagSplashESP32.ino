// Thin wrapper around Adafruit_PN532 exposing the same call pattern the rest
// of the firmware used against MFRC522 (isNewCardPresent/readCardSerial/uid/
// antennaOn-Off/halt) so the poll loop and metadata code stay unchanged.
// PN532's readPassiveTargetID() already does REQA+anticollision+select in one
// shot, so isNewCardPresent() runs it and caches the UID; readCardSerial()
// just hands back the cached result.
//
// Three transports share this exact public API (selected by
// RFID_TRANSPORT_HSU / RFID_TRANSPORT_I2C, set in platformio.ini): the
// default is SPI over the header pins, 2 readers; esp32s3_hsu wires the
// module's HSU pins straight to two ESP32 HardwareSerial ports, 2 readers;
// esp32s3_i2c wires ONE module onto Wire1 (the PN532's I2C address is fixed,
// so 2 would collide). A fourth, USB-host transport was attempted and is a
// confirmed hardware dead end -- docs/USB_HOST_POSTMORTEM.md.
// setupRFID()/rfidSelectReader()/pollRFIDReader()/etc. below only ever call
// this class's public methods, so none of that code needed to change across
// any of these transports.

// RF power/sensitivity presets, selectable live from the Hardware/RFID Test
// screen (the level stepper) while tuning the two-readers-facing-each-other-
// at-75mm cross-talk issue -- no recompile/reflash needed to try a different
// level. GsNOn/CWGsP/ModGsP are TX driver conductance (N- and P-channel,
// continuous-wave/idle and modulation states) -- mapping cross-checked
// against this project's own pre-PN532 MFRC522 code, which used the same
// CIU transceiver core/register map (GsNReg/CWGsPReg = 0xFF/0x3F there for
// MAXIMUM gain, so smaller values here are those same fields at lower drive).
//
// 2026-07-16 (2nd pass): the original 0-4 range spanned all the way to full
// datasheet TX drive, but that upper half was never useful for this
// setup -- narrowed to 5 finer steps between just the original level 0
// (floor: TX ~off, least sensitive) and level 1 (TX still very low, one
// step more sensitive), linearly interpolated. The old levels 2-4 (up to
// full datasheet TX drive) are gone; if more range is ever needed above the
// current index 4, re-derive from the deleted values in WORKLOG.md history.
struct PN532RfLevel { uint8_t gsNOn, cwGsP, modGsP, rxThresholdMinLevel; };
static const PN532RfLevel PN532_RF_LEVELS[] = {
    { 0x00, 0x00, 0x00, 0xF }, // 0: floor -- TX ~off, least sensitive
    { 0x10, 0x04, 0x01, 0xE },
    { 0x20, 0x08, 0x02, 0xD },
    { 0x30, 0x0C, 0x03, 0xC },
    { 0x40, 0x10, 0x04, 0xB }, // 4: former level 1 endpoint
};
static const uint8_t PN532_RF_LEVEL_COUNT = sizeof(PN532_RF_LEVELS) / sizeof(PN532_RF_LEVELS[0]);

uint8_t gRfidPowerLevel = 3; // index into PN532_RF_LEVELS, adjustable live from the Hardware/RFID Test screen

// Sent through Adafruit_PN532's public sendCommandCheckAck(), no library
// patch needed. Baseline payload byte-for-byte confirmed against dotnet/
// iot's Pn532 bindings (Microsoft-maintained, matches the PN532 datasheet
// reset values); RFCfg (RxGain, bits 6:4) is left at that datasheet default
// (0x59) at every level -- another lever to pull later if levels 0-4 aren't
// enough on their own.
static void applyPN532RfTuning(Adafruit_PN532 &pn532, uint8_t level) {
    if (level >= PN532_RF_LEVEL_COUNT) level = PN532_RF_LEVEL_COUNT - 1;
    const PN532RfLevel &lv = PN532_RF_LEVELS[level];
    uint8_t cmd[13] = {
        PN532_COMMAND_RFCONFIGURATION,
        0x0A, // CfgItem: analog settings, 106 kbps type A (reader mode)
        0x59, // RFCfg (RxGain) -- untouched, datasheet default
        lv.gsNOn,
        lv.cwGsP,
        lv.modGsP,
        0x4D, // DemodWhenRfOn
        (uint8_t)((lv.rxThresholdMinLevel << 4) | 0x5), // RxThreshold: MinLevel | CollLevel=0x5
        0x61, // DemodWhenRfOff
        0x6F, // GsNOff
        0x26, // ModWidth
        0x62, // MifNFC
        0x87, // TxBitPhase
    };
    // Settle, then a generous timeout, then one retry.
    //
    // This is called straight after the firmware-version query inside init(),
    // and on this hardware a command issued immediately behind another is not
    // acknowledged — the same flakiness initPN532Reader() documents for two
    // back-to-back version queries. The consequence was invisible and real: the
    // serial log showed "no ACK (kept previous config)" on every single call,
    // so the RF power level chosen in Settings -> Hardware was never actually
    // applied to either reader. The setting moved, the radio did not.
    delay(20);
    if (!pn532.sendCommandCheckAck(cmd, sizeof(cmd), 500)) {
        delay(40);
        if (!pn532.sendCommandCheckAck(cmd, sizeof(cmd), 500)) {
            netLog("RFTUNE L" + String(level) + " no ACK (kept previous config)");
            return;
        }
    }
    netLog("RFTUNE L" + String(level) + " applied");
}

