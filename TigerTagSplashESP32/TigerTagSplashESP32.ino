    lv_obj_set_user_data(backBtn, (void *)(intptr_t)FA_BACK);
    lv_obj_add_event_cb(backBtn, actionCb, LV_EVENT_CLICKED, nullptr);
    lv_obj_t *backIcon = lv_label_create(backBtn);
    lv_label_set_text(backIcon, LV_SYMBOL_LEFT);
    lv_obj_set_style_text_color(backIcon, LVCOL_MUTED, 0);
    lv_obj_center(backIcon);

    lv_scr_load(scr);

    while (sFbAction == FA_NONE) { lv_timer_handler(); delay(5); }

    if (sFbAction == FA_LOGOUT) {
        // Clear all firebase credentials
        firebaseEmail       = "";
        firebasePassword    = "";
        firebaseDisplayName = "";
        firebaseIdToken     = "";
        firebaseAuth        = false;
        prefs.begin("config", false);
        prefs.remove("fbEmail");
        prefs.remove("fbPass");
        prefs.remove("fbDisplayName");
        prefs.end();
        // Free avatar buffer HERE on Core 1 (same core as display loop) so Core 1
        // never sees a stale non-null pointer belonging to the previous user.
        // Keep avatarUrl/avatarUid in prefs so the retry mechanism can re-download
        // on next login. initScaleFirestoreSync() will detect UID mismatch and
        // clear/re-fetch when a different user logs in.
        gUserAvatarReady    = false;
        gAvatarRetryPending = false;
        if (gUserAvatarBuf) { free(gUserAvatarBuf); gUserAvatarBuf = nullptr; }
        // Clear in-memory URL/UID so the retry path in this session doesn't use
        // the old URL before initScaleFirestoreSync() has a chance to verify UID.
        gUserAvatarUrl = "";
        gUserAvatarUid = "";
        // Clear Firebase identity so cloud worker re-inits after next login
        firebaseUid      = "";
        gScaleMacAddress = "";
        gScaleDocPath    = "";

        lv_obj_t *col2;
        lv_obj_t *confirmScr = lvglCenteredScreen(&col2);
        lvglAddCenteredLabel(col2, t(I18N_LOGOUT), LVCOL_RED, &lv_font_montserrat_20);
        lv_scr_load(confirmScr);
        lv_obj_del(scr);
        uint32_t t1 = millis(); while (millis() - t1 < 1200) { lv_timer_handler(); delay(30); }
        lv_scr_load(lvScreen);
        lv_obj_del(confirmScr);
    } else {
        lv_scr_load(lvScreen);
        lv_obj_del(scr);
    }

    { int16_t dx, dy; uint32_t t0 = millis(); while (tsRead(dx, dy) && millis()-t0 < 800) delay(20); }
}

static void drawChipIcon(int16_t cx, int16_t cy, uint16_t color) {
    // IC chip body (24×18)
    gfx->fillRect(cx-12, cy-9, 24, 18, color);
    gfx->fillRect(cx-9,  cy-7, 18, 14, DARK_BG); // cutout
    gfx->fillCircle(cx, cy, 4, color);            // center dot
    // Pins left (3) and right (3)
    for (int8_t i = -1; i <= 1; i++) {
        gfx->fillRect(cx-19, cy+i*5-1, 7, 3, color);
        gfx->fillRect(cx+12, cy+i*5-1, 7, 3, color);
    }
}

